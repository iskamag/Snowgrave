(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-source-owner-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(let* ((name (intern "SOURCE-FN" :cl-user))
       (source (snowgrave:make-authored-source `((defun ,name (x &optional (o 3 op)) (+ x o))) :identity '(portable-owner)))
       (definition (snowgrave:find-authored-definition source :function name))
       (contract (snowgrave:source-lambda-contract (third (snowgrave:authored-definition-form definition)))))
  (assert (equal (snowgrave:source-name-key name) '("COMMON-LISP-USER" "SOURCE-FN")))
  (assert (equal (getf contract :variables) '(x o op)))
  (assert (= (snowgrave:authored-definition-position definition) 1))
  (assert (not (fboundp name)))
  (assert (equal (snowgrave:source-block-body name '((values 1 2))) `((block ,name (values 1 2)))))
  (multiple-value-bind (scope processed)
      (snowgrave:analyze-source-bindings
       '((x 1) (y x)) nil '((x . 10))
       (lambda (name initializer scope)
         (declare (ignore name))
         (values (if (symbolp initializer) (cdr (assoc initializer scope)) initializer) initializer))
       (lambda (name fact scope) (acons name fact scope)))
    (assert (= (cdr (assoc 'y scope)) 10))
    (assert (equal processed '((x 1) (y x)))))
  (multiple-value-bind (scope processed)
      (snowgrave:analyze-source-lambda-bindings
       '(x &optional (y r) &rest r &aux (z y)) '((r . :outer))
       (lambda (name initializer scope)
         (declare (ignore name))
         (values (cdr (assoc initializer scope)) initializer))
       (lambda (name kind fact scope) (acons name (if (eq kind :aux) fact kind) scope)))
    (assert (eq (cdr (assoc 'z scope)) :optional))
    (assert (equal processed '(x &optional (y r) &rest r &aux (z y)))))
  (multiple-value-bind (scope processed)
      (snowgrave::analyze-source-multiple-value-bindings
       '(x y) :producer nil
       (lambda (producer scope) (declare (ignore scope)) (values '(:primary) producer nil))
       (lambda (name kind fact scope) (acons name (list kind fact) scope)))
    (assert (eq processed :producer))
    (assert (equal (cdr (assoc 'x scope)) '(:provided :primary)))
    (assert (equal (cdr (assoc 'y scope)) '(:unknown nil))))
  (format t "Portable source owner executed.~%"))
