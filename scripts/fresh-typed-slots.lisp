(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-typed-slots-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.TYPED-SLOTS.FIXTURE")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (load (compile-file source))
  (let* ((unit (with-open-file (stream metadata) (read stream)))
         (vector (make-array 3 :element-type '(unsigned-byte 32) :initial-element #xffffffff))
         (record (funcall (snowgrave.artifact-tests:artifact-function unit "BOOT") vector))
         (observe (snowgrave.artifact-tests:artifact-function unit "OBSERVE"))
         (write (snowgrave.artifact-tests:artifact-function unit "WRITE-U")))
    (assert (not (find-class (find-symbol "LEAF" "SNOWGRAVE.TYPED-SLOTS.FIXTURE") nil)))
    (assert (equal (multiple-value-list (funcall observe record)) (list 131071 -32768 1 vector)))
    (assert (handler-case (progn (funcall write record 131072) nil) (type-error () t)))
    (assert (= 131071 (funcall observe record)))
    (assert (= 0 (funcall write record 0)))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh typed slots executed.~%")
