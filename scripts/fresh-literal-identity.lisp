(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-literal-identity-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.LITERAL.IDENTITY")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (multiple-value-bind (artifact warnings failure)
      (compile-file source :output-file (merge-pathnames ".build/fresh-literal-identity.fasl"
                                                        (asdf:system-source-directory "snowgrave")))
    (declare (ignore warnings))
    (assert (not failure)) (load artifact))
  (let ((unit (with-open-file (in metadata) (read in))))
    (assert (equal '(nil nil t nil nil t nil t t t nil)
                   (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function unit "OBSERVE")))))
    (assert (string= "same" (aref (funcall (snowgrave.artifact-tests:artifact-function unit "LEFT")) 2)))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh literal identity executed.~%")
