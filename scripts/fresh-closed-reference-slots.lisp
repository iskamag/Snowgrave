(require :asdf)
(let ((root (merge-pathnames "../" (make-pathname :name nil :type nil :defaults *load-truename*))))
  (load (merge-pathnames "snowgrave.asd" root))
  (asdf:load-system "snowgrave")
  (load (merge-pathnames "scripts/artifact-functions.lisp" root)))

(destructuring-bind (source data) (uiop:command-line-arguments)
  (let* ((compiled (compile-file source))
         (ignored (load compiled))
         (metadata (with-open-file (stream data) (with-standard-io-syntax (read stream)))))
    (declare (ignore ignored))
    (flet ((entry (name) (snowgrave.artifact-tests:artifact-function metadata name)))
      (let* ((node (funcall (entry "BOOT-LEAF")))
             (holder (funcall (entry "BOOT-NARROW") node)))
        (assert (eq node (funcall (entry "WRITE-NEXT") node node)))
        (assert (eq node (funcall (entry "RELOAD") holder)))
        (assert (eq node (funcall (entry "RELOAD-RAW") holder)))
        (assert (handler-case (progn (funcall (entry "WRITE-ITEM") holder :invalid) nil)
                  (type-error () t)))
        (assert (eq node (funcall (entry "READ-ITEM") holder)))
        (assert (not (find-class (find-symbol "LEAF" :snowgrave.closed-reference-slots.fixture) nil)))
        (format t "Fresh closed reference slots executed.~%")))))
