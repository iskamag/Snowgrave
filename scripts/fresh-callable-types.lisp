(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-callable-types-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(load (compile-file (first (uiop:command-line-arguments))))
(let* ((metadata (with-open-file (stream (second (uiop:command-line-arguments))) (read stream)))
       (identity (getf metadata :identity))
       (package (find-package (format nil "SNOWGRAVE.UNIT.~A" (with-standard-io-syntax (write-to-string identity)))))
       (callable (funcall (snowgrave.artifact-tests:artifact-function metadata "CALLABLE-RESULT"))))
  (assert (not (fboundp (intern "LOGICAL-CALLABLE" "SNOWGRAVE.FIXTURE"))))
  (assert (not (fboundp (intern "CLOSE-SOURCE" "SNOWGRAVE.SBCL"))))
  (assert (compiled-function-p callable))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "CALLABLE-OBSERVATION")))
                 '(t nil :function :function :function)))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "CALLABLE-INPUT") callable)) '(nil :function)))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "CALLABLE-INPUT") #'identity)) '(t :function)))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "CALLABLE-ONCE"))) '(nil 1)))
  (format t "Fresh logical callable types executed.~%"))
