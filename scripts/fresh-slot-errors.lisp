(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-slot-errors-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(load (compile-file (first (uiop:command-line-arguments))))
(let* ((metadata (with-open-file (stream (second (uiop:command-line-arguments))) (read stream)))
       (identity (getf metadata :identity))
       (package (find-package (format nil "SNOWGRAVE.UNIT.~A" (with-standard-io-syntax (write-to-string identity))))))
  (assert (= (getf metadata :abi-version) 3))
  (assert (not (fboundp 'snowgrave.sbcl:close-source)))
  (dolist (description (getf metadata :record-layouts))
    (let* ((record (snowgrave:sg-make-record
                    (snowgrave:make-layout (getf description :identity) (getf description :class)
                                          (getf description :ancestors) (getf description :slots)
                                          :error-mapping (getf description :error-mapping))))
           (slot (find "PAYLOAD" (getf description :slots) :key #'symbol-name :test #'string=)))
      (assert (not (find-class (getf description :class) nil)))
      (dolist (entry '("READ-ABSENT" "BOUND-ABSENT" "UNBIND-ABSENT" "READ-HINT" "WRITE-ABSENT"))
        (let ((condition (handler-case
                             (apply (snowgrave.artifact-tests:artifact-function metadata entry) record (when (string= entry "WRITE-ABSENT") '(17)))
                           (error (condition) condition))))
          (assert (eq (type-of condition) 'sb-pcl::missing-slot))
          (assert (eq (third (simple-condition-format-arguments condition)) record))))
      (assert (= 42 (handler-bind ((unbound-slot (lambda (condition) (invoke-restart (find-restart 'use-value condition) 42))))
                      (funcall (snowgrave.artifact-tests:artifact-function metadata "READ-UNBOUND") record))))
      (assert (not (snowgrave:sg-record-boundp record slot)))
      (assert (= 43 (handler-bind ((unbound-slot (lambda (condition) (invoke-restart (find-restart 'store-value condition) 43))))
                      (snowgrave:sg-record-read record slot))))
      (assert (= 43 (snowgrave:sg-record-read record slot)))
      (let ((condition (handler-case (snowgrave:sg-record-boundp record :absent)
                         (error (condition) condition))))
        (assert (eq (type-of condition) 'sb-pcl::missing-slot))
        (assert (eq (cell-error-name condition) :absent)))))
  (format t "Fresh slot error mappings executed.~%"))
