(require :asdf)
(let* ((root (or (uiop:getenv "SNOWGRAVE_PROBE_SOURCE")
                 (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*))))
       (cache (or (uiop:getenv "SNOWGRAVE_PROBE_CACHE")
                  (merge-pathnames ".build/variable-secondary-values-probe-fasl/" root))))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave/sbcl")
(defpackage #:snowgrave.variable-secondary-values-probe (:use #:cl)
  (:shadowing-import-from #:snowgrave #:defclass #:defgeneric #:defmethod))
(let* ((*package* (find-package :snowgrave.variable-secondary-values-probe))
       (baselinep (equal (uiop:command-line-arguments) '("baseline")))
       (class (intern "RECORD")) (generic (intern "VALUE")) (entry (intern "ENTRY"))
       (boot (intern "BOOT"))
       (forms (read-from-string "((defclass record () ((payload :initarg :payload)))
              (defgeneric value (r n))
              (defmethod value ((r record) (n number)) (+ n (slot-value r 'payload)))
              (defun pack (r n)
                (if (plusp n) (values :tag r #'value :extra) (values :tag r #'value)))
              (defun boot () (make-instance 'record :payload 17))
              (defun entry (r n) (multiple-value-bind (tag object function extra) (pack r n)
                (values (slot-value object 'payload) (funcall function object n) tag extra))))")))
  (dolist (form forms) (eval form))
  (let ((ordinary (loop for n in '(5 -2) collect (multiple-value-list (funcall entry (funcall boot) n)))))
    (format t "ORDINARY-VARIABLE-SECONDARY-VALUES: ~S~%" ordinary)
    (handler-case
        (let* ((unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(variable-secondary-values-probe)
                       :closed-classes (list class) :closed-generics (list generic) :universe (list class 'number)
                       :entries (list entry boot) :external-domains (list (list entry (list class 'number)) (list boot nil))))
               (closed (loop for n in '(5 -2) collect (multiple-value-list
                         (funcall (snowgrave:unit-function unit entry) (funcall (snowgrave:unit-function unit boot)) n)))))
          (assert (not baselinep)) (assert (equal ordinary closed))
          (format t "CLOSED-VARIABLE-SECONDARY-VALUES: ~S~%" closed))
      (snowgrave:snowgrave-error (condition)
        (assert baselinep) (assert (eq (snowgrave:error-feature condition) :record-slot-domain))
        (format t "VARIABLE-SECONDARY-VALUES-REFUSAL: ~S/~S~%" (type-of condition) (snowgrave:error-feature condition))))))
