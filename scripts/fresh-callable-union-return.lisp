(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-callable-union-return-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.CALLABLE-UNION-RETURN.FIXTURE")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (load (compile-file source :output-file (merge-pathnames ".build/fresh-callable-union-return.fasl"
                                                        (asdf:system-source-directory "snowgrave"))))
  (let* ((unit (with-open-file (stream metadata) (read stream)))
         (entry (find-symbol "ENTRY" "SNOWGRAVE.CALLABLE-UNION-RETURN.FIXTURE")))
    (dolist (name '("ACCEPT" "LEFT" "RIGHT" "ENTRY"))
      (assert (not (fboundp (find-symbol name "SNOWGRAVE.CALLABLE-UNION-RETURN.FIXTURE")))))
    (assert (equal (funcall (snowgrave.artifact-tests:artifact-function unit entry) t 17) '(:accepted 18)))
    (assert (equal (funcall (snowgrave.artifact-tests:artifact-function unit entry) nil 17) '(:accepted 16)))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh finite callable returns executed.~%")
