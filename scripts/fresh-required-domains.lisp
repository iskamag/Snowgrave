(require :asdf)
(let ((root (uiop:pathname-parent-directory-pathname
             (uiop:pathname-directory-pathname *load-truename*))))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations
   `(:output-translations (t ,(merge-pathnames ".build/fresh-required-domains-fasl/" root))
     :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(defpackage #:snowgrave.required-domains.fixture (:use #:cl))
(defvar snowgrave.required-domains.fixture::*cell*)
(defvar snowgrave.required-domains.fixture::*events*)
(defun snowgrave.required-domains.fixture::observe (phase)
  (push (list phase (car snowgrave.required-domains.fixture::*cell*))
        snowgrave.required-domains.fixture::*events*))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (multiple-value-bind (artifact warnings failure)
      (compile-file source :output-file (compile-file-pathname source))
    (declare (ignore warnings)) (assert (not failure)) (load artifact))
  (let ((metadata (with-open-file (input metadata) (read input))))
    (dolist (name '("DIRECT" "INDIRECT" "VIA-APPLY" "VIA-VALUES" "VIA-HELPER"))
      (let* ((row (find name (getf metadata :entries)
                        :key (lambda (row) (symbol-name (getf row :name))) :test #'equal))
             (key (getf row :code-key))
             (entry (fdefinition (find-symbol (second key) (first key))))
             (snowgrave.required-domains.fixture::*cell* (cons nil nil))
             (snowgrave.required-domains.fixture::*events* nil))
        (assert (equal '(47 :stored)
                       (multiple-value-list
                        (funcall entry snowgrave.required-domains.fixture::*cell* 47))))
        (assert (equal '((:enter nil) (:before nil) (:write 47) (:after 47) (:exit 47))
                       (reverse snowgrave.required-domains.fixture::*events*)))))))
(assert (not (find-class 'snowgrave.required-domains.fixture::marker nil)))
(assert (not (fboundp 'snowgrave.required-domains.fixture::store)))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh required generic domains executed.~%")
