(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/checkpoint-owner-probe-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave/sbcl")
(defpackage #:clamsara (:use #:cl) (:export #:checkpoint-owner-supported-p))
(let* ((*package* (find-package :clamsara))
       (root (asdf:system-source-directory "snowgrave"))
       ;; Freeze the owner-local support method here: the probe must run from
       ;; a source checkout without an audit scratch directory or Clamsara.
       (ordinary (read-from-string
                  "((defclass composed-barrier () ())
                    (defclass checkpoint-proof-child (composed-barrier) ())
                    (defgeneric checkpoint-owner-supported-p (owner configuration mode))
                    (defmethod checkpoint-owner-supported-p ((owner t) configuration mode)
                      (declare (ignore owner configuration mode)) nil)
                    (defmethod checkpoint-owner-supported-p ((owner composed-barrier) configuration mode)
                      (declare (ignore configuration))
                      (and (eq mode :settled)
                           (eq (class-of owner) (find-class 'composed-barrier))))
                    (defun checkpoint-proof-entry (owner mode)
                      (checkpoint-owner-supported-p owner nil mode))
                    (defun checkpoint-proof-boot () (make-instance 'composed-barrier))
                    (defun checkpoint-proof-boot-child () (make-instance 'checkpoint-proof-child)))"))
       (base (intern "COMPOSED-BARRIER")) (child (intern "CHECKPOINT-PROOF-CHILD"))
       (generic (intern "CHECKPOINT-OWNER-SUPPORTED-P"))
       (entry (intern "CHECKPOINT-PROOF-ENTRY")) (boot (intern "CHECKPOINT-PROOF-BOOT"))
       (boot-child (intern "CHECKPOINT-PROOF-BOOT-CHILD"))
       (forward (intern "CHECKPOINT-FORWARD")) (backward (intern "CHECKPOINT-BACKWARD"))
       (observations nil))
  (setf ordinary (append ordinary (read-from-string
    "((defparameter *checkpoint-proof-trace* nil)
      (defun checkpoint-forward (object)
        (let ((*checkpoint-proof-trace* nil))
          (values (eq (class-of (progn (push :receiver *checkpoint-proof-trace*) object))
                      (find-class 'composed-barrier)) (reverse *checkpoint-proof-trace*))))
      (defun checkpoint-backward (object)
        (let ((*checkpoint-proof-trace* nil))
          (values (eq (find-class 'composed-barrier)
                      (class-of (progn (push :receiver *checkpoint-proof-trace*) object)))
                  (reverse *checkpoint-proof-trace*)))))")))
  (dolist (form ordinary) (eval form))
  (flet ((domains () (list (list entry '(t t)) (list boot nil) (list boot-child nil)
                           (list forward (list base)) (list backward (list base)))))
    (let* ((unit (snowgrave:close-source-unit (list :forms ordinary) :unit-name '(checkpoint-owner-exact-class)
                   :closed-classes (list base child) :closed-generics (list generic) :universe (list base child)
                   :entries (list entry boot boot-child forward backward) :external-domains (domains)))
           (native (funcall boot)) (native-child (funcall boot-child))
           (closed (funcall (snowgrave:unit-function unit boot)))
           (closed-child (funcall (snowgrave:unit-function unit boot-child))))
      (loop for original in (list native native-child nil 0)
            for replacement in (list closed closed-child nil 0) for index from 0 do
        (dolist (mode '(:settled :other nil))
          (let ((expected (multiple-value-list (funcall entry original mode))))
            (assert (equal expected (multiple-value-list (funcall (snowgrave:unit-function unit entry) replacement mode))))
            (push (list "CHECKPOINT-PROOF-ENTRY" index mode expected) observations))))
      (loop for original in (list native native-child) for replacement in (list closed closed-child)
            for index from 0 do
        (dolist (name (list forward backward))
          (let ((expected (multiple-value-list (funcall name original))))
            (assert (equal expected (multiple-value-list (funcall (snowgrave:unit-function unit name) replacement))))
            (assert (equal '(:receiver) (second expected)))
            (push (list (symbol-name name) index nil expected) observations))))
      (labels ((no-open-reflection (form)
                 (unless (or (atom form) (eq (car form) 'quote))
                   (assert (not (member (car form) '(class-of find-class))))
                   (no-open-reflection (car form)) (no-open-reflection (cdr form)))))
        (mapc #'no-open-reflection (snowgrave:unit-source unit)))
      (labels ((refused (body feature &optional (domain base))
                 (let* ((bad (intern "CHECKPOINT-BAD"))
                        (extra (list `(defun ,bad (,(intern "OBJECT")) ,(read-from-string body)))))
                   (assert (handler-case
                            (progn (snowgrave:close-source-unit (list :forms (append ordinary extra))
                                     :unit-name (list :checkpoint-class-refusal body)
                                     :closed-classes (list base child) :closed-generics (list generic) :universe (list base child)
                                     :entries (list bad) :external-domains (list (list bad (list domain)))) nil)
                            (snowgrave:unclosed-class-operation (condition) (eq feature (snowgrave:error-feature condition))))))))
        (refused "(class-of object)" 'class-of)
        (refused "(find-class 'composed-barrier)" 'find-class)
        (refused "(eq (class-of object) (find-class 'composed-barrier))" :exact-class-receiver t)
        (refused "(eq (class-of object) (find-class 'number))" 'class-of)
        (refused "(eq (class-of object) (find-class 'composed-barrier nil))" 'class-of))
      (let ((source (merge-pathnames ".build/fresh-checkpoint-owner.lisp" root))
            (metadata (merge-pathnames ".build/fresh-checkpoint-owner.metadata" root))
            (expected (merge-pathnames ".build/fresh-checkpoint-owner.expected" root)))
        (with-open-file (stream source :direction :output :if-exists :supersede) (snowgrave:write-unit-source unit stream))
        (with-open-file (stream metadata :direction :output :if-exists :supersede) (snowgrave:write-unit-metadata unit stream))
        (with-open-file (stream expected :direction :output :if-exists :supersede) (write (nreverse observations) :stream stream :readably t))
        (assert (search "Fresh actual checkpoint owner executed."
                        (uiop:run-program (list "sbcl" "--no-sysinit" "--no-userinit" "--script"
                                                (namestring (merge-pathnames "scripts/fresh-checkpoint-owner.lisp" root))
                                                (namestring source) (namestring metadata) (namestring expected)) :output :string))))))
  (format t "ACTUAL-CHECKPOINT-OWNER-CLOSED: exact base/subclass/foreign/mode/effects and five refusals passed.~%"))
