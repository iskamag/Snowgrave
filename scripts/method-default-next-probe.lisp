(require :asdf)
(let* ((root (or (uiop:getenv "SNOWGRAVE_PROBE_SOURCE")
                 (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*))))
       (cache (or (uiop:getenv "SNOWGRAVE_PROBE_CACHE")
                  (merge-pathnames ".build/method-default-next-probe-fasl/" root))))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave/sbcl")
(defpackage #:snowgrave.method-default-next-probe (:use #:cl)
  (:shadowing-import-from #:snowgrave #:defclass #:defgeneric #:defmethod))
(let* ((*package* (find-package :snowgrave.method-default-next-probe))
       (baselinep (equal (uiop:command-line-arguments) '("baseline")))
       (base (intern "BASE")) (leaf (intern "LEAF")) (generic (intern "VALUE"))
       (entry (intern "ENTRY")) (boot (intern "BOOT"))
       (forms (read-from-string "((defclass base () ()) (defclass leaf (base) ())
          (defgeneric value (r &optional n))
          (defmethod value ((r base) &optional n) (declare (ignore r n)) 7)
          (defmethod value ((r leaf) &optional (n (call-next-method))) (declare (ignore r)) (values n :tag))
          (defun entry (r) (value r)) (defun boot () (make-instance 'leaf)))")))
  (dolist (form forms) (eval form))
  (let* ((native (multiple-value-list (funcall entry (funcall boot))))
         (unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(method-default-next-probe)
                 :closed-classes (list base leaf) :closed-generics (list generic) :universe (list base leaf)
                 :entries (list entry boot) :external-domains (list (list entry (list leaf)) (list boot nil)))))
    (assert (eq (getf (snowgrave:unit-report unit) :claim) :semantically-closed))
    (format t "METHOD-DEFAULT-NATIVE: ~S~%METHOD-DEFAULT-CLAIM: :SEMANTICALLY-CLOSED~%" native)
    (handler-case
        (let ((closed (multiple-value-list (funcall (snowgrave:unit-function unit entry)
                                                    (funcall (snowgrave:unit-function unit boot))))))
          (assert (not baselinep)) (assert (equal native closed))
          (format t "METHOD-DEFAULT-CLOSED: ~S~%" closed))
      (sb-pcl::no-next-method-error (condition)
        (assert baselinep)
        (format t "METHOD-DEFAULT-CLOSED-ERROR: ~S ~A~%" (type-of condition) condition)))))
