(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-partition-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.PARTITION.FIXTURE")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (multiple-value-bind (artifact warnings failure)
      (compile-file source :output-file (merge-pathnames ".build/fresh-partition.fasl" (asdf:system-source-directory "snowgrave")))
    (declare (ignore warnings)) (assert (not failure)) (load artifact))
  (let* ((data (with-open-file (stream metadata) (read stream)))
         (log (find-symbol "*LOG*" "SNOWGRAVE.PARTITION.FIXTURE")))
    (assert (= 17 (length (getf (first (getf data :dispatch)) :cells))))
    (dolist (boot '("BOOT" "BOOT-FAST"))
      (let* ((visitor (funcall (snowgrave.artifact-tests:artifact-function data boot) 17))
             (arguments (list visitor :b 3 #\c "text" nil visitor)))
        (progv (list log) (list nil)
          (let ((values (multiple-value-list (apply (snowgrave.artifact-tests:artifact-function data "RUN") visitor arguments))))
            (assert (= 17 (first values)))
            (assert (every #'eq (cdr values) arguments))
            (assert (equal (reverse (symbol-value log))
                           (if (equal boot "BOOT") '(:around :before :base :after :cleanup)
                               '(:around :before :fast :base :after :cleanup))))))))
    (assert (not (find-class (find-symbol "VISITOR" "SNOWGRAVE.PARTITION.FIXTURE") nil)))
    (assert (not (fboundp (find-symbol "VISIT" "SNOWGRAVE.PARTITION.FIXTURE"))))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh eight-axis visitor executed.~%")
