(require :asdf)
(let* ((root (or (uiop:getenv "SNOWGRAVE_PROBE_SOURCE")
                 (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*))))
       (cache (or (uiop:getenv "SNOWGRAVE_PROBE_CACHE")
                  (merge-pathnames ".build/helper-multiple-value-call-probe-fasl/" root))))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave/sbcl")
(defpackage #:snowgrave.helper-multiple-value-call-probe (:use #:cl)
  (:shadowing-import-from #:snowgrave #:defclass #:defgeneric #:defmethod))
(let* ((*package* (find-package :snowgrave.helper-multiple-value-call-probe))
       (baselinep (equal (uiop:command-line-arguments) '("baseline")))
       (class (intern "RECORD")) (generic (intern "VALUE")) (entry (intern "ENTRY"))
       (boot (intern "BOOT")) (trace (intern "*TRACE*"))
       (forms (read-from-string "((defclass record () ((payload :initarg :payload)))
              (defparameter *trace* nil)
              (defgeneric value (r n))
              (defmethod value ((r record) (n number)) (values (+ n (slot-value r 'payload)) :tag nil))
              (defun relay (r) (pack r))
              (defun pack (r) (push :pack *trace*) (values r 5))
              (defun zero () (push :zero *trace*) (values))
              (defun boot () (make-instance 'record :payload 17))
              (defun entry (r)
                (multiple-value-prog1
                    (multiple-value-call (progn (push :callee *trace*) #'value) (zero) (relay r))
                  (push :after *trace*))))")))
  (dolist (form forms) (eval form))
  (let ((ordinary (multiple-value-list (funcall entry (funcall boot))))
        (effects (reverse (symbol-value trace))))
    (format t "ORDINARY-HELPER-MVC: ~S ~S~%" ordinary effects)
    (handler-case
        (let* ((unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(helper-multiple-value-call-probe)
                       :closed-classes (list class) :closed-generics (list generic) :universe (list class 'number)
                       :entries (list entry boot) :external-domains (list (list entry (list class)) (list boot nil))))
               (record (funcall (snowgrave:unit-function unit boot))))
          (assert (not baselinep)) (setf (symbol-value trace) nil)
          (let ((closed (multiple-value-list (funcall (snowgrave:unit-function unit entry) record)))
                (closed-effects (reverse (symbol-value trace))))
            (assert (equal ordinary closed)) (assert (equal effects closed-effects))
            (format t "CLOSED-HELPER-MVC: ~S ~S~%" closed closed-effects)))
      (snowgrave:snowgrave-error (condition)
        (assert baselinep) (assert (eq (snowgrave:error-feature condition) :multiple-value-arguments))
        (format t "HELPER-MVC-REFUSAL: ~S/~S~%" (type-of condition) (snowgrave:error-feature condition))))))
