;;;; Hosted execution of the actual native macro's guarded expression with
;;;; receiver/count plumbing modeled explicitly. Not native ABI execution.
(defvar *anonymous-model-effects* nil)
(let* ((macro (cross-cl:macro-function 'snowgrave.mezzano-access:admitted-lambda))
       (expanded (funcall macro
                          '(snowgrave.mezzano-access:admitted-lambda
                               (x &optional (y (progn (push :default *anonymous-model-effects*) x) supplied-p))
                               (values nil :bad-count)
                             (declare (type fixnum x)) (values x y supplied-p)) nil))
       (lambda (second expanded)) (arguments (second lambda))
       (rest-index (position '&rest arguments))
       (receivers (subseq arguments 1 rest-index))
       (ignored-rest (nth (1+ rest-index) arguments))
       (count (car (last arguments))) (provided (gensym "PROVIDED")))
  (labels ((without-access-scope (form)
             (cond ((and (consp form) (eq (first form) 'snowgrave.mezzano-access:with-admitted-access))
                    `(progn ,@(mapcar #'without-access-scope (cddr form))))
                   ((consp form) (mapcar #'without-access-scope form))
                   (t form))))
    (let ((entry (compile nil
                         `(lambda (&rest ,provided)
                            (let* ((,count (length ,provided)) (,ignored-rest nil)
                                   ,@(loop for receiver in receivers for index from 0 append
                                       (if (consp receiver)
                                           `((,(first receiver) (nth ,index ,provided))
                                             (,(third receiver) (> ,count ,index)))
                                           `((,receiver (nth ,index ,provided))))))
                              (declare (ignore ,ignored-rest))
                              ,(without-access-scope (car (last lambda))))))))
      (setf *anonymous-model-effects* nil)
      (assert (equal (multiple-value-list (funcall entry 7)) '(7 7 nil)))
      (assert (equal *anonymous-model-effects* '(:default)))
      (setf *anonymous-model-effects* nil)
      (assert (equal (multiple-value-list (funcall entry 7 nil)) '(7 nil t)))
      (assert (null *anonymous-model-effects*))
      (dolist (arguments '(nil (1 2 3) (1 2 3 4 5 6)))
        (assert (equal (multiple-value-list (apply entry arguments)) '(nil :bad-count))))
      (assert (null *anonymous-model-effects*))))
  (format t "HOSTED-NATIVE-ANONYMOUS-GUARD-MODEL-PASSED; NOT NATIVE EXECUTION~%"))
