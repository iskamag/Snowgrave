(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*))))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:load-system :snowgrave))
(load (first (uiop:command-line-arguments)))
(let* ((package (find-package "SNOWGRAVE.UNIT.(:FINITE-OPTIONAL-CALLS)"))
       (fixture (find-package "SNOWGRAVE.OPTIONAL-CALLS.FIXTURE")))
  (flet ((entry (name)
           (let ((key (snowgrave::function-name-key (intern name fixture))))
             (fdefinition (intern (with-standard-io-syntax (write-to-string key)) package)))))
    (let ((record (funcall (entry "BOOT"))))
      (dolist (name '("OMITTED" "LITERAL" "VIA-HELPER"))
        (assert (equal '(401 nil 402 nil 19) (multiple-value-list (funcall (entry name) record)))))
      (assert (equal '(nil t nil t 19) (multiple-value-list (funcall (entry "SUPPLIED-NIL") record))))
      (assert (equal '(23 t 24 t 19) (multiple-value-list (funcall (entry "VIA-VALUES") record)))))))
(format t "~&Fresh optional calls executed.~%")
