(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-namespace-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(defpackage :snowgrave.namespace.a (:use :cl) (:shadow :identity))
(defpackage :snowgrave.namespace.b (:use :cl))
(setf (fdefinition (intern "OBSERVE" :snowgrave.namespace.a)) (lambda (n) (+ n 100))
      (fdefinition (intern "OBSERVE" :snowgrave.namespace.b)) (lambda (n) (+ n 200)))
(load (compile-file (first (uiop:command-line-arguments))))
(let ((metadata (with-open-file (stream (second (uiop:command-line-arguments))) (read stream))))
  (assert (= (getf metadata :abi-version) 3))
  (assert (not (fboundp (intern "CLOSE-SOURCE" "SNOWGRAVE.SBCL"))))
  (assert (= (funcall (snowgrave.artifact-tests:artifact-function metadata (intern "CL-IDENTITY-ENTRY" :snowgrave.namespace.b))) 7))
  (assert (eq (funcall (snowgrave.artifact-tests:artifact-function metadata (intern "LOCAL-IDENTITY-ENTRY" :snowgrave.namespace.a))) :wrong-binding))
  (let ((records (loop for package in '(:snowgrave.namespace.a :snowgrave.namespace.b) for value in '(3 5)
                       collect (funcall (snowgrave.artifact-tests:artifact-function metadata (intern "BOOT" package)) value))))
    (assert (not (eq (snowgrave:sg-record-class (first records)) (snowgrave:sg-record-class (second records)))))
    (loop for package in '(:snowgrave.namespace.a :snowgrave.namespace.b) for record in records for expected in '(23 37) do
      (assert (not (find-class (intern "POLICY" package) nil)))
      (assert (not (fboundp (intern "SCORE" package))))
      (assert (= (funcall (snowgrave.artifact-tests:artifact-function metadata (intern "ENTRY" package)) record 7) expected))
      (assert (= (funcall (snowgrave.artifact-tests:artifact-function metadata (intern "WRITE-ENTRY" package)) record 9) 9))
      (assert (= (snowgrave:sg-record-read record (intern "PAYLOAD" package)) 9))))
  (assert (= (funcall (snowgrave.artifact-tests:artifact-function metadata (intern "EXTERNAL-ENTRY" :snowgrave.namespace.a)) 7) 107))
  (assert (= (funcall (snowgrave.artifact-tests:artifact-function metadata (intern "EXTERNAL-ENTRY" :snowgrave.namespace.b)) 7) 207))
  (format t "Fresh qualified namespaces executed.~%"))
