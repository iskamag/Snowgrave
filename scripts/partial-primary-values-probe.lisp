(require :asdf)
(let* ((root (or (uiop:getenv "SNOWGRAVE_PROBE_SOURCE")
                 (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*))))
       (cache (or (uiop:getenv "SNOWGRAVE_PROBE_CACHE")
                  (merge-pathnames ".build/partial-primary-values-probe-fasl/" root))))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave/sbcl")
(defpackage #:snowgrave.partial-primary-values-probe (:use #:cl) (:shadowing-import-from #:snowgrave #:defclass))
(let* ((*package* (find-package :snowgrave.partial-primary-values-probe))
       (baselinep (equal (uiop:command-line-arguments) '("baseline")))
       (class (intern "RECORD")) (entry (intern "ENTRY"))
       (forms (read-from-string "((defclass record () ((payload :initarg :payload)))
                 (defun construct () (make-instance 'record :payload 17))
                 (defun entry () (multiple-value-bind (object missing) (construct)
                                  (values (slot-value object 'payload) missing))))")))
  (dolist (form forms) (eval form))
  (let ((ordinary (multiple-value-list (funcall entry))))
    (format t "ORDINARY-PARTIAL-PRIMARY-VALUES: ~S~%" ordinary)
    (handler-case
        (let* ((unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(partial-primary-values-probe)
                       :closed-classes (list class) :universe (list class)
                       :entries (list entry) :external-domains (list (list entry nil))))
               (closed (multiple-value-list (funcall (snowgrave:unit-function unit entry)))))
          (assert (not baselinep)) (assert (equal ordinary closed))
          (format t "CLOSED-PARTIAL-PRIMARY-VALUES: ~S~%" closed))
      (snowgrave:snowgrave-error (condition)
        (assert baselinep) (assert (eq (snowgrave:error-feature condition) :record-slot-domain))
        (format t "PARTIAL-PRIMARY-VALUES-REFUSAL: ~S/~S~%" (type-of condition) (snowgrave:error-feature condition))))))
