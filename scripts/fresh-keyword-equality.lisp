(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-keyword-equality-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.KEYWORD.FIXTURE")))
(destructuring-bind (source metadata observations) (uiop:command-line-arguments)
  (multiple-value-bind (artifact warnings failure)
      (compile-file source :output-file (merge-pathnames ".build/fresh-keyword-equality.fasl" (asdf:system-source-directory "snowgrave")))
    (declare (ignore warnings)) (assert (not failure)) (load artifact))
  (let ((unit (with-open-file (stream metadata) (read stream)))
        (expected (with-open-file (stream observations) (read stream))))
    (assert (= (length (getf unit :entries)) (length expected)))
    (assert (not (find-class (find-symbol "SAMPLE" "SNOWGRAVE.KEYWORD.FIXTURE") nil)))
    (dolist (name '("FRESH-RECORD" "CHOOSE-TEST" "OBSERVE-KEY" "OBSERVE-TEST"))
      (assert (not (fboundp (find-symbol name "SNOWGRAVE.KEYWORD.FIXTURE")))))
    (loop for record in (getf unit :entries) for cases in expected
          for name = (getf record :name) for function = (snowgrave.artifact-tests:artifact-function unit name) do
      (assert (not (fboundp name)))
      (dolist (case cases)
        (assert (equal (second case) (multiple-value-list (funcall function (first case)))))))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh keyword record equality executed.~%")
