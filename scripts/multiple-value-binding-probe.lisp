(require :asdf)
(let* ((root (or (uiop:getenv "SNOWGRAVE_PROBE_SOURCE")
                 (uiop:pathname-parent-directory-pathname
                  (uiop:pathname-directory-pathname *load-truename*))))
       (cache (or (uiop:getenv "SNOWGRAVE_PROBE_CACHE")
                  (merge-pathnames ".build/multiple-value-binding-probe-fasl/" root))))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave/sbcl")
(defpackage #:snowgrave.multiple-value-probe
  (:use #:cl) (:shadowing-import-from #:snowgrave #:defclass #:defgeneric #:defmethod))
(defun observe-secondary-shared-callback ()
  (typep (symbol-value (find-symbol "*SHARED*" :snowgrave.multiple-value-probe)) 'generic-function))
(let* ((*package* (find-package :snowgrave.multiple-value-probe))
       (baselinep (equal (uiop:command-line-arguments) '("baseline")))
       (class (intern "RECORD")) (generic (intern "VALUE")) (entry (intern "ENTRY")) (boot (intern "BOOT"))
       (prefix (read-from-string
                "((defclass record () ((payload :initarg :payload)))
                   (defgeneric value (r))
                   (defmethod value ((r record)) (slot-value r 'payload))
                   (defun boot () (make-instance 'record :payload 17)))")))
  (dolist (body '("(multiple-value-bind (tag object missing) (values :tag r) (values (slot-value object 'payload) tag missing))"
                  "(multiple-value-bind (tag function) (values :tag #'value) (values (funcall function r) tag))"))
    (let ((forms (append prefix (list `(defun ,entry (,(intern "R")) ,(read-from-string body))))))
      (dolist (form forms) (eval form))
      (let* ((native (make-instance class :payload 17))
             (ordinary (multiple-value-list (funcall entry native))))
        (handler-case
            (let* ((unit (snowgrave:close-source-unit
                          (list :forms forms) :unit-name (list :secondary-binding-probe body)
                          :closed-classes (list class) :closed-generics (list generic) :universe (list class)
                          :entries (list entry boot) :external-domains (list (list entry (list class)) (list boot nil))))
                   (record (funcall (snowgrave:unit-function unit boot)))
                   (closed (multiple-value-list (funcall (snowgrave:unit-function unit entry) record))))
              (assert (not baselinep)) (assert (equal ordinary closed))
              (format t "SECONDARY-BIND ORDINARY=~S CLOSED=~S~%" ordinary closed))
          (snowgrave:snowgrave-error (condition)
            (assert baselinep)
            (assert (member (snowgrave:error-feature condition) '(:record-slot-domain :computed-function)))
            (format t "SECONDARY-BIND ORDINARY=~S REFUSAL=~S/~S~%"
                    ordinary (type-of condition) (snowgrave:error-feature condition)))))))
  (let ((forms (read-from-string
                "((defparameter *shared* nil)
                   (defgeneric callback (x)) (defmethod callback ((x number)) x)
                   (defun producer () (values 0 #'callback))
                   (defun entry ()
                     (multiple-value-bind (ignored *shared*) (producer)
                       (declare (ignore ignored))
                       (cl-user::observe-secondary-shared-callback))))"))
        (callback (intern "CALLBACK")))
    (dolist (form forms) (eval form))
    (let ((ordinary (funcall entry)))
      (assert ordinary)
      (handler-case
          (let* ((unit (snowgrave:close-source-unit
                        (list :forms forms) :unit-name '(secondary-shared-observer-probe)
                        :closed-generics (list callback) :universe '(number)
                        :entries (list entry) :external-domains (list (list entry nil))
                        :external-operations '(cl-user::observe-secondary-shared-callback)))
                 (closed (funcall (snowgrave:unit-function unit entry))))
            (assert baselinep) (assert (null closed))
            (assert (eq (getf (snowgrave:unit-report unit) :claim) :semantically-closed))
            (format t "SECONDARY-SHARED ORDINARY=~S CLOSED=~S CLAIM=:SEMANTICALLY-CLOSED~%" ordinary closed))
        (snowgrave:unclosed-call (condition)
          (assert (not baselinep))
          (assert (eq (snowgrave:error-feature condition) :external-shared-state-representation))
          (format t "SECONDARY-SHARED ORDINARY=~S REFUSAL=~S/~S~%"
                  ordinary (type-of condition) (snowgrave:error-feature condition)))))))
