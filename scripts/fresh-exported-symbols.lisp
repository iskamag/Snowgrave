(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-exported-symbols-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.EXPORTED.FIXTURE")))
(multiple-value-bind (fasl warnings failure) (compile-file (first (uiop:command-line-arguments)))
  (declare (ignore warnings))
  (when failure (error "Exported-symbol artifact cannot be read/compiled"))
  (load fasl))
(let* ((metadata (with-open-file (stream (second (uiop:command-line-arguments))) (read stream)))
       (package (find-package "SNOWGRAVE.EXPORTED.FIXTURE"))
       (entry (find-symbol "ENTRY" package))
       (metadata-entry (find-symbol "METADATA-ENTRY" package))
       (tag (find-symbol "TAG" package))
       (identity (find-symbol "IDENTITY" package)))
  (dolist (name '("ENTRY" "METADATA-ENTRY" "TAG" "IDENTITY"))
    (assert (eq (nth-value 1 (find-symbol name package)) :external)))
  (assert (not (eq identity 'cl:identity)))
  (assert (not (fboundp entry)))
  (assert (not (fboundp metadata-entry)))
  (assert (not (fboundp (intern "CLOSE-SOURCE" "SNOWGRAVE.SBCL"))))
  (assert (equal (funcall (snowgrave.artifact-tests:artifact-function metadata entry)) (list tag identity)))
  (assert (= (funcall (snowgrave.artifact-tests:artifact-function metadata metadata-entry)) 17))
  (format t "Fresh exported source and metadata symbols executed.~%"))
