(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-callable-key-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.CALLABLE-KEY.FIXTURE")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (load (compile-file source :output-file (merge-pathnames ".build/fresh-callable-key.fasl"
                                                        (asdf:system-source-directory "snowgrave"))))
  (let* ((unit (with-open-file (stream metadata) (read stream)))
         (entry (find-symbol "ENTRY" "SNOWGRAVE.CALLABLE-KEY.FIXTURE"))
         (events (find-symbol "*EVENTS*" "SNOWGRAVE.CALLABLE-KEY.FIXTURE")))
    (dolist (name '("LEFT" "RIGHT" "DEFAULT-FUNCTION" "INVOKE" "FIRST-ONLY" "OPTIONAL-KEY" "NAMED" "ENTRY"))
      (assert (not (fboundp (find-symbol name "SNOWGRAVE.CALLABLE-KEY.FIXTURE")))))
    (setf (symbol-value events) nil)
    (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function unit entry) 17))
                   '(((18 nil nil 0) (16 t nil 2) (18 t t 4) (16 t nil 4) (16 t nil 4)
                      (18 t nil 6) (16 t t 4) (18 t t 4) (18 nil nil 0) (16 t nil 2)
                      16 16 16 16)
                     (:fn :alias :alias :alias :alias :alias :fn :alias :key :alias))))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh keyword callable bindings executed.~%")
