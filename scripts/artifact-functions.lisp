(defpackage #:snowgrave.artifact-tests
  (:use #:cl)
  (:export #:artifact-function))
(in-package #:snowgrave.artifact-tests)

(defun artifact-function (metadata name)
  "Test-only installed code resolution from the readable ABI, without builder code."
  (labels ((matches (key)
             (if (stringp name)
                 (and (stringp (car key)) (string= name (second key)))
                 (equal key (snowgrave::function-name-key name))))
           (choose (records key-function)
             (let ((found (remove-if-not (lambda (record) (matches (funcall key-function record))) records)))
               (when (> (length found) 1) (error "Ambiguous artifact function: ~S." name))
               (car found)))
           (symbol-for (key)
             (if (eq (car key) 'setf) (list 'setf (symbol-for (cadr key)))
                 (or (find-symbol (second key) (first key)) (error "Missing code key: ~S." key)))))
    (let ((record (or (choose (getf metadata :entries)
                             (lambda (record) (snowgrave::function-name-key (getf record :name))))
                      (choose (getf metadata :definitions)
                              (lambda (record) (third (getf record :definition-key)))))))
      (unless record (error "Missing artifact function: ~S." name))
      (fdefinition (symbol-for (getf record :code-key))))))
