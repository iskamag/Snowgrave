(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-return-flow-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(load (compile-file (first (uiop:command-line-arguments))))
(let* ((metadata (with-open-file (stream (second (uiop:command-line-arguments))) (read stream)))
       (identity (getf metadata :identity))
       (package (find-package (format nil "SNOWGRAVE.UNIT.~A" (with-standard-io-syntax (write-to-string identity)))))
       (records
         (loop for name in '("FLOW-LEFT" "FLOW-RIGHT") for value in '(17 23)
               for description = (find name (getf metadata :record-layouts)
                                       :key (lambda (layout) (symbol-name (getf layout :class))) :test #'string=)
               for record = (snowgrave:sg-make-record
                             (snowgrave:make-layout (getf description :identity) (getf description :class)
                                                   (getf description :ancestors) (getf description :slots)
                                                   :error-mapping (getf description :error-mapping)))
               do (assert (not (find-class (getf description :class) nil)))
                  (snowgrave:sg-record-write record (intern "PAYLOAD" "SNOWGRAVE.FIXTURE") value)
               collect record)))
  (assert (not (fboundp (intern "FLOW-VALUE" "SNOWGRAVE.FIXTURE"))))
  (assert (not (fboundp (intern "CLOSE-SOURCE" "SNOWGRAVE.SBCL"))))
  (assert (eq (getf (getf metadata :ordinary-function-flow) :primary-return-method)
              :monotone-normal-and-explicit-escape-union))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "RETURN-ENTRY") (first records) 3)) '(20 17 3 17)))
  (assert (= (funcall (snowgrave.artifact-tests:artifact-function metadata "RETURN-UNION-ENTRY") (first records) (second records) nil) 23))
  (assert (= (funcall (snowgrave.artifact-tests:artifact-function metadata "RETURN-UNION-ENTRY") (first records) (second records) t) 17))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "RETURN-INDIRECT-ENTRY") (first records))) '(17 17)))
  (let ((values (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "RETURN-VALUES-ENTRY") (first records)))))
    (assert (eq (first values) (first records)))
    (assert (eq (second values) :secondary)))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "RETURN-METHOD-ENTRY") (first records) t)) '(17 :early)))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "RETURN-METHOD-ENTRY") (first records) nil)) '(17 :normal)))
  (assert (eq (funcall (snowgrave.artifact-tests:artifact-function metadata "RETURN-CYCLE-ENTRY") (first records) t) (first records)))
  (assert (= (funcall (snowgrave.artifact-tests:artifact-function metadata "RETURN-WRITE-ENTRY") (first records) 0) 0))
  (assert (= (snowgrave:sg-record-read (first records) (intern "PAYLOAD" "SNOWGRAVE.FIXTURE")) 0))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "RETURN-DOC-ENTRY"))) '("ordinary text" nil)))
  (format t "Fresh primary return flow executed.~%"))
