(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-predicate-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.PREDICATE.FIXTURE")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (sb-ext:without-package-locks
    (multiple-value-bind (artifact warnings failure)
        (compile-file source :output-file (merge-pathnames ".build/fresh-predicate.fasl" (asdf:system-source-directory "snowgrave")))
      (declare (ignore warnings)) (assert (not failure)) (load artifact)))
  (let* ((data (with-open-file (stream metadata) (read stream)))
         (base (funcall (snowgrave.artifact-tests:artifact-function data "BOOT")))
         (child (funcall (snowgrave.artifact-tests:artifact-function data "BOOT-CHILD")))
         (log (find-symbol "*LOG*" "SNOWGRAVE.PREDICATE.FIXTURE")))
    (dolist (expected (list base child))
      (dolist (held (list nil 17 :foreign :tag #\a (vector :native) base child))
        (let* ((owner (funcall (snowgrave.artifact-tests:artifact-function data "BOOT-CELL") held))
               (matches (eq expected held))
               (valid (member held (list base child))))
          (dolist (name '("GUARD-AND" "GUARD-IF" "GUARD-COND" "GUARD-WHEN" "GUARD-UNLESS" "GUARD-NULL" "GUARD-PARALLEL" "GUARD-METHOD"))
            (progv (list log) (list nil)
              (assert (eql matches (funcall (snowgrave.artifact-tests:artifact-function data name) owner expected)))
              (assert (equal '(:read) (symbol-value log)))))
          (assert (eql (not (null (or (not valid) matches)))
                       (funcall (snowgrave.artifact-tests:artifact-function data "GUARD-OR") owner expected)))
          (dolist (name '("USE-PACK" "USE-ESCAPE"))
            (assert (equal (if valid '(17 :box) '(nil :foreign))
                           (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function data name) owner)))))
          (assert (equal (append (make-list 4 :initial-element (eq held :tag))
                                (list (eql 17 held) (equal 17 held) (equalp 17 held)
                                      (eql #\a held) (equalp #\A held)))
                         (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function data "NATIVE-TAG") owner)))))))
    (progv (list log) (list nil)
      (assert (equal '(t (:object :environment))
                     (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function data "WITH-ENVIRONMENT") base)))))
    (assert (eq :custom (funcall (snowgrave.artifact-tests:artifact-function data "LOCAL-TYPEP") base)))
    (assert (not (find-class (find-symbol "BOX" "SNOWGRAVE.PREDICATE.FIXTURE") nil)))
    (assert (not (fboundp (find-symbol "GUARD-AND" "SNOWGRAVE.PREDICATE.FIXTURE"))))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh predicate guards executed.~%")
