(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-vector-constants-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.CONSTANTS.FIXTURE")))
(assert (not (find-package "SNOWGRAVE.VECTOR.ONLY")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (multiple-value-bind (artifact warnings failure)
      (compile-file source :output-file (merge-pathnames ".build/fresh-vector-constants.fasl" (asdf:system-source-directory "snowgrave")))
    (declare (ignore warnings)) (assert (not failure)) (load artifact))
  (let* ((unit (with-open-file (stream metadata) (read stream)))
         (record (funcall (snowgrave.artifact-tests:artifact-function unit "VECTOR-BOOT")))
         (a (funcall (snowgrave.artifact-tests:artifact-function unit "VECTOR-READ-ONE") record))
         (b (funcall (snowgrave.artifact-tests:artifact-function unit "VECTOR-READ-TWO") record))
         (graph (funcall (snowgrave.artifact-tests:artifact-function unit "VECTOR-READ-WHOLE") record)))
    (assert (equal '(3 t t) (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function unit "VECTOR-OBSERVE")))))
    (assert (simple-vector-p a)) (assert (eq a b))
    (assert (eq a (aref graph 0))) (assert (eq a (aref graph 1)))
    (assert (eq a (car (aref graph 2))))
    (assert (eq graph (funcall (snowgrave.artifact-tests:artifact-function unit "VECTOR-LEFT"))))
    (assert (eq :leaf (aref a 0)))
    (assert (eq (nth-value 1 (find-symbol "VECTOR-ONLY-TAG" "SNOWGRAVE.VECTOR.ONLY")) :external))
    (assert (eq (find-symbol "VECTOR-ONLY-TAG" "SNOWGRAVE.VECTOR.ONLY") (aref a 1)))
    (assert (not (find-class (find-symbol "CONSTANT-BOX" "SNOWGRAVE.CONSTANTS.FIXTURE") nil)))
    (assert (not (find-class (find-symbol "CONSTANT-CHILD" "SNOWGRAVE.CONSTANTS.FIXTURE") nil)))
    (assert (not (fboundp (find-symbol "VECTOR-LEFT" "SNOWGRAVE.CONSTANTS.FIXTURE"))))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh native vector constants executed.~%")
