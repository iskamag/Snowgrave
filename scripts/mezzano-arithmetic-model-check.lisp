;;;; Run only after the actual cross compiler/shared sources are loaded by the
;;;; access probe. This executes translated expansions on the host, not native
;;;; code, and does not establish target residency, allocation or lifetime.
(defvar *numeric-model-checks* 0)
(defvar *numeric-model-effects* nil)
(defvar *numeric-model-min* cross-cl:most-negative-fixnum)
(defvar *numeric-model-max* cross-cl:most-positive-fixnum)
(defvar *numeric-model-divisions* 0)
(defun numeric-model-fixnump (value)
  (and (integerp value) (<= *numeric-model-min* value *numeric-model-max*)))
(defun numeric-model-wrap (value)
  (+ *numeric-model-min* (mod (- value *numeric-model-min*)
                             (1+ (- *numeric-model-max* *numeric-model-min*)))))
(defun numeric-model-add (left right) (numeric-model-wrap (+ left right)))
(defun numeric-model-subtract (left right) (numeric-model-wrap (- left right)))
(defun numeric-model-product (left right) (numeric-model-wrap (* left right)))
(defun numeric-model-truncate (number divisor)
  ;; This models the raw native intrinsic, whose caller must exclude both
  ;; machine/boxing hazards. Count entries to prove rejected paths never use it.
  (assert (and (numeric-model-fixnump number) (numeric-model-fixnump divisor)
               (not (zerop divisor))
               (not (and (= number *numeric-model-min*) (= divisor -1)))))
  (incf *numeric-model-divisions*)
  (truncate number divisor))
(defun numeric-model-left-shift (value count) (numeric-model-wrap (ash value count)))
(defun numeric-model-right-shift (value count) (ash value (- count)))
(defun numeric-model-single-float-tag-p (value ignored-tag)
  (declare (ignore ignored-tag)) (typep value 'single-float))
(defun numeric-model-numeric-object-tag-p (value ignored-first ignored-last)
  (declare (ignore ignored-first ignored-last))
  (and (numberp value) (not (numeric-model-fixnump value))))
(defun numeric-model-alpha-form (form)
  ;; The real preexisting MIN/MAX compiler macro introduces fresh binders on
  ;; each expansion; structural equality must compare their binding identity.
  (let ((symbols (make-hash-table :test #'eq)) (next 0))
    (labels ((walk (form)
               (cond ((consp form) (cons (walk (car form)) (walk (cdr form))))
                     ((and (symbolp form) form (not (symbol-package form)))
                      (or (gethash form symbols)
                          (setf (gethash form symbols) (list :fresh (incf next)))))
                     (t form))))
      (walk form))))
(defun translate-numeric-expansion (form)
  (if (consp form)
      (mapcar #'translate-numeric-expansion form)
      (case form
        (cross-cl:most-negative-fixnum '*numeric-model-min*)
        (cross-cl:most-positive-fixnum '*numeric-model-max*)
        (mezzano.internals::fixnump 'numeric-model-fixnump)
        (mezzano.compiler::%fast-fixnum-+ 'numeric-model-add)
        (mezzano.compiler::%fast-fixnum-- 'numeric-model-subtract)
        (mezzano.compiler::%fast-fixnum-* 'numeric-model-product)
        (mezzano.compiler::%fast-fixnum-left-shift 'numeric-model-left-shift)
        (mezzano.runtime::%fixnum-right-shift 'numeric-model-right-shift)
        (mezzano.runtime::%fixnum-truncate 'numeric-model-truncate)
        (mezzano.runtime::%fixnum-< '<)
        (mezzano.runtime::%fixnum-logand 'logand)
        (mezzano.runtime::%fixnum-logior 'logior)
        (mezzano.runtime::%fixnum-logxor 'logxor)
        (mezzano.internals::%value-has-immediate-tag-p 'numeric-model-single-float-tag-p)
        (mezzano.internals::%object-of-type-range-p 'numeric-model-numeric-object-tag-p)
        ((mezzano.internals::+immediate-tag-single-float+
          mezzano.internals::+first-numeric-object-tag+
          mezzano.internals::+last-numeric-object-tag+) 0)
        (t form))))

(let* ((marker (find-symbol "%ADMITTED-ACCESS-SCOPE" "SNOWGRAVE.MEZZANO-ACCESS"))
       (failure '(return-from numeric-model-entry (values :rejected :numeric)))
       (environment (mezzano.compiler::extend-environment
                     nil :functions (list (list marker (lambda (form env)
                                                        (declare (ignore form env)) failure)))))
       (names '(+ - * truncate ash 1+ 1- < <= > >= = /= eql min max plusp minusp zerop
                logand logior logxor lognot evenp oddp))
       (originals (mapcar (lambda (name)
                           (gethash name snowgrave.mezzano-access::*original-arithmetic-compiler-macros*)) names)))
  ;; Reinstalling the extracted owner never captures one of its own wrappers.
  (snowgrave.mezzano-access::install-arithmetic-accessors)
  (assert (equal originals (mapcar (lambda (name)
                                    (gethash name snowgrave.mezzano-access::*original-arithmetic-compiler-macros*)) names)))
  (labels ((expansion (form) (funcall (cross-cl:compiler-macro-function (first form)) form environment))
           (worker (name count)
             (let ((variables (loop repeat count collect (gensym "NUMERIC-INPUT"))))
               (compile nil `(lambda ,variables
                               (block numeric-model-entry
                                 ,(translate-numeric-expansion (expansion `(,name ,@variables))))))))
           (check (worker arguments expected)
             (incf *numeric-model-checks*)
             (let ((actual (multiple-value-list (apply worker arguments))))
               (assert (equal actual expected) (actual arguments expected)
                       "Numeric expansion mismatch ~S for ~S, expected ~S" actual arguments expected)))
           (bounded (integer)
             (if (numeric-model-fixnump integer) (list integer) '(:rejected :numeric))))
    (dolist (name names)
      (let* ((form `(,name x y)) (macro (cross-cl:compiler-macro-function name))
             (original (gethash name snowgrave.mezzano-access::*original-arithmetic-compiler-macros*)))
        (assert (equal (numeric-model-alpha-form (funcall macro form nil))
                       (numeric-model-alpha-form (if original (funcall original form nil) form))))
        (assert (equal (mapcar #'second (second (expansion form))) '(x y)))))
    (let ((macro (cross-cl:compiler-macro-function '+)))
      (assert (equal (mapcar #'second
                            (second (funcall macro '(funcall (function +) (source-left) (source-right))
                                             environment)))
                     '((source-left) (source-right))))
      (assert (equal (funcall macro '(funcall dynamic (source-left)) environment)
                     '(funcall dynamic (source-left)))))
    (assert (= cross-cl:most-negative-fixnum (- (ash 1 62))))
    (assert (= cross-cl:most-positive-fixnum (1- (ash 1 62))))
    (let* ((values (remove-duplicates
                    (list *numeric-model-min* (1+ *numeric-model-min*)
                          (truncate *numeric-model-min* 2) (- (isqrt *numeric-model-max*))
                          -63 -32 -7 -2 -1 0 1 2 7 31 62
                          (isqrt *numeric-model-max*) (truncate *numeric-model-max* 2)
                          (1- *numeric-model-max*) *numeric-model-max*)))
           (add (worker '+ 2)) (subtract (worker '- 2)) (product (worker '* 2))
           (shift (worker 'ash 2)) (negate (worker '- 1))
           (divide (worker 'truncate 2)) (truncate-one (worker 'truncate 1)))
      ;; Six-bit exhaustive arithmetic checks the same sign/quadrant predicates
      ;; at every representable pair, with independent exact host arithmetic.
      (let ((*numeric-model-min* -32) (*numeric-model-max* 31))
        (loop for left from -32 to 31 do
          (loop for right from -32 to 31 do
            (check add (list left right) (bounded (+ left right)))
            (check subtract (list left right) (bounded (- left right)))
            (check product (list left right) (bounded (* left right)))
            (check divide (list left right)
                   (if (or (zerop right) (and (= left -32) (= right -1)))
                       '(:rejected :numeric) (multiple-value-list (truncate left right)))))))
      ;; Actual native 63-bit boundary values, including MIN/-1 and all signs.
      (dolist (left values)
        (check negate (list left) (bounded (- left)))
        (check truncate-one (list left) (list left 0))
        (dolist (right values)
          (check add (list left right) (bounded (+ left right)))
          (check subtract (list left right) (bounded (- left right)))
          (check product (list left right) (bounded (* left right)))
          (check divide (list left right)
                 (if (or (zerop right) (and (= left *numeric-model-min*) (= right -1)))
                     '(:rejected :numeric) (multiple-value-list (truncate left right)))))
        (dolist (count '(-4611686018427387904 -65 -64 -63 -62 -32 -1 0 1 31 61 62 63 64 65))
          ;; Do not construct the enormous ordinary shifted bignum for a huge
          ;; positive count. These tested positive counts are bounded at 65.
          (check shift (list left count)
                 (if (minusp count) (list (if (< count -63) (if (minusp left) -1 0) (ash left count)))
                     (bounded (ash left count))))))
      (dolist (bad '(1/2 1.0d0 :non-number #\a nil))
        (check truncate-one (list bad) '(:rejected :numeric))
        (dolist (function (list add subtract product shift divide))
          (check function (list bad 1) '(:rejected :numeric))
          (check function (list 1 bad) '(:rejected :numeric))))
      (check add (list (1+ *numeric-model-max*) 0) '(:rejected :numeric))
      (check add (list (1- *numeric-model-min*) 0) '(:rejected :numeric))
      (dolist (bad (list (1+ *numeric-model-max*) (1- *numeric-model-min*)))
        (check truncate-one (list bad) '(:rejected :numeric))
        (check divide (list bad 1) '(:rejected :numeric))
        (check divide (list 1 bad) '(:rejected :numeric))))
    (dolist (case '((+ 0 0) (* 0 1) (logand 0 -1) (logior 0 0) (logxor 0 0)))
      (check (worker (first case) (second case)) nil (list (third case))))
    (dolist (case '((- 0) (< 0) (<= 0) (> 0) (>= 0) (= 0) (/= 0) (min 0) (max 0)
                   (eql 1) (eql 3) (1+ 0) (1+ 2) (1- 0) (ash 1) (ash 3) (plusp 2)
                   (lognot 2) (evenp 0) (oddp 2) (truncate 0) (truncate 3)))
      (check (worker (first case) (second case)) (make-list (second case) :initial-element 1)
             '(:rejected :numeric)))
    (dolist (name '(< <= > >= = /= min max logand logior logxor))
      (let ((function (worker name 3)))
        (dolist (arguments '((-7 0 3) (3 3 3) (3 2 1) (3 1 3) (-1 -2 -3)))
          (check function arguments (list (apply name arguments))))))
    (dolist (name '(1+ 1- plusp minusp zerop lognot evenp oddp))
      (let ((function (worker name 1)))
        (dolist (argument '(-7 -1 0 1 7))
          (check function (list argument) (list (funcall name argument))))))
    (let ((eql-worker (worker 'eql 2)) (object (list :actual-identity)))
      (dolist (arguments (list (list object object) (list object (copy-list object))
                              '(nil nil) '(:a :a) '(:a :b) '(7 7) '(7 8) '(#\a #\a) '(#\a #\b)))
        (check eql-worker arguments (list (apply #'eql arguments))))
      (dolist (number (list 1.0 1.0d0 1/2 #C(1 1) (1+ *numeric-model-max*)))
        (check eql-worker (list number number) '(:rejected :numeric))))
    ;; Every original operand is evaluated exactly once, left to right, before
    ;; a predicate may short-circuit or an intermediate overflow may reject.
    (let ((effects-worker
            (compile nil
                     `(lambda (first second third)
                        (block numeric-model-entry
                          ,(translate-numeric-expansion
                            (expansion '(+ (progn (push :first *numeric-model-effects*) first)
                                           (progn (push :second *numeric-model-effects*) second)
                                           (progn (push :third *numeric-model-effects*) third)))))))))
      (setf *numeric-model-effects* nil)
      (check effects-worker (list *numeric-model-max* 1 -1) '(:rejected :numeric))
      (assert (equal *numeric-model-effects* '(:third :second :first))))
    (let ((function
            (compile nil
                     `(lambda (first second)
                        (block numeric-model-entry
                          ,(translate-numeric-expansion
                            (funcall (cross-cl:compiler-macro-function 'truncate)
                                     '(funcall (function truncate)
                                               (progn (push :first *numeric-model-effects*) first)
                                               (progn (push :second *numeric-model-effects*) second))
                                     environment)))))))
      (dolist (arguments (list '(7 -3) '(-7 3) '(7 0) (list *numeric-model-min* -1)
                              '(:not-a-number 0)))
        (let ((before *numeric-model-divisions*))
          (setf *numeric-model-effects* nil)
          (check function arguments
                 (if (and (every #'numeric-model-fixnump arguments)
                          (not (zerop (second arguments)))
                          (not (and (= (first arguments) *numeric-model-min*)
                                    (= (second arguments) -1))))
                     (multiple-value-list (apply #'truncate arguments)) '(:rejected :numeric)))
          (assert (equal *numeric-model-effects* '(:second :first)))
          (assert (= (- *numeric-model-divisions* before)
                     (if (member arguments '((7 -3) (-7 3)) :test #'equal) 1 0)))))))
  (format t "HOSTED-TRANSLATED-NUMERIC-EXPANSIONS: ~D DIFFERENTIAL CHECKS; NOT NATIVE EXECUTION~%"
          *numeric-model-checks*))
