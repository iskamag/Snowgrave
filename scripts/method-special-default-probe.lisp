(require :asdf)
(let* ((root (or (uiop:getenv "SNOWGRAVE_PROBE_SOURCE")
                 (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*))))
       (cache (or (uiop:getenv "SNOWGRAVE_PROBE_CACHE")
                  (merge-pathnames ".build/method-special-default-probe-fasl/" root))))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave/sbcl")
(defpackage #:snowgrave.method-special-default-probe (:use #:cl)
  (:shadowing-import-from #:snowgrave #:defclass #:defgeneric #:defmethod))
(let* ((*package* (find-package :snowgrave.method-special-default-probe))
       (baselinep (equal (uiop:command-line-arguments) '("baseline")))
       (class (intern "RECORD")) (generic (intern "VALUE")) (entry (intern "ENTRY")) (boot (intern "BOOT"))
       (forms (read-from-string
                "((defclass record () ()) (defparameter *seed* 7)
                   (defgeneric value (r &optional n))
                   (defmethod value ((r record) &optional (n (progn (incf *seed*) *seed*)))
                     (declare (ignore r)) (values n *seed*))
                   (defun boot () (make-instance 'record))
                   (defun entry (r flag) (let ((*seed* 19)) (if flag (value r 99) (value r)))))"))
       (unit nil) (refusal nil))
  ;; No original definitions/proclamations may hide a fresh compilation bug.
  (handler-case
      (setf unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(method-special-default-probe)
                   :closed-classes (list class) :closed-generics (list generic) :universe (list class)
                   :entries (list entry boot) :external-domains (list (list entry (list class t)) (list boot nil))))
    (snowgrave:snowgrave-error (condition) (setf refusal condition)))
  (dolist (form forms) (eval form))
  (let ((native (loop for flag in '(nil t) collect (multiple-value-list (funcall entry (funcall boot) flag)))))
    (format t "METHOD-SPECIAL-DEFAULT-NATIVE: ~S~%" native)
    (if baselinep
        (progn (assert (null unit)) (assert (eq (snowgrave:error-feature refusal) :compiler-failure))
               (format t "METHOD-SPECIAL-DEFAULT-REFUSAL: ~S/~S~%" (type-of refusal) (snowgrave:error-feature refusal)))
        (progn (when refusal (error refusal))
               (let ((closed (loop for flag in '(nil t) collect (multiple-value-list
                              (funcall (snowgrave:unit-function unit entry) (funcall (snowgrave:unit-function unit boot)) flag)))))
                 (assert (equal native closed)) (format t "METHOD-SPECIAL-DEFAULT-CLOSED: ~S~%" closed))))))
