(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-initialization-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(load (compile-file (first (uiop:command-line-arguments))))
(let* ((metadata (with-open-file (stream (second (uiop:command-line-arguments))) (read stream)))
       (identity (getf metadata :identity))
       (package (find-package (format nil "SNOWGRAVE.UNIT.~A" (with-standard-io-syntax (write-to-string identity)))))
       (record (funcall (snowgrave.artifact-tests:artifact-function metadata "AUTHORED-BOOT"))))
  (assert (not (find-class (intern "INIT-CHILD" :snowgrave.fixture) nil)))
  (assert (not (fboundp (intern "AUTHORED-BOOT" :snowgrave.fixture))))
  (dolist (operation '(initialize-instance shared-initialize))
    (assert (not (typep (snowgrave.artifact-tests:artifact-function metadata (symbol-name operation)) 'generic-function))))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "AUTHORED-STATE") record))
                 '(t nil t :before-b t :default nil)))
  (assert (eq record (funcall (snowgrave.artifact-tests:artifact-function metadata "AUTHORED-SHARED") record)))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "AUTHORED-STATE") record))
                 '(t 10 t :before-b t :default nil)))
  (assert (equal (multiple-value-list
                 (funcall (snowgrave.artifact-tests:artifact-function metadata "AUTHORED-STATE") (funcall (snowgrave.artifact-tests:artifact-function metadata "AUTHORED-BOOT-SKIP"))))
                 '(nil :unbound nil :unbound nil :unbound nil)))
  (format t "Fresh authored initialization executed.~%"))
