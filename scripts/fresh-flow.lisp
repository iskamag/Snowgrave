(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-flow-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(load (compile-file (first (uiop:command-line-arguments))))
(let* ((metadata (with-open-file (stream (second (uiop:command-line-arguments))) (read stream)))
       (identity (getf metadata :identity))
       (package (find-package (format nil "SNOWGRAVE.UNIT.~A" (with-standard-io-syntax (write-to-string identity)))))
       (description (find "FLOW-LEFT" (getf metadata :record-layouts)
                          :key (lambda (layout) (symbol-name (getf layout :class))) :test #'string=))
       (record (snowgrave:sg-make-record
                (snowgrave:make-layout (getf description :identity) (getf description :class)
                                      (getf description :ancestors) (getf description :slots)
                                      :error-mapping (getf description :error-mapping)))))
  (assert (not (find-class (getf description :class) nil)))
  (assert (not (fboundp (intern "FLOW-VALUE" "SNOWGRAVE.FIXTURE"))))
  (assert (not (fboundp (intern "CLOSE-SOURCE" "SNOWGRAVE.SBCL"))))
  (assert (eq (getf (getf metadata :ordinary-function-flow) :method) :finite-argument-binding-fixed-point))
  (snowgrave:sg-record-write record (intern "PAYLOAD" "SNOWGRAVE.FIXTURE") 17)
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "FLOW-ENTRY-LEFT") record 3)) '(20 17 17)))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "FLOW-FUNCALL-ENTRY") record 3)) '(20 :flow)))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "FLOW-APPLY-ENTRY") record 3)) '(20 :flow)))
  (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function metadata "FLOW-OPTIONAL-ENTRY") record 3)) '(20 5 nil :default)))
  (assert (= (funcall (snowgrave.artifact-tests:artifact-function metadata "FLOW-STORE-ENTRY") record 5) 5))
  (assert (= (snowgrave:sg-record-read record (intern "PAYLOAD" "SNOWGRAVE.FIXTURE")) 5))
  (assert (= (funcall (snowgrave.artifact-tests:artifact-function metadata "FLOW-INCREMENT-ENTRY") record 3) 8))
  (format t "Fresh helper domain flow executed.~%"))
