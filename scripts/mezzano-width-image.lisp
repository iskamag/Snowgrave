;;;; Own archived native source only: MAKE-IMAGE writes its cold build directory.
(load (merge-pathnames "mezzano-width-probe.lisp" *load-truename*))
(let* ((runtime-llf (merge-pathnames "width-runtime.llf" *probe-cache*))
       (loader (merge-pathnames "width-loader.lisp" *probe-cache*))
       (mezzano.compiler::*target-architecture* :x86-64)
       (cross-cl:*features* (cons :x86-64 cross-cl:*features*)))
  (mezzano.compiler::cross-compile-file
   (merge-pathnames "tests/mezzano-width-runtime.lisp" *source-root*)
   :output-file runtime-llf :verbose nil :print nil)
  (with-open-file (out loader :direction :output :if-exists :supersede)
    (write-line "(in-package :mezzano.internals)" out)
    (dolist (name '("scope" "entries" "records" "arrays" "arithmetic" "width-fixture" "width-runtime"))
      (let ((bytes (with-open-file (in (merge-pathnames (format nil "~A.llf" name) *probe-cache*)
                                      :element-type '(unsigned-byte 8))
                     (let ((data (make-array (file-length in) :element-type '(unsigned-byte 8))))
                       (assert (= (read-sequence data in) (length data))) data))))
        (let ((*print-readably* t) (*print-length* nil) (*print-level* nil))
          (format out "(load-llf (mini-vector-stream ~S) t)~%" (coerce bytes 'simple-vector)))))
    (write-line "(snowgrave.mezzano-width-fixture:run)" out))
  (let ((cold-generator::*warm-source-files*
          (append (remove "ipl.lisp" cold-generator::*warm-source-files* :test #'equal)
                  (list (namestring loader))))
        (*default-pathname-defaults* *native-source*))
    (cold-generator::make-image (merge-pathnames "width-image" *probe-cache*)
                               :image-size (* 5 1024 1024 1024)
                               :header-path (merge-pathnames "tools/disk-header.bin" *native-source*))
    (format t "SNOWGRAVE-WIDTH-PRIVATE-IMAGE-BUILT~%")))
