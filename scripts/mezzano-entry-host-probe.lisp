;;;; Ordinary-host negative control; no native feature or core/builder dependency.
(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/entry-host-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration))
  (load (merge-pathnames "adapters/mezzano-access/scope.lisp" root))
  (load (merge-pathnames "adapters/mezzano-access/entries.lisp" root)))
(assert (not (member :mezzano *features*)))
(assert (not (find-package "WONDERWORLD")))
(assert (not (find-package "THREST")))
(defvar *entry-effects* nil)
(snowgrave.mezzano-access:define-admitted-entry host-entry
    (x &optional (y (progn (push :default-y *entry-effects*) x) yp)
                  (z (progn (push :default-z *entry-effects*) y) zp))
    (values nil :bounded-failure)
  "Ordinary host entry."
  (declare (type fixnum x))
  (values x y yp z zp))
(assert (equal (documentation 'host-entry 'function) "Ordinary host entry."))
(assert (equal (multiple-value-list (host-entry 7)) '(7 7 nil 7 nil)))
(assert (equal *entry-effects* '(:default-z :default-y)))
(setf *entry-effects* nil)
(assert (equal (multiple-value-list (host-entry 7 nil nil)) '(7 nil t nil t)))
(assert (null *entry-effects*))
(flet ((ordinary-count-error-p (arguments)
         (handler-case (progn (apply 'host-entry arguments) nil) (program-error () t))))
  (assert (ordinary-count-error-p nil))
  (assert (ordinary-count-error-p '(1 2 3 4)))
  (assert (null *entry-effects*)))
(let ((seen nil))
  (assert (= 12 (snowgrave.mezzano-access:call-admitted-entry
                (progn (push :function seen) #'+)
                (progn (push :first seen) 5)
                (progn (push :second seen) 7))))
  (assert (equal seen '(:second :first :function))))
(assert (equal '(funcall fn x)
               (macroexpand-1 '(snowgrave.mezzano-access:call-admitted-entry fn x))))
(assert (handler-case (progn (snowgrave.mezzano-access:call-admitted-entry 17 1) nil) (type-error () t)))
(let ((entry (snowgrave.mezzano-access:admitted-lambda
                 (x &optional (y (progn (push :anonymous-default *entry-effects*) x) yp))
                 (values nil :bounded-failure)
               "Anonymous entry documentation."
               (declare (type fixnum x))
               (values x y yp))))
  (setf *entry-effects* nil)
  (assert (equal (multiple-value-list (funcall entry 7)) '(7 7 nil)))
  (assert (equal *entry-effects* '(:anonymous-default)))
  (setf *entry-effects* nil)
  (assert (equal (multiple-value-list (funcall entry 7 nil)) '(7 nil t)))
  (assert (null *entry-effects*))
  (dolist (arguments '(nil (1 2 3)))
    (assert (handler-case (progn (apply entry arguments) nil) (program-error () t))))
  (assert (null *entry-effects*)))
;; A private block must preserve this existing outer RETURN binding.
(assert (eq :outer-return
            (block nil
              (funcall (snowgrave.mezzano-access:admitted-lambda () (values nil :failed)
                         (return :outer-return)))
              :incorrect-fallthrough)))
(let* ((expansion (macroexpand-1 '(snowgrave.mezzano-access:admitted-lambda (x) (values nil :failed) x)))
       (lambda (second expansion)) (block (car (last lambda))))
  (assert (eq (first expansion) 'function))
  (assert (eq (first lambda) 'lambda))
  (assert (equal (second lambda) '(x)))
  (assert (eq (first block) 'block))
  (assert (and (symbolp (second block)) (second block) (not (symbol-package (second block))))))
(format t "ORDINARY-HOST-SHARED-ENTRY-PASSED~%")
