(require :asdf)
(let* ((root (or (uiop:getenv "SNOWGRAVE_PROBE_SOURCE")
                 (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*))))
       (cache (or (uiop:getenv "SNOWGRAVE_PROBE_CACHE")
                  (merge-pathnames ".build/conditional-values-probe-fasl/" root))))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave/sbcl")
(defpackage #:snowgrave.conditional-values-probe (:use #:cl)
  (:shadowing-import-from #:snowgrave #:defclass #:defgeneric #:defmethod))
(let* ((*package* (find-package :snowgrave.conditional-values-probe))
       (baselinep (equal (uiop:command-line-arguments) '("baseline")))
       (record (intern "RECORD")) (pack (intern "PACK")) (amount (intern "AMOUNT"))
       (entry (intern "ENTRY")) (boot (intern "BOOT")) (trace (intern "*TRACE*"))
       (forms (read-from-string
               "((defclass record () ((payload :initarg :payload))) (defparameter *trace* nil)
                  (defgeneric amount (r n))
                  (defmethod amount ((r record) (n number)) (values (+ (slot-value r 'payload) n) :amount))
                  (defgeneric pack (r n))
                  (defmethod pack ((r record) (n number))
                    (cond ((progn (push :negative-test *trace*) (minusp n))
                           (push :negative *trace*) (values :negative r #'amount))
                          ((progn (push :zero-test *trace*) (zerop n))
                           (push :zero *trace*) (values :zero r #'amount))
                          (t (push :positive *trace*) (values :positive r #'amount))))
                  (defun boot () (make-instance 'record :payload 17))
                  (defun entry (r n)
                    (multiple-value-bind (tag object callback) (pack r n)
                      (values (slot-value object 'payload) (funcall callback object n) tag))))")))
  (dolist (form forms) (eval form))
  (let ((native (loop for n in '(-2 0 7) collect
                 (progn (setf (symbol-value trace) nil)
                        (list (multiple-value-list (funcall entry (funcall boot) n))
                              (reverse (symbol-value trace)))))))
    (format t "CONDITIONAL-VALUES-NATIVE: ~S~%" native)
    (handler-case
        (let ((unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(conditional-values-probe)
                      :closed-classes (list record) :closed-generics (list pack amount)
                      :universe (list record 'number) :entries (list entry boot)
                      :external-domains (list (list entry (list record 'number)) (list boot nil)))))
          (assert (not baselinep))
          (let ((closed (loop for n in '(-2 0 7) collect
                         (progn (setf (symbol-value trace) nil)
                                (list (multiple-value-list (funcall (snowgrave:unit-function unit entry)
                                                                   (funcall (snowgrave:unit-function unit boot)) n))
                                      (reverse (symbol-value trace)))))))
            (assert (equal native closed)) (format t "CONDITIONAL-VALUES-CLOSED: ~S~%" closed)))
      (snowgrave:snowgrave-error (condition)
        (assert baselinep)
        (assert (member (snowgrave:error-feature condition) '(:computed-function :record-slot-domain)))
        (format t "CONDITIONAL-VALUES-REFUSAL: ~S/~S~%" (type-of condition) (snowgrave:error-feature condition))))))
