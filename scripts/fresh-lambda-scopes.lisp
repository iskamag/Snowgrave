(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-lambda-scopes-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.LAMBDA-SCOPE.FIXTURE")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (load (compile-file source :output-file (merge-pathnames ".build/fresh-lambda-scopes.fasl" (asdf:system-source-directory "snowgrave"))))
  (let ((unit (with-open-file (stream metadata) (read stream))))
    (dolist (name '("LAMBDA-ENTRY" "KEY-ENTRY" "LOCAL-ENTRY" "LABELS-ENTRY" "AUX-ENTRY"))
      (let ((original (find-symbol name "SNOWGRAVE.LAMBDA-SCOPE.FIXTURE")))
        (assert (not (fboundp original)))
        (assert (equal (funcall (snowgrave.artifact-tests:artifact-function unit original) 7) '(:closed 7)))))
    (assert (= (funcall (snowgrave.artifact-tests:artifact-function unit "ORDERED-ENTRY") 7) 9))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh lambda initializer scopes executed.~%")
