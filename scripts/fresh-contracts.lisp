(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-contracts-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(load (compile-file (first (uiop:command-line-arguments))))
(let* ((metadata (with-open-file (stream (second (uiop:command-line-arguments))) (read stream)))
       (identity (getf metadata :identity))
       (package (find-package (format nil "SNOWGRAVE.UNIT.~A" (with-standard-io-syntax (write-to-string identity)))))
       (description (find "ARGUMENT-FAST" (getf metadata :record-layouts)
                          :key (lambda (layout) (symbol-name (getf layout :class))) :test #'string=))
       (record (snowgrave:sg-make-record
                (snowgrave:make-layout (getf description :identity) (getf description :class)
                                      (getf description :ancestors) (getf description :slots)
                                        :error-mapping (getf description :error-mapping)))))
  (assert (not (find-class (getf description :class) nil)))
  (assert (not (fboundp (intern "KEYWORD-CALL" :snowgrave.fixture))))
  (assert (not (typep (snowgrave.artifact-tests:artifact-function metadata "KEYWORD-CALL") 'generic-function)))
  (assert (equal (subseq (multiple-value-list
                         (funcall (snowgrave.artifact-tests:artifact-function metadata "KEYWORD-ENTRY") record 2 :named 8 :fast 7)) 0 5)
                 '(2 t 8 t (:named 8 :fast 7))))
  (assert (handler-case (progn (funcall (snowgrave.artifact-tests:artifact-function metadata "KEYWORD-ENTRY") record 2 :unknown 1) nil)
            (sb-ext:unknown-keyword-argument () t)))
  (assert (handler-case (progn (funcall (snowgrave.artifact-tests:artifact-function metadata "KEYWORD-ENTRY") record 2 :named) nil)
            (sb-int:simple-program-error () t)))
  (format t "Fresh argument contracts executed.~%"))
