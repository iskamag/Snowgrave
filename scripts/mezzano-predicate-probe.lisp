(require :asdf)
(defun required-directory (name)
  (uiop:ensure-directory-pathname (or (uiop:getenv name) (error "Set ~A." name))))
(defparameter *native-source* (required-directory "SNOWGRAVE_MEZZANO_SOURCE"))
(defparameter *native-deps* (required-directory "SNOWGRAVE_MEZZANO_DEPS"))
(defparameter *native-iterate* (required-directory "SNOWGRAVE_MEZZANO_ITERATE"))
(defparameter *native-nibbles* (required-directory "SNOWGRAVE_MEZZANO_NIBBLES"))
(defparameter *probe-cache* (uiop:ensure-directory-pathname
                          (or (uiop:getenv "SNOWGRAVE_MEZZANO_CACHE") "/tmp/snowgrave-mezzano-predicate-cache/")))
(defparameter *source-root* (uiop:pathname-parent-directory-pathname
                           (uiop:pathname-directory-pathname *load-truename*)))
(asdf:initialize-source-registry
 `(:source-registry (:directory ,*native-source*) (:directory ,*native-nibbles*) (:directory ,*native-iterate*)
   ,@(mapcar (lambda (name) `(:directory ,(merge-pathnames name *native-deps*)))
             '("cl-ppcre/" "alexandria/" "closer-mop/" "trivial-gray-streams/")) :ignore-inherited-configuration))
(asdf:initialize-output-translations
 `(:output-translations (t (,(namestring (merge-pathnames "asdf-tree/" *probe-cache*)) :implementation))
   :ignore-inherited-configuration))
(asdf:load-system "lispos")
(let ((*default-pathname-defaults* *native-source*) (*compile-verbose* nil) (*compile-print* nil))
  (cold-generator:set-up-cross-compiler :architecture :x86-64))
(assert (not (find-package "WONDERWORLD")))
(assert (not (find-package "THREST")))
(dolist (name '("scope" "entries" "records" "arrays" "arithmetic"))
  (mezzano.compiler::load-for-cross-compiler
   (merge-pathnames (format nil "adapters/mezzano-access/~A.lisp" name) *source-root*) :verbose nil :print nil))
(mezzano.compiler::load-for-cross-compiler
 (merge-pathnames "tests/mezzano-predicate-fixture.lisp" *source-root*) :verbose nil :print nil)
(defun fixture-symbol (name) (find-symbol name "SNOWGRAVE.MEZZANO-PREDICATE-FIXTURE"))

(defvar *predicate-checks* 0)
(defvar *predicate-effects* nil)
(defun check (actual expected)
  (incf *predicate-checks*) (assert (equal actual expected)))
(defun model-tag-p (object ignored-tag) (declare (ignore ignored-tag))
  (and (consp object) (eq (car object) :native-object)))
(defun model-layout-eq-p (object header)
  ;; Relocation wraps the same actual native layout in distinct cold headers.
  (and (mezzano.internals::instance-header-p (second object))
       (eq (mezzano.runtime::%unpack-instance-header (second object))
           (mezzano.runtime::%unpack-instance-header header))))
(defun model-effect (object) (push :receiver *predicate-effects*) object)
(defun translate-expansion (form)
  (cond ((and (consp form) (eq (car form) 'quote)) form)
        ((consp form) (mapcar #'translate-expansion form))
        (t (case form
             (mezzano.internals::%value-has-tag-p 'model-tag-p)
             (mezzano.internals::%fast-instance-layout-eq-p 'model-layout-eq-p)
             (mezzano.internals::+tag-object+ 0)
             (t form)))))
(let* ((marker (find-symbol "%ADMITTED-ACCESS-SCOPE" "SNOWGRAVE.MEZZANO-ACCESS"))
       (environment (mezzano.compiler::extend-environment
                     nil :functions (list (list marker (lambda (form env)
                      (declare (ignore form env)) '(error "Predicate must not execute access failure.")))))))
  (labels ((rejected-p (record predicate)
             (handler-case (progn (snowgrave.mezzano-access::install-record-predicate record predicate) nil)
               (error () t)))
           (header (record)
             (mezzano.runtime::%make-instance-header
              (mezzano.clos:class-layout (mezzano.internals::get-structure-type record)))))
    (check (rejected-p (fixture-symbol "BASE") (fixture-symbol "BASE-P")) t)
    (check (rejected-p (fixture-symbol "EFFECTFUL") (fixture-symbol "EFFECTFUL-P")) t)
    (check (rejected-p (fixture-symbol "ENTITY") (fixture-symbol "WRONG-P")) t)
    (check (rejected-p (fixture-symbol "ENTITY") (fixture-symbol "FOREIGN-P")) t)
    (check (rejected-p (fixture-symbol "ENTITY") nil) t)
    (check (handler-case
               (progn (funcall (cross-cl:compiler-macro-function (fixture-symbol "REBOUND-P"))
                               `(,(fixture-symbol "REBOUND-P") object) environment) nil)
             (error () t)) t)
    (dolist (pair '(("ENTITY" "ENTITY-P") ("CHILD" "CHILD-P") ("NAMED" "ACTUAL-NAMED-P")))
      (let* ((record (fixture-symbol (first pair))) (predicate (fixture-symbol (second pair)))
             (original (gethash predicate snowgrave.mezzano-access::*original-record-compiler-macros*))
             (h (header record)) (object (list :native-object h :corrupt-typed-slot)))
        ;; Re-registration preserves the preexisting outside-scope macro.
        (snowgrave.mezzano-access::install-record-predicate record predicate)
        (check (eq (gethash predicate snowgrave.mezzano-access::*original-record-compiler-macros*) original) t)
        (dolist (call (list `(,predicate object) `(funcall (function ,predicate) object)
                           `(funcall (quote ,predicate) object)))
          (let* ((macro (cross-cl:compiler-macro-function predicate))
                 (expansion (funcall macro call environment))
                 (worker (compile nil `(lambda (object) ,(translate-expansion expansion)))))
            (check (funcall macro call nil) (if original (funcall original call nil) call))
            (dolist (value (list object (list :native-object h nil) nil t 0 17 #\a "x" '(ordinary cons)
                                 (list :native-object (header (fixture-symbol "FOREIGN")) nil)
                                 (list :native-object (header (fixture-symbol "BASE")) nil)))
              (check (multiple-value-list (funcall worker value))
                     (list (not (null (and (model-tag-p value 0) (model-layout-eq-p value h)))))))
            ;; Unsupported arity/syntax remains an ordinary call.
            (dolist (bad (list `(,predicate) `(,predicate object extra)))
              (check (funcall macro bad environment) bad))))
        (let* ((call `(,predicate (model-effect object)))
               (worker (compile nil `(lambda (object)
                          ,(translate-expansion (funcall (cross-cl:compiler-macro-function predicate) call environment))))))
          (dolist (value (list object nil (list :native-object (header (fixture-symbol "BASE")) nil)))
            (setf *predicate-effects* nil)
            (check (funcall worker value) (not (null (and (model-tag-p value 0) (model-layout-eq-p value h)))))
            (check *predicate-effects* '(:receiver))))))))

(defun emitted-worker (assembly name)
  (let* ((start (or (search (format nil "~%~A:~%" name) assembly) (error "Missing worker ~A" name)))
         (end (or (search "MEZZANO.COMPILER.BACKEND.X86-64::LITERAL-POOL/128" assembly :start2 start) (length assembly))))
    (subseq assembly start end)))
(let ((mezzano.compiler::*target-architecture* :x86-64)
      (cross-cl:*features* (cons :x86-64 cross-cl:*features*)))
  (dolist (name '("scope" "records"))
    (let ((output (merge-pathnames (make-pathname :name name :type "llf") *probe-cache*)))
      (mezzano.compiler::cross-compile-file
       (merge-pathnames (format nil "adapters/mezzano-access/~A.lisp" name) *source-root*)
       :output-file output :verbose nil :print nil)
      (with-open-file (stream output :element-type '(unsigned-byte 8))
        (mezzano.cold-generator.load:validate-llf-header stream :x86-64))))
  (let* ((output (merge-pathnames "predicate-fixture.llf" *probe-cache*))
       (assembly (with-output-to-string (stream)
                   (let ((*standard-output* stream) (mezzano.compiler::*trace-asm* t))
                     (mezzano.compiler::cross-compile-file
                      (merge-pathnames "tests/mezzano-predicate-fixture.lisp" *source-root*)
                      :output-file output :verbose nil :print nil)))))
  (with-open-file (stream output :element-type '(unsigned-byte 8))
    (mezzano.cold-generator.load:validate-llf-header stream :x86-64))
  (with-open-file (stream (merge-pathnames "predicate-fixture.lap" *probe-cache*)
                          :direction :output :if-exists :supersede) (write-string assembly stream))
  (dolist (name '("BOUNDED-ENTITY-P" "BOUNDED-CHILD-P" "BOUNDED-NAMED-P" "BOUNDED-FUNCALL-P" "BOUNDED-LOCAL-P"))
    (let ((code (emitted-worker assembly name)))
      (dolist (bad '(":CALL" ":NAMED-CALL")) (assert (not (search bad code))))
      (dolist (bad '("ALLOCATE" "STRUCTURE-TYPE-P" "%STRUCT-SLOT" "TYPEP"))
        (assert (not (search bad code))))
      (format t "~A: NO-CALL/NO-NAMED-CALL/NO-TYPE-REPAIR/NO-ALLOCATOR~%" name)))
  ;; Ordinary/notinline semantics remain actual ordinary calls with their own
  ;; argument handling. An unsealed parent still accepts real descendants.
  (assert (search "RAISE-INVALID-ARGUMENT-ERROR" (emitted-worker assembly "ORDINARY-ENTITY-P")))
  (assert (search "STRUCTURE-TYPE-P" (emitted-worker assembly "ORDINARY-BASE-P")))
  (assert (search ":NAMED-CALL" (emitted-worker assembly "BOUNDED-NOTINLINE-P")))
  (assert (search "ENTITY-P" (emitted-worker assembly "BOUNDED-NOTINLINE-P")))))
(format t "~D ACTUAL-COLD-PREDICATE-EXPANSION-CHECKS; NOT NATIVE EXECUTION~%" *predicate-checks*)
(format t "ACTUAL-NATIVE-SHARED-PREDICATE-CROSS-COMPILE-PASSED~%")
