;;;; Execute the actual cold record expansions on modeled storage. This is
;;;; guard/ordering evidence, not native execution, residency or allocation.
(defvar *record-domain-model-checks* 0)
(defvar *record-domain-model-effects* nil)
(defun record-domain-model-tag-p (object ignored-tag)
  (declare (ignore ignored-tag)) (consp object))
(defun record-domain-model-header-p (object header)
  ;; The cross compiler wraps one actual layout in fresh cold header objects;
  ;; the native relocation represents the same layout/header word each time.
  (and (mezzano.internals::instance-header-p (car object))
       (eq (mezzano.runtime::%unpack-instance-header (car object))
           (mezzano.runtime::%unpack-instance-header header))))
(defun record-domain-model-ref (object index) (aref (cdr object) index))
(defun (setf record-domain-model-ref) (value object index)
  (setf (aref (cdr object) index) value))
(defun record-domain-model-cas (object index old new)
  (let ((actual (record-domain-model-ref object index)))
    (when (eq actual old) (setf (record-domain-model-ref object index) new))
    (values (eq actual old) actual)))
(defun record-domain-model-effect (tag value)
  (push tag *record-domain-model-effects*) value)
(defun translate-record-domain-expansion (form)
  (cond ((and (consp form) (eq (car form) 'quote)) form)
        ((consp form) (mapcar #'translate-record-domain-expansion form))
        (t (case form
             (mezzano.internals::%value-has-tag-p 'record-domain-model-tag-p)
             (mezzano.internals::%fast-instance-layout-eq-p 'record-domain-model-header-p)
             (mezzano.internals::%object-ref-t 'record-domain-model-ref)
             (mezzano.internals::%cas-object 'record-domain-model-cas)
             (mezzano.internals::+tag-object+ 0)
             (t form)))))

(let* ((marker (find-symbol "%ADMITTED-ACCESS-SCOPE" "SNOWGRAVE.MEZZANO-ACCESS"))
       (failure '(return-from record-domain-model-entry (values nil :invalid-record)))
       (environment (mezzano.compiler::extend-environment
                     nil :functions (list (list marker (lambda (form env)
                                                        (declare (ignore form env)) failure))))))
  (labels ((check (actual expected)
             (incf *record-domain-model-checks*) (assert (equal actual expected)))
           (expand (name arguments)
             (funcall (cross-cl:compiler-macro-function name) `(,name ,@arguments) environment))
           (worker (name variables)
             (compile nil `(lambda ,variables
                             (block record-domain-model-entry
                               ,(translate-record-domain-expansion (expand name variables)))))))
    ;; Proper, immutable finite domains only. No cyclic printing or numeric
    ;; coercion can turn unsupported declarations into guessed type answers.
    (dolist (type '(t fixnum (member :a 0 :b) (eql :a) (eql 0)))
      (assert (nth-value 1 (snowgrave.mezzano-access::record-slot-domain type))))
    (dolist (type '(nil integer (member) (member :a 1) (member :a nil)
                   (member :a #\a) (eql :a :b) (eql) (eql "a") (member . :a)))
      (assert (not (nth-value 1 (snowgrave.mezzano-access::record-slot-domain type)))))
    (let ((type (list 'member :a)))
      (let ((domain (snowgrave.mezzano-access::record-slot-domain type)))
        (setf (second type) :b) (check domain '(member :a)))
      (setf (cdr type) type)
      (assert (not (nth-value 1 (snowgrave.mezzano-access::record-slot-domain type)))))
    (dolist (definition
             `((,(fixture-symbol "FINITE-DOMAIN") ,(fixture-symbol "STATE") ,(fixture-symbol "FINITE-DOMAIN-STATE"))
               (,(fixture-symbol "FINITE-DOMAIN") ,(fixture-symbol "PRIORITY") ,(fixture-symbol "FINITE-DOMAIN-PRIORITY"))
               (,(fixture-symbol "FINITE-DOMAIN") ,(fixture-symbol "SINGLE") ,(fixture-symbol "FINITE-DOMAIN-SINGLE"))
               (mezzano.supervisor::thread mezzano.supervisor::state mezzano.supervisor::thread-state)
               (mezzano.supervisor::thread mezzano.supervisor::priority mezzano.supervisor::thread-priority)))
      (destructuring-bind (record slot-name accessor) definition
        (let* ((class (mezzano.internals::get-structure-type record))
               (slot (find slot-name (mezzano.clos:class-slots class) :key #'mezzano.clos:slot-definition-name))
               (domain (snowgrave.mezzano-access::record-slot-domain (mezzano.clos:slot-definition-type slot)))
               (values (cdr domain)) (first (car values)) (last (car (last values)))
               (header (mezzano.runtime::%make-instance-header (mezzano.clos:class-layout class)))
               (index (mezzano.runtime::location-offset-t (mezzano.clos:slot-definition-location slot)))
               (object (cons header (make-array (1+ index) :initial-element nil)))
               (read (worker accessor '(object)))
               (write (worker `(setf ,accessor) '(value object)))
               (cas (worker `(mezzano.internals::cas ,accessor) '(old new object))))
          (assert (eq (car domain) 'member))
          (assert (eql (mezzano.runtime::location-type (mezzano.clos:slot-definition-location slot))
                       mezzano.runtime::+location-type-t+))
          (dolist (operation (list accessor `(setf ,accessor) `(mezzano.internals::cas ,accessor)))
            (let* ((macro (cross-cl:compiler-macro-function operation))
                   (arguments (case (if (consp operation) (car operation) :read)
                                (setf '(value object)) (mezzano.internals::cas '(old new object)) (t '(object))))
                   (form `(,operation ,@arguments))
                   (original (gethash operation snowgrave.mezzano-access::*original-record-compiler-macros*)))
              (check (funcall macro form nil) (if original (funcall original form nil) form))))
          (dolist (value values)
            (setf (record-domain-model-ref object index) value)
            (check (multiple-value-list (funcall read object)) (list value))
            (check (multiple-value-list (funcall write value object)) (list value))
            (check (multiple-value-list (funcall cas value first object)) (list value))
            (check (record-domain-model-ref object index) first))
          (dolist (actual values)
            (dolist (old values)
              (dolist (new values)
                (setf (record-domain-model-ref object index) actual)
                (check (multiple-value-list (funcall cas old new object)) (list actual))
                (check (record-domain-model-ref object index) (if (eq actual old) new actual)))))
          (dolist (invalid '(nil t :foreign 1 -1 1.0d0 #\a "active"))
            (setf (record-domain-model-ref object index) first)
            (check (multiple-value-list (funcall write invalid object)) '(nil :invalid-record))
            (check (record-domain-model-ref object index) first)
            (check (multiple-value-list (funcall cas invalid last object)) '(nil :invalid-record))
            (check (multiple-value-list (funcall cas first invalid object)) '(nil :invalid-record))
            (check (record-domain-model-ref object index) first)
            (setf (record-domain-model-ref object index) invalid)
            (check (multiple-value-list (funcall read object)) '(nil :invalid-record))
            (check (multiple-value-list (funcall cas first last object)) '(nil :invalid-record))
            (check (record-domain-model-ref object index) invalid))
          (dolist (foreign (list nil 17 (cons :foreign (make-array (1+ index)))))
            (check (multiple-value-list (funcall read foreign)) '(nil :invalid-record))
            (check (multiple-value-list (funcall write first foreign)) '(nil :invalid-record))
            (check (multiple-value-list (funcall cas first last foreign)) '(nil :invalid-record)))
          ;; Guard failure follows argument effects, in the actual native
          ;; functional writer/CAS ABI order, each receiver/value evaluated once.
          (let ((writer (compile nil `(lambda (object)
                                       (block record-domain-model-entry
                                         ,(translate-record-domain-expansion
                                           (expand `(setf ,accessor)
                                                   '((record-domain-model-effect :value :foreign)
                                                     (record-domain-model-effect :receiver object))))))))
                (cas (compile nil `(lambda (object)
                                    (block record-domain-model-entry
                                      ,(translate-record-domain-expansion
                                        (expand `(mezzano.internals::cas ,accessor)
                                                '((record-domain-model-effect :old :foreign)
                                                  (record-domain-model-effect :new :foreign)
                                                  (record-domain-model-effect :receiver object)))))))))
            (setf *record-domain-model-effects* nil)
            (check (multiple-value-list (funcall writer object)) '(nil :invalid-record))
            (check (reverse *record-domain-model-effects*) '(:value :receiver))
            (setf *record-domain-model-effects* nil)
            (check (multiple-value-list (funcall cas object)) '(nil :invalid-record))
            (check (reverse *record-domain-model-effects*) '(:old :new :receiver)))
          (format t "~A.~A: ACTUAL-FINALIZED-FINITE-DOMAIN ~S~%" record slot-name domain))))
    (format t "~D HOSTED-ACTUAL-NATIVE-RECORD-DOMAIN-EXPANSION-CHECKS-PASSED; NOT NATIVE EXECUTION~%"
            *record-domain-model-checks*)))
