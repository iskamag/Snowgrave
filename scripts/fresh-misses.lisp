(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-misses-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(load (compile-file (first (uiop:command-line-arguments))))
(let* ((metadata (with-open-file (stream (second (uiop:command-line-arguments))) (read stream)))
       (identity (getf metadata :identity))
       (package (find-package (format nil "SNOWGRAVE.UNIT.~A" (with-standard-io-syntax (write-to-string identity)))))
       (retry-seen nil))
  (assert (not (fboundp (intern "MISS-ONLY" :snowgrave.fixture))))
  (assert (handler-case
              (handler-bind ((sb-pcl::no-applicable-method-error
                               (lambda (condition)
                                 (setf retry-seen (not (null (find-restart 'sb-ext:retry condition)))))))
                (funcall (snowgrave.artifact-tests:artifact-function metadata "MISS-ENTRY") :outside))
            (sb-pcl::no-applicable-method-error (condition)
              (and (equal (slot-value condition 'sb-pcl::args) '(:outside))
                   (not (typep (slot-value condition 'generic-function) 'generic-function))))))
  (assert retry-seen)
  (assert (handler-case (funcall (snowgrave.artifact-tests:artifact-function metadata "NEXT-ENTRY") 1)
            (sb-pcl::no-next-method-error (condition)
              (and (consp (slot-value condition 'method))
                   (equal (slot-value condition 'sb-pcl::args) '(1))))))
  (format t "Fresh miss materialization executed.~%"))
