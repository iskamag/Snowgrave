(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-minimum-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(load (compile-file (first (uiop:command-line-arguments))))
(let* ((metadata (with-open-file (stream (second (uiop:command-line-arguments))) (read stream)))
       (identity (getf metadata :identity))
       (package (find-package (format nil "SNOWGRAVE.UNIT.~A" (with-standard-io-syntax (write-to-string identity)))))
       (function (funcall (snowgrave.artifact-tests:artifact-function metadata "MIN-FIXED-FUNCTION"))))
  (assert (not (fboundp (intern "MIN-FIXED" :snowgrave.fixture))))
  (assert (not (typep function 'generic-function)))
  (assert (handler-case (funcall (snowgrave.artifact-tests:artifact-function metadata "MIN-FIXED-ZERO"))
            (sb-int:simple-program-error (condition)
              (equal (simple-condition-format-arguments condition) (list function 2)))))
  (assert (equal (multiple-value-list (funcall function 1 2)) '(1 2)))
  (assert (handler-case (funcall (snowgrave.artifact-tests:artifact-function metadata "MIN-FIXED-ONE") :outside)
            (sb-int:simple-program-error (condition)
              (equal (simple-condition-format-arguments condition) '(1)))))
  (format t "Fresh minimum arity executed.~%"))
