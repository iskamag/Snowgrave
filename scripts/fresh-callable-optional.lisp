(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-callable-optional-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.CALLABLE-OPTIONAL.FIXTURE")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (load (compile-file source :output-file (merge-pathnames ".build/fresh-callable-optional.fasl"
                                                        (asdf:system-source-directory "snowgrave"))))
  (let* ((unit (with-open-file (stream metadata) (read stream)))
         (entry (find-symbol "ENTRY" "SNOWGRAVE.CALLABLE-OPTIONAL.FIXTURE"))
         (defaults (find-symbol "*DEFAULTS*" "SNOWGRAVE.CALLABLE-OPTIONAL.FIXTURE")))
    (dolist (name '("LEFT" "RIGHT" "DEFAULT-FUNCTION" "INVOKE" "ENTRY"))
      (assert (not (fboundp (find-symbol name "SNOWGRAVE.CALLABLE-OPTIONAL.FIXTURE")))))
    (setf (symbol-value defaults) nil)
    (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function unit entry) 17))
                   '(((18 nil nil) (16 t nil) (18 t t) (18 t t) (16 t nil) (18 nil nil) 16)
                     (:fn :alias :alias :alias :fn :alias))))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh optional callable bindings executed.~%")
