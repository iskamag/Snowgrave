(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-external-results-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(defpackage #:snowgrave.external.results.fixture (:use #:cl))
(in-package #:snowgrave.external.results.fixture)
(defvar *bytes*) (defvar *log*)
(defun external-bytes ()
  (push :factory *log*)
  (setf *bytes* (make-array 1 :element-type '(unsigned-byte 8) :initial-element 19)))
(defun external-alias (data) (push :alias *log*) data)
(defun external-tuple () (let ((data (external-bytes))) (values data data :native)))
(defun external-zero () (push :zero *log*) (values))
(in-package #:cl-user)
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (multiple-value-bind (artifact warnings failure)
      (compile-file source :output-file (merge-pathnames ".build/fresh-external-results.fasl" (asdf:system-source-directory "snowgrave")))
    (declare (ignore warnings)) (assert (not failure)) (load artifact))
  (let ((data (with-open-file (stream metadata) (read stream))))
    (progv '(snowgrave.external.results.fixture::*bytes* snowgrave.external.results.fixture::*log*) '(nil nil)
      (let ((values (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function data "STORE-OCTET") 255))))
        (assert (eq (first values) snowgrave.external.results.fixture::*bytes*))
        (assert (equal (rest values) '(255 t)))
        (sb-ext:gc :full t)
        (assert (= 255 (aref (first values) 0))))
      (let ((condition (handler-case (funcall (snowgrave.artifact-tests:artifact-function data "STORE-OCTET") 256)
                         (type-error (c) c))))
        (assert (typep condition 'type-error))
        (assert (= 256 (type-error-datum condition)))
        (assert (= 19 (aref snowgrave.external.results.fixture::*bytes* 0)))
        (assert (equal snowgrave.external.results.fixture::*log* '(:factory :alias :factory))))
      (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function data "TUPLE-ENTRY"))) '(t 19 :native)))
      (let* ((record (funcall (snowgrave.artifact-tests:artifact-function data "BOOT")))
             (condition (handler-case (funcall (snowgrave.artifact-tests:artifact-function data "STORE-ANY") record)
                          (type-error (c) c))))
        (assert (typep condition 'type-error))
        (assert (eq record (type-error-datum condition)))
        (assert (= 19 (aref snowgrave.external.results.fixture::*bytes* 0)))
        (assert (equal (multiple-value-list
                        (funcall (snowgrave.artifact-tests:artifact-function data "OBSERVE-ERROR") condition record))
                       '(72 t (unsigned-byte 8)))))
      (assert (null (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function data "ZERO-ENTRY"))))))))
(assert (not (find-class 'snowgrave.external.results.fixture::box nil)))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh native external results executed.~%")
