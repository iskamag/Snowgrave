(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-generic-values-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.GENERIC-VALUES.FIXTURE")))
(destructuring-bind (source metadata observations) (uiop:command-line-arguments)
  (multiple-value-bind (artifact warnings failure)
      (compile-file source :output-file (merge-pathnames ".build/fresh-generic-values.fasl"
                                                       (asdf:system-source-directory "snowgrave")))
    (declare (ignore warnings)) (assert (not failure)) (load artifact))
  (let* ((unit (with-open-file (stream metadata) (read stream)))
         (expected (with-open-file (stream observations) (read stream)))
         (package (find-package "SNOWGRAVE.GENERIC-VALUES.FIXTURE"))
         (trace (find-symbol "*TRACE*" package))
         (leaf (funcall (snowgrave.artifact-tests:artifact-function unit "BOOT") 17))
         (base (funcall (snowgrave.artifact-tests:artifact-function unit "BOOT-BASE") 17)))
    (dolist (name '("BASE" "LEAF")) (assert (not (find-class (find-symbol name package) nil))))
    (dolist (name '("AMOUNT" "PACK" "VARY" "EMPTY" "ARGUMENTS" "LONE" "RECURSIVE-PACK"
                    "RELAY" "METHOD-TUPLE" "BOOT" "BOOT-BASE" "RECEIPT"))
      (assert (not (fboundp (find-symbol name package))))
      (assert (not (fboundp (list 'setf (find-symbol name package))))))
    (dolist (case expected)
      (destructuring-bind (name class n values effects) case
        (assert (not (fboundp (find-symbol name package))))
        (setf (symbol-value trace) nil)
        (assert (equal values (multiple-value-list
                              (funcall (snowgrave.artifact-tests:artifact-function unit name)
                                       (if (equal class "BASE") base leaf) n))))
        (assert (equal effects (reverse (symbol-value trace))))))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh generic method values executed.~%")
