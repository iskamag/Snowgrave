(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-external-writers-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(defpackage #:snowgrave.tests (:use #:cl))
(defvar snowgrave.tests::*external-log* nil)
;; This real outside-cohort host generic is the required ordinary boundary,
;; not an authored source definition or a replacement output dispatcher.
(cl:defgeneric (setf snowgrave.tests::external-cell) (value cell))
(cl:defmethod (setf snowgrave.tests::external-cell) (value cell)
  (push (list :writer value (car cell)) snowgrave.tests::*external-log*)
  (rplaca cell value)
  (values value :external-value))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (load (compile-file source :output-file (merge-pathnames ".build/fresh-external-writers.fasl" (asdf:system-source-directory "snowgrave"))))
  (let ((unit (with-open-file (stream metadata) (read stream))))
    (dolist (name '("EXTERNAL-WRITER-ENTRY" "EXTERNAL-WRITER-CALL" "LEXICAL-WRITER-ENTRY" "LEXICAL-WRITER-CALL"))
      (let* ((original (find-symbol name "SNOWGRAVE.TESTS"))
             (externalp (search "EXTERNAL" name))
             (snowgrave.tests::*external-log* nil) (cell (list 0)))
        (assert (not (fboundp original)))
        (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function unit original) (if externalp 0 cell) 7))
                       (list 7 (if externalp :external-value :local-value))))
        (assert (equal cell (if externalp '(0) '((:local 7)))))
        (assert (equal snowgrave.tests::*external-log* (if externalp '((:writer 7 0)) nil)))))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh external and lexical writers executed.~%")
