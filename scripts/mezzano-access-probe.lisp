(require :asdf)
(defun required-directory (name)
  (uiop:ensure-directory-pathname (or (uiop:getenv name) (error "Set ~A to the actual native dependency directory." name))))
(defparameter *native-source* (required-directory "SNOWGRAVE_MEZZANO_SOURCE"))
(defparameter *native-deps* (required-directory "SNOWGRAVE_MEZZANO_DEPS"))
(defparameter *native-iterate* (required-directory "SNOWGRAVE_MEZZANO_ITERATE"))
(defparameter *native-nibbles* (required-directory "SNOWGRAVE_MEZZANO_NIBBLES"))
(defparameter *probe-cache* (uiop:ensure-directory-pathname (or (uiop:getenv "SNOWGRAVE_MEZZANO_CACHE") "/tmp/snowgrave-mezzano-access-cache/")))
(defparameter *source-root* (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
(asdf:initialize-source-registry
 `(:source-registry (:directory ,*native-source*) (:directory ,*native-nibbles*) (:directory ,*native-iterate*)
   ,@(mapcar (lambda (name) `(:directory ,(merge-pathnames name *native-deps*)))
             '("cl-ppcre/" "alexandria/" "closer-mop/" "trivial-gray-streams/")) :ignore-inherited-configuration))
(asdf:initialize-output-translations
 `(:output-translations (t (,(namestring (merge-pathnames "asdf-tree/" *probe-cache*)) :implementation)) :ignore-inherited-configuration))
(asdf:load-system "lispos")
(let ((*default-pathname-defaults* *native-source*) (*compile-verbose* nil) (*compile-print* nil))
  (cold-generator:set-up-cross-compiler :architecture :x86-64))
(assert (not (find-package "WONDERWORLD")))
(assert (not (find-package "THREST")))
(dolist (name '("scope" "entries" "records" "arrays" "arithmetic"))
  (mezzano.compiler::load-for-cross-compiler
   (merge-pathnames (format nil "adapters/mezzano-access/~A.lisp" name) *source-root*) :verbose nil :print nil))
(mezzano.compiler::load-for-cross-compiler (merge-pathnames "tests/mezzano-access-fixture.lisp" *source-root*) :verbose nil :print nil)

(load (merge-pathnames "scripts/mezzano-arithmetic-model-check.lisp" *source-root*))
(load (merge-pathnames "scripts/mezzano-anonymous-model-check.lisp" *source-root*))

(defun fixture-symbol (name) (find-symbol name "SNOWGRAVE.MEZZANO-ACCESS-FIXTURE"))
(load (merge-pathnames "scripts/mezzano-record-domain-model-check.lisp" *source-root*))
(defun emitted-worker (assembly name)
  (let* ((start (or (search (format nil "~%~A:~%" name) assembly) (error "Missing emitted worker ~A" name)))
         (end (or (search "MEZZANO.COMPILER.BACKEND.X86-64::LITERAL-POOL/128" assembly :start2 start) (length assembly))))
    (subseq assembly start end)))
(let* ((marker (find-symbol "%ADMITTED-ACCESS-SCOPE" "SNOWGRAVE.MEZZANO-ACCESS"))
       (failure '(return-from native-entry (values nil :invalid-record)))
       (environment (mezzano.compiler::extend-environment
                     nil :functions (list (list marker (lambda (form env) (declare (ignore form env)) failure)))))
       (reader (fixture-symbol "ENTITY-ID")) (writer (list 'setf (fixture-symbol "ENTITY-GENERATION")))
       (read-form (list reader '(source-object))) (write-form (list writer '(source-value) '(source-object))))
  (multiple-value-bind (actual admittedp) (snowgrave.mezzano-access:admitted-access-failure environment)
    (assert admittedp) (assert (equal actual failure)))
  (let* ((entry-macro (cross-cl:macro-function 'snowgrave.mezzano-access:define-admitted-entry))
         (lambda-macro (cross-cl:macro-function 'snowgrave.mezzano-access:admitted-lambda))
         (call-macro (cross-cl:macro-function 'snowgrave.mezzano-access:call-admitted-entry))
         (entry (funcall entry-macro
                         '(snowgrave.mezzano-access:define-admitted-entry native-entry
                            (x &optional (y (default-value x) supplied-p)) (values nil :bad-count)
                            "Entry documentation." (declare (type fixnum x)) (values x y supplied-p)) nil))
         (scope (car (last entry))) (decision (third scope)) (bindings (second (third decision)))
         (call '(snowgrave.mezzano-access:call-admitted-entry (source-function) (source-first) (source-second))))
    (assert (eq (first entry) 'defun))
    (assert (equal (fourth entry) "Entry documentation."))
    (assert (equal (mapcar #'third (cdr (second decision))) '(1 2)))
    (assert (equal (fourth decision) '(values nil :bad-count)))
    (assert (equal (second scope) '(return-from native-entry (values nil :bad-count))))
    (assert (equal (mapcar #'first bindings) '(x y supplied-p)))
    (assert (equal (fourth (second (second bindings))) '(default-value x)))
    (assert (equal (third (third decision)) '(declare (type fixnum x))))
    (assert (equal (funcall call-macro call nil) '(funcall (source-function) (source-first) (source-second))))
    (assert (equal (mapcar #'second (second (funcall call-macro call environment)))
                   '((source-function) (source-first) (source-second))))
    (assert (equal (fourth (third (funcall call-macro call environment))) failure))
    (let* ((anonymous (funcall lambda-macro
                              '(snowgrave.mezzano-access:admitted-lambda
                                   (x &optional (y (default-value x) supplied-p)) (values nil :bad-count)
                                 "Anonymous documentation." (declare (type fixnum x)) (values x y supplied-p)) nil))
           (lambda (second anonymous)) (block (car (last lambda)))
           (scope (third block)) (decision (third scope)) (bindings (second (third decision))))
      (assert (eq (first anonymous) 'function))
      (assert (eq (first lambda) 'lambda))
      (assert (equal (third lambda) "Anonymous documentation."))
      (assert (eq (first block) 'block))
      (assert (and (second block) (symbolp (second block)) (not (symbol-package (second block)))))
      (assert (equal (mapcar #'third (cdr (second decision))) '(1 2)))
      (assert (equal (fourth decision) '(values nil :bad-count)))
      (assert (equal (second scope) `(return-from ,(second block) (values nil :bad-count))))
      (assert (equal (mapcar #'first bindings) '(x y supplied-p)))
      (assert (equal (fourth (second (second bindings))) '(default-value x)))
      (assert (equal (third (third decision)) '(declare (type fixnum x)))))
    (flet ((rejected-p (arguments &optional declarations)
             (handler-case
                 (progn (funcall entry-macro
                                 `(snowgrave.mezzano-access:define-admitted-entry native-entry
                                    ,arguments (values nil :bad-count) ,@declarations (values)) nil) nil)
               (error () t))))
      (dolist (arguments '((a b c d e f) (a &rest tail) (a &key key) (a &aux tmp)
                           (a &optional b &optional c) (a a) (a &optional (b nil a))
                           (t) (:constant) (nil) (a &optional (b nil nil))
                           (a &optional (b nil p extra))))
        (assert (rejected-p arguments)))
      (assert (rejected-p '(x) '((declare (special x)))))
      (assert (rejected-p (list (fixture-symbol "*SPECIAL-ENTRY-ARGUMENT*"))))
      (assert (rejected-p (cons 'a 'dotted)))
      (let ((cycle (list 'a))) (setf (cdr cycle) cycle) (assert (rejected-p cycle))))
    (flet ((anonymous-rejected-p (arguments &optional declarations)
             (handler-case
                 (progn (funcall lambda-macro
                                 `(snowgrave.mezzano-access:admitted-lambda ,arguments (values nil :bad-count)
                                    ,@declarations (values)) nil) nil)
               (error () t))))
      (dolist (arguments '((a b c d e f) (a &rest tail) (a &key key) (a &aux tmp)
                           (a a) (a &optional (b nil a)) (a &optional (b nil nil))))
        (assert (anonymous-rejected-p arguments)))
      (assert (anonymous-rejected-p '(x) '((declare (special x)))))
      (assert (anonymous-rejected-p (cons 'a 'dotted)))
      (let ((cycle (list 'a))) (setf (cdr cycle) cycle) (assert (anonymous-rejected-p cycle)))))
  (assert (null (nth-value 1 (snowgrave.mezzano-access:admitted-access-failure nil))))
  (multiple-value-bind (arguments recognizedp)
      (snowgrave.mezzano-access:access-call-arguments '(funcall #'(setf aref) value array index) '(setf aref))
    (assert recognizedp) (assert (equal arguments '(value array index))))
  (assert (not (nth-value 1 (snowgrave.mezzano-access:access-call-arguments '(funcall dynamic value) 'aref))))
  (let ((cycle (list 'aref)))
    (setf (cdr cycle) cycle)
    (assert (not (nth-value 1 (snowgrave.mezzano-access:access-call-arguments cycle 'aref)))))
  (let ((unmarked (mezzano.compiler::extend-environment
                   nil :functions (list (list (fixture-symbol "UNRELATED-MARKER")
                                             (lambda (form env) (declare (ignore form env)) nil))))))
    (assert (cross-cl:macro-function marker))
    (assert (null (nth-value 1 (snowgrave.mezzano-access:admitted-access-failure unmarked))))
    (assert (equal (snowgrave.mezzano-access:admitted-access-failure environment) failure)))
  (dolist (name (list reader writer))
    (let* ((macro (cross-cl:compiler-macro-function name))
           (form (if (equal name writer) write-form read-form))
           (original (gethash name snowgrave.mezzano-access::*original-record-compiler-macros*)))
      (assert (equal (funcall macro form nil) (if original (funcall original form nil) form)))
      (let ((expansion (funcall macro form environment)))
        (assert (eq (car expansion) 'let))
        (assert (equal (fourth (third expansion)) failure))
        (assert (eq (car (third (third expansion))) (if (equal name writer) 'if 'let))))))
  (let ((bindings (second (funcall (cross-cl:compiler-macro-function writer) write-form environment))))
    (assert (equal (mapcar #'second bindings) '((source-value) (source-object)))))
  (let* ((name (list 'mezzano.internals::cas (fixture-symbol "ENTITY-GENERATION")))
         (form `(funcall (function ,name) (source-old) (source-new) (source-object)))
         (macro (cross-cl:compiler-macro-function name))
         (original (gethash name snowgrave.mezzano-access::*original-record-compiler-macros*))
         (expansion (funcall macro form environment))
         (cas (third (third (third expansion))))
         (slot (find (fixture-symbol "GENERATION")
                     (mezzano.clos:class-slots (mezzano.internals::get-structure-type (fixture-symbol "ENTITY")))
                     :key #'mezzano.clos:slot-definition-name)))
    (assert (equal (funcall macro form nil) (if original (funcall original form nil) form)))
    (assert (equal (mapcar #'second (second expansion)) '((source-old) (source-new) (source-object))))
    (assert (equal (fourth (third expansion)) failure))
    (assert (equal (fourth (third (third expansion))) failure))
    (assert (eq (first cas) 'multiple-value-bind))
    (assert (eq (first (third cas)) 'mezzano.internals::%cas-object))
    (assert (= (second (third (third cas)))
               (mezzano.runtime::location-offset-t (mezzano.clos:slot-definition-location slot))))
    (assert (eq (first (car (last cas))) 'if)) ; observed typed value is also checked
    (let* ((source `(mezzano.internals::cas (,(fixture-symbol "ENTITY-GENERATION") (source-object))
                                          (source-old) (source-new)))
           (place-expansion (cross-cl:macroexpand source environment)))
      (assert (equal (mapcar #'second (second place-expansion)) '((source-object) (source-old) (source-new))))))
  (let* ((class (mezzano.internals::get-structure-type (fixture-symbol "ENTITY")))
         (slot (find (fixture-symbol "ID") (mezzano.clos:class-slots class) :key #'mezzano.clos:slot-definition-name)))
    (assert (eq (mezzano.clos:slot-definition-type slot) 'fixnum))
    (assert (eql (mezzano.runtime::location-type (mezzano.clos:slot-definition-location slot)) mezzano.runtime::+location-type-t+)))
  (snowgrave.mezzano-access::install-record-accessors
   (fixture-symbol "ENTITY") (list (list reader (fixture-symbol "ID"))))
  (assert (null (cross-cl:compiler-macro-function (list 'setf (fixture-symbol "IMMUTABLE-VALUE")))))
  (assert (null (cross-cl:compiler-macro-function (list 'mezzano.internals::cas (fixture-symbol "IMMUTABLE-VALUE")))))
  (dolist (name '("EFFECTFUL-GETTER" "EFFECTFUL-WRITER" "EFFECTFUL-CAS"))
    (let* ((record (fixture-symbol name)) (accessor (fixture-symbol (concatenate 'string name "-VALUE"))))
      (handler-case
          (progn (snowgrave.mezzano-access::install-record-accessors record (list (list accessor (fixture-symbol "VALUE"))))
                 (error "Effectful accessor accepted"))
        (error (condition) (assert (search "lacks the exact native" (princ-to-string condition)))))
      (dolist (function (list accessor (list 'setf accessor) (list 'mezzano.internals::cas accessor)))
        (assert (null (cross-cl:compiler-macro-function function))))))
  (handler-case
      (progn (snowgrave.mezzano-access::install-record-accessors
              (fixture-symbol "UNSUPPORTED")
              (list (list (fixture-symbol "UNSUPPORTED-TAG") (fixture-symbol "TAG"))
                    (list (fixture-symbol "UNSUPPORTED-VALUE") (fixture-symbol "VALUE"))))
             (error "Unsupported typed field accepted"))
    (error (condition) (assert (search "Unsupported frozen record field" (princ-to-string condition)))))
  (assert (null (cross-cl:compiler-macro-function (fixture-symbol "UNSUPPORTED-TAG"))))
  (handler-case
      (progn (snowgrave.mezzano-access::install-record-accessors
              (fixture-symbol "UNSUPPORTED-FINITE")
              (list (list (fixture-symbol "UNSUPPORTED-FINITE-TAG") (fixture-symbol "TAG"))
                    (list (fixture-symbol "UNSUPPORTED-FINITE-VALUE") (fixture-symbol "VALUE"))))
             (error "Unsupported finite field accepted"))
    (error (condition) (assert (search "Unsupported frozen record field" (princ-to-string condition)))))
  (assert (null (cross-cl:compiler-macro-function (fixture-symbol "UNSUPPORTED-FINITE-TAG"))))
  (handler-case
      (progn (snowgrave.mezzano-access::install-record-accessors
              (fixture-symbol "UNBOXED-EQL")
              (list (list (fixture-symbol "UNBOXED-EQL-TAG") (fixture-symbol "TAG"))
                    (list (fixture-symbol "UNBOXED-EQL-ZERO") (fixture-symbol "ZERO"))))
             (error "Unboxed EQL field accepted"))
    (error (condition) (assert (search "Unsupported frozen record field" (princ-to-string condition)))))
  (assert (null (cross-cl:compiler-macro-function (fixture-symbol "UNBOXED-EQL-TAG"))))
  (dolist (name '("UNSUPPORTED-FINITE-TAG" "UNSUPPORTED-FINITE-VALUE" "UNBOXED-EQL-TAG" "UNBOXED-EQL-ZERO"))
    (let ((accessor (fixture-symbol name)))
      (dolist (function (list accessor (list 'setf accessor) (list 'mezzano.internals::cas accessor)))
        (assert (null (cross-cl:compiler-macro-function function))))))
  (handler-case
      (progn (snowgrave.mezzano-access::install-record-accessors
              (fixture-symbol "ENTITY") (list (list reader (fixture-symbol "GENERATION"))))
             (error "Wrong accessor identity accepted"))
    (error (condition) (assert (search "does not read actual field" (princ-to-string condition)))))
  (let* ((form '(cl:aref array index)) (macro (cross-cl:compiler-macro-function 'cl:aref))
         (original (gethash 'cl:aref snowgrave.mezzano-access::*original-array-compiler-macros*)))
    (assert (equal (funcall macro form nil) (funcall original form nil)))
    (assert (equal (mapcar #'second (second (funcall macro form environment))) '(array index)))
    (snowgrave.mezzano-access::install-array-accessors)
    (assert (eq original (gethash 'cl:aref snowgrave.mezzano-access::*original-array-compiler-macros*)))
    (assert (equal (funcall (cross-cl:compiler-macro-function 'cl:aref) form nil) (funcall original form nil))))
  (let* ((form '(vectorp (source-object)))
         (macro (cross-cl:compiler-macro-function 'vectorp))
         (original (gethash 'vectorp snowgrave.mezzano-access::*original-array-compiler-macros*))
         (expansion (funcall macro form environment)))
    (assert (equal (funcall macro form nil) (if original (funcall original form nil) form)))
    (assert (equal (mapcar #'second (second expansion)) '((source-object))))
    (assert (eq (car (third expansion)) 'and))
    ;; The predicate preserves every native vector representation. Neither a
    ;; storage/capacity check nor a bounded rejection belongs to VECTORP.
    (assert (not (search "%OBJECT-REF-T" (prin1-to-string expansion))))
    (assert (not (search "RETURN-FROM" (prin1-to-string expansion))))
    (assert (search "+FIRST-SIMPLE-1D-ARRAY-OBJECT-TAG+" (prin1-to-string expansion)))
    (assert (search "+LAST-COMPLEX-ARRAY-OBJECT-TAG+" (prin1-to-string expansion))))
  (format t "ACTUAL-NATIVE-SHARED-ACCESS-EXPANSION-PASSED~%"))

(let ((mezzano.compiler::*target-architecture* :x86-64) (cross-cl:*features* (cons :x86-64 cross-cl:*features*)))
  (dolist (name '("scope" "entries" "records" "arrays" "arithmetic"))
    (let ((output (merge-pathnames (make-pathname :name name :type "llf") *probe-cache*)))
      (mezzano.compiler::cross-compile-file (merge-pathnames (format nil "adapters/mezzano-access/~A.lisp" name) *source-root*)
        :output-file output :verbose nil :print nil)
      (with-open-file (stream output :element-type '(unsigned-byte 8))
        (mezzano.cold-generator.load:validate-llf-header stream :x86-64))))
  (let* ((output (merge-pathnames "mezzano-access-fixture.llf" *probe-cache*))
         (assembly (with-output-to-string (stream)
                     (let ((*standard-output* stream) (mezzano.compiler::*trace-asm* t))
                       (mezzano.compiler::cross-compile-file (merge-pathnames "tests/mezzano-access-fixture.lisp" *source-root*)
                         :output-file output :verbose nil :print nil)))))
    (with-open-file (stream output :element-type '(unsigned-byte 8)) (mezzano.cold-generator.load:validate-llf-header stream :x86-64))
    (with-open-file (stream (merge-pathnames "fixture.lap" *probe-cache*) :direction :output :if-exists :supersede)
      (write-string assembly stream))
    (assert (search "(:NAMED-CALL MEZZANO.INTERNALS::%STRUCT-SLOT)" (emitted-worker assembly "ORDINARY-RECORD-READ")))
    (assert (search "(:NAMED-CALL MEZZANO.INTERNALS::AREF-1)" (emitted-worker assembly "ORDINARY-ARRAY-READ")))
    (assert (search "(:NAMED-CALL LENGTH)" (emitted-worker assembly "ORDINARY-ARRAY-LENGTH")))
    (assert (search ":NAMED-CALL" (emitted-worker assembly "ORDINARY-VECTORP")))
    (assert (search "%COERCE-TO-CALLABLE" (emitted-worker assembly "ORDINARY-CALLABLE")))
    (assert (search "%STRUCT-SLOT" (emitted-worker assembly "ORDINARY-RECORD-CAS")))
    (dolist (name '("ORDINARY-FINITE-READ" "ORDINARY-FINITE-WRITE" "ORDINARY-FINITE-CAS"))
      (assert (search "%STRUCT-SLOT" (emitted-worker assembly name))))
    (dolist (name '("BOUNDED-RECORD-READ" "BOUNDED-RECORD-WRITE" "BOUNDED-BOXED-READ" "BOUNDED-BOXED-WRITE"
                    "BOUNDED-ARRAY-READ" "BOUNDED-ARRAY-WRITE" "BOUNDED-NATIVE-READ" "BOUNDED-NATIVE-WRITE"
                    "BOUNDED-LENGTH" "BOUNDED-SIZE" "BOUNDED-FILL-READ" "BOUNDED-FILL-WRITE" "BOUNDED-VECTORP"
                    "SHARED-OPTIONAL" "SHARED-FIVE" "SHARED-EMPTY" "(SETF SHARED-VALUE)"
                    "BOUNDED-FINITE-READ" "BOUNDED-FINITE-WRITE"
                    "BOUNDED-PRIORITY-READ" "BOUNDED-PRIORITY-WRITE"
                    "BOUNDED-EQL-READ" "BOUNDED-EQL-WRITE"
                    "BOUNDED-THREAD-STATE-READ" "BOUNDED-THREAD-STATE-WRITE"
                    "BOUNDED-THREAD-PRIORITY-READ" "BOUNDED-THREAD-PRIORITY-WRITE"))
      (let ((code (emitted-worker assembly name)))
        (assert (not (search ":CALL" code)))
        (assert (not (search ":NAMED-CALL" code)))
        (assert (not (search "ALLOCATE" code)))
        (format t "~A: NO-CALL/NO-NAMED-CALL/NO-ALLOCATOR~%" name)))
    (dolist (name '("BOUNDED-RECORD-CAS" "BOUNDED-BOXED-CAS" "BOUNDED-INCLUDED-CAS"
                    "BOUNDED-FINITE-CAS" "BOUNDED-PRIORITY-CAS" "BOUNDED-EQL-CAS"
                    "BOUNDED-THREAD-STATE-CAS" "BOUNDED-THREAD-PRIORITY-CAS"))
      (let ((code (emitted-worker assembly name)))
        (assert (search "CMPXCHG" code))
        (assert (search "LOCK" code))
        (assert (not (search ":CALL" code)))
        (assert (not (search ":NAMED-CALL" code)))
        (assert (not (search "ALLOCATE" code)))
        (assert (not (search "%STRUCT-SLOT" code)))
        (format t "~A: ACTUAL-LOCK-CMPXCHG/NO-CALL/NO-NAMED-CALL/NO-ALLOCATOR~%" name)))
    (assert (search "RAISE-INVALID-ARGUMENT-ERROR"
                    (emitted-worker assembly "(LAMBDA :IN ORDINARY-ANONYMOUS-FACTORY)")))
    (dolist (name '("(LAMBDA :IN SHARED-ANONYMOUS-FACTORY)"
                    "(LAMBDA :IN SHARED-ANONYMOUS-CAPTURE-FACTORY)"
                    "(LAMBDA :IN SHARED-NESTED-ANONYMOUS-FACTORY)"
                    "SHARED-NESTED-ANONYMOUS-FACTORY"))
      (let ((code (emitted-worker assembly name)))
        (assert (not (search ":CALL" code)))
        (assert (not (search ":NAMED-CALL" code)))
        (assert (not (search "ALLOCATE" code)))
        (assert (not (search "%STRUCT-SLOT" code)))
        (format t "~A: NO-CALL/NO-NAMED-CALL/NO-ALLOCATOR~%" name)))
    (dolist (control '(("ORDINARY-NUMBER-ADD" "(:NAMED-CALL MEZZANO.INTERNALS::GENERIC-+)")
                       ("ORDINARY-NUMBER-PRODUCT" "(:NAMED-CALL MEZZANO.INTERNALS::GENERIC-*)")
                       ("ORDINARY-NUMBER-TRUNCATE" ":NAMED-CALL")
                       ("ORDINARY-NUMBER-EQL" "(:NAMED-CALL EQL)")))
      (assert (search (second control) (emitted-worker assembly (first control)))))
    (dolist (name '("BOUNDED-NUMBER-ADD" "BOUNDED-NUMBER-SUBTRACT" "BOUNDED-NUMBER-NEGATE"
                    "BOUNDED-NUMBER-PRODUCT" "BOUNDED-NUMBER-SHIFT" "BOUNDED-NUMBER-INCREMENT"
                    "BOUNDED-NUMBER-TRUNCATE" "BOUNDED-NUMBER-TRUNCATE-ONE"
                    "BOUNDED-NUMBER-TRUNCATE-CALL" "BOUNDED-NUMBER-TRUNCATE-NESTED"
                    "BOUNDED-NUMBER-DECREMENT" "BOUNDED-NUMBER-LESS" "BOUNDED-NUMBER-LESS-EQUAL"
                    "BOUNDED-NUMBER-GREATER" "BOUNDED-NUMBER-GREATER-EQUAL" "BOUNDED-NUMBER-EQUAL"
                    "BOUNDED-NUMBER-DISTINCT" "BOUNDED-NUMBER-EQL" "BOUNDED-NUMBER-MIN"
                    "BOUNDED-NUMBER-MAX" "BOUNDED-NUMBER-PLUSP" "BOUNDED-NUMBER-MINUSP"
                    "BOUNDED-NUMBER-ZEROP" "BOUNDED-NUMBER-LOGAND" "BOUNDED-NUMBER-LOGIOR"
                    "BOUNDED-NUMBER-LOGXOR" "BOUNDED-NUMBER-LOGNOT" "BOUNDED-NUMBER-EVENP"
                    "BOUNDED-NUMBER-ODDP" "BOUNDED-NUMBER-EMPTY-ADD" "BOUNDED-NUMBER-EMPTY-PRODUCT"
                    "BOUNDED-NUMBER-EMPTY-AND" "BOUNDED-NUMBER-EMPTY-OR" "BOUNDED-NUMBER-EMPTY-XOR"))
      (let ((code (emitted-worker assembly name)))
        (assert (not (search ":CALL" code)))
        (assert (not (search ":NAMED-CALL" code)))
        (assert (not (search "ALLOCATE" code)))
        (when (equal name "BOUNDED-NUMBER-PRODUCT")
          (assert (search "IDIV64" code)) (assert (search "IMUL64" code)))
        (when (member name '("BOUNDED-NUMBER-TRUNCATE" "BOUNDED-NUMBER-TRUNCATE-CALL"
                            "BOUNDED-NUMBER-TRUNCATE-NESTED") :test #'equal)
          (assert (search "IDIV64" code)))
        (when (equal name "BOUNDED-NUMBER-TRUNCATE-ONE")
          (assert (not (search "IDIV64" code))))
        (format t "~A: NO-CALL/NO-NAMED-CALL/NO-ALLOCATOR~%" name)))
    (let ((code (emitted-worker assembly "SHARED-CALL")))
      (assert (not (search "%COERCE-TO-CALLABLE" code)))
      (assert (not (search "RAISE-INVALID-ARGUMENT-ERROR" code)))
      (assert (not (search "ALLOCATE" code)))
      (format t "SHARED-CALL: CHECKED-CALLABLE/NO-ARITY-REPAIR/NO-ALLOCATOR~%"))))
(format t "ACTUAL-NATIVE-SHARED-ACCESS-CROSS-COMPILE-PASSED~%")
