(require :asdf)
(push (uiop:pathname-parent-directory-pathname
        (uiop:pathname-directory-pathname *load-truename*)) asdf:*central-registry*)
(asdf:load-system "snowgrave/sbcl")
(defpackage #:snowgrave.native-authored (:use #:cl))
(defpackage #:snowgrave.native-authored-runtime (:use #:cl))
(let* ((root (asdf:system-source-directory "snowgrave"))
       (*package* (find-package :snowgrave.native-authored))
       (forms (with-open-file (in (merge-pathnames "tests/native-authored-class.lisp" root))
                (loop for form = (read in nil in) until (eq form in)
                      unless (member (car form) '(defpackage in-package)) collect form)))
       (unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(:native-authored-typed)
               :closed-classes (read-from-string "(left right leaf)") :universe (read-from-string "(left right leaf number t)")
               :closed-generics (read-from-string "(initialize-instance shared-initialize compute-value
                                  u (setf u) signed (setf signed) wide (setf wide)
                                  flag (setf flag) data (setf data))")
               :entries (read-from-string "(boot observe compute-entry write-u write-signed write-data bound-u unbind-u bound-data unbind-data class-token is-left is-right)")
               :external-domains (read-from-string "((boot (t)) (observe (leaf)) (compute-entry (leaf))
                                   (write-u (leaf t)) (write-signed (leaf t)) (write-data (leaf t))
                                   (bound-u (leaf)) (unbind-u (leaf)) (bound-data (leaf)) (unbind-data (leaf)) (class-token (leaf))
                                   (is-left (t)) (is-right (t)))")))
       (other-declaration (getf (snowgrave:unit-report unit) :declaration))
       (other-unit (progn (setf (getf other-declaration :unit-name) '(:native-authored-other))
                          (apply #'snowgrave:close-source-unit (list :forms forms) other-declaration)))
       (record (funcall (snowgrave:unit-function unit "BOOT") nil))
       (path (merge-pathnames ".build/native-authored-unit.lisp" root)))
  (assert (equal (multiple-value-list (funcall (snowgrave:unit-function unit "COMPUTE-ENTRY") record))
                 '(4294934782 1)))
  (with-open-file (out path :direction :output :if-exists :supersede)
    (snowgrave:write-mezzano-unit-source unit out))
  (with-open-file (out (merge-pathnames ".build/native-authored-other-unit.lisp" root)
                       :direction :output :if-exists :supersede)
    (snowgrave:write-mezzano-unit-source other-unit out))
  (with-open-file (out (merge-pathnames ".build/native-authored.metadata" root)
                       :direction :output :if-exists :supersede)
    (snowgrave:write-unit-metadata unit out))
  (with-open-file (out (merge-pathnames ".build/native-authored-entry-names.lisp" root)
                       :direction :output :if-exists :supersede)
    (let ((*print-readably* nil) (*print-escape* t) (*print-circle* t))
      (write '(defpackage #:snowgrave.native-authored-runtime (:use #:cl) (:export #:run)) :stream out) (terpri out)
      (write '(in-package #:snowgrave.native-authored-runtime) :stream out) (terpri out)
      (write `(defmacro ,(intern "ENTRY" :snowgrave.native-authored-runtime) (name &rest arguments)
                (cons (cdr (assoc name ',(loop for entry in (getf (snowgrave:unit-metadata unit) :entries)
                                               for key = (getf entry :code-key)
                                               collect (cons (symbol-name (getf entry :name))
                                                             (intern (second key) (first key)))
                                               into entries
                                               finally (return (append entries
                                                  (loop for entry in (getf (snowgrave:unit-metadata other-unit) :entries)
                                                        for key = (getf entry :code-key)
                                                        when (member (symbol-name (getf entry :name)) '("BOOT" "OBSERVE") :test #'string=)
                                                        collect (cons (concatenate 'string "OTHER-" (symbol-name (getf entry :name)))
                                                                      (intern (second key) (first key)))))))
                                  :test #'string=)) arguments)) :stream out) (terpri out)))
  (format t "ACTUAL-AUTHORED-UNIT-PREPARED ~A~%" path))
