(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-callable-union-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.CALLABLE-UNION.FIXTURE")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (load (compile-file source :output-file (merge-pathnames ".build/fresh-callable-union.fasl"
                                                        (asdf:system-source-directory "snowgrave"))))
  (let* ((unit (with-open-file (stream metadata) (read stream)))
         (entry (find-symbol "ENTRY" "SNOWGRAVE.CALLABLE-UNION.FIXTURE"))
         (selections (find-symbol "*SELECTIONS*" "SNOWGRAVE.CALLABLE-UNION.FIXTURE")))
    (assert (not (fboundp entry)))
    (dolist (name '("LEFT" "RIGHT" "PAIR"))
      (assert (not (fboundp (find-symbol name "SNOWGRAVE.CALLABLE-UNION.FIXTURE")))))
    (dolist (flag '(t nil))
      (setf (symbol-value selections) 0)
      (assert (equal (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function unit entry) flag 17))
                     (if flag '(((18 :left) 18 18 18 18 18) 5) '(((16 :right) 16 16 16 16 16) 5)))))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh finite callable union executed.~%")
