(require :asdf)
(let ((root (uiop:pathname-parent-directory-pathname
             (uiop:pathname-directory-pathname *load-truename*))))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations
   `(:output-translations (t ,(merge-pathnames ".build/fresh-layout-matching-fasl/" root))
     :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(assert (not (find-package "SNOWGRAVE.LAYOUT-MATCHING.FIXTURE")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (multiple-value-bind (artifact warnings failure)
      (compile-file source :output-file (make-pathname :type "fasl" :defaults source))
    (declare (ignore warnings)) (assert (not failure)) (load artifact))
  (let* ((metadata (with-open-file (in metadata) (read in)))
         (row (first (getf metadata :record-layouts)))
         (record (snowgrave:sg-make-record
                  (snowgrave:make-layout (getf row :identity) (getf row :class)
                                        (getf row :ancestors) (getf row :slots)
                                        :slot-types (getf row :slot-types)
                                        :error-mapping (getf row :error-mapping))))
         (key (getf (first (getf metadata :entries)) :code-key))
         (entry (fdefinition (find-symbol (second key) (first key)))))
    (assert (not (find-class (getf row :class) nil)))
    (assert (not (fboundp (find-symbol "BOUND" "SNOWGRAVE.LAYOUT-MATCHING.FIXTURE"))))
    (assert (not (funcall entry record)))
    (snowgrave:sg-record-write record (first (getf row :slots)) 255)
    (assert (funcall entry record))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh layout without constructor executed.~%")
