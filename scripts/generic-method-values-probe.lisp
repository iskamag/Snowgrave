(require :asdf)
(let* ((root (or (uiop:getenv "SNOWGRAVE_PROBE_SOURCE")
                 (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*))))
       (cache (or (uiop:getenv "SNOWGRAVE_PROBE_CACHE")
                  (merge-pathnames ".build/generic-method-values-probe-fasl/" root))))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave/sbcl")
(defpackage #:snowgrave.generic-method-values-probe (:use #:cl)
  (:shadowing-import-from #:snowgrave #:defclass #:defgeneric #:defmethod))
(let* ((*package* (find-package :snowgrave.generic-method-values-probe))
       (baselinep (equal (uiop:command-line-arguments) '("baseline")))
       (base (intern "BASE")) (leaf (intern "LEAF"))
       (pack (intern "PACK")) (amount (intern "AMOUNT"))
       (entry (intern "ENTRY")) (boot (intern "BOOT"))
       (trace (intern "*TRACE*"))
       (forms (read-from-string
               "((defclass base () ((payload :initarg :payload))) (defclass leaf (base) ())
                  (defparameter *trace* nil)
                  (defgeneric amount (r n))
                  (defmethod amount ((r base) (n number)) (values (+ (slot-value r 'payload) n) :amount))
                  (defgeneric pack (r))
                  (defmethod pack :around ((r leaf))
                    (push :around *trace*)
                    (unwind-protect (call-next-method) (push :cleanup *trace*)))
                  (defmethod pack :before ((r base)) (push :before *trace*) :ignored)
                  (defmethod pack :after ((r base)) (push :after *trace*) (values :ignored :extra))
                  (defmethod pack ((r base)) (push :base *trace*) (values :tag r #'amount))
                  (defmethod pack ((r leaf)) (push :leaf *trace*) (return-from pack (call-next-method)))
                  (defun boot () (make-instance 'leaf :payload 17))
                  (defun entry (r) (multiple-value-bind (tag object callback) (pack r)
                    (values (slot-value object 'payload) (funcall callback object 7) tag))))")))
  (dolist (form forms) (eval form))
  (setf (symbol-value trace) nil)
  (let ((native (multiple-value-list (funcall entry (funcall boot))))
        (effects (reverse (symbol-value trace))))
    (format t "GENERIC-METHOD-VALUES-NATIVE: ~S~%GENERIC-METHOD-EFFECTS-NATIVE: ~S~%" native effects)
    (handler-case
        (let* ((unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(generic-method-values-probe)
                       :closed-classes (list base leaf) :closed-generics (list pack amount)
                       :universe (list base leaf 'number) :entries (list entry boot)
                       :external-domains (list (list entry (list leaf)) (list boot nil)))))
          (setf (symbol-value trace) nil)
          (let ((closed (multiple-value-list (funcall (snowgrave:unit-function unit entry)
                                                      (funcall (snowgrave:unit-function unit boot))))))
            (assert (not baselinep)) (assert (equal native closed))
            (assert (equal effects (reverse (symbol-value trace))))
            (format t "GENERIC-METHOD-VALUES-CLOSED: ~S~%GENERIC-METHOD-EFFECTS-CLOSED: ~S~%"
                    closed (reverse (symbol-value trace)))))
      (snowgrave:snowgrave-error (condition)
        (assert baselinep)
        (assert (member (snowgrave:error-feature condition) '(:computed-function :record-slot-domain)))
        (format t "GENERIC-METHOD-VALUES-REFUSAL: ~S/~S~%" (type-of condition) (snowgrave:error-feature condition))))))
