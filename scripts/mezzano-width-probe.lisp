(require :asdf)
(defun required-directory (name)
  (uiop:ensure-directory-pathname (or (uiop:getenv name) (error "Set ~A to the actual native dependency directory." name))))
(defparameter *native-source* (required-directory "SNOWGRAVE_MEZZANO_SOURCE"))
(defparameter *native-deps* (required-directory "SNOWGRAVE_MEZZANO_DEPS"))
(defparameter *native-iterate* (required-directory "SNOWGRAVE_MEZZANO_ITERATE"))
(defparameter *native-nibbles* (required-directory "SNOWGRAVE_MEZZANO_NIBBLES"))
(defparameter *probe-cache* (uiop:ensure-directory-pathname (or (uiop:getenv "SNOWGRAVE_MEZZANO_CACHE") "/tmp/snowgrave-mezzano-access-cache/")))
(defparameter *source-root* (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
(defparameter *leaf-root* (if (uiop:getenv "SNOWGRAVE_MEZZANO_LEAF_SOURCE")
                             (required-directory "SNOWGRAVE_MEZZANO_LEAF_SOURCE") *source-root*))
(asdf:initialize-source-registry
 `(:source-registry (:directory ,*native-source*) (:directory ,*native-nibbles*) (:directory ,*native-iterate*)
   ,@(mapcar (lambda (name) `(:directory ,(merge-pathnames name *native-deps*)))
             '("cl-ppcre/" "alexandria/" "closer-mop/" "trivial-gray-streams/")) :ignore-inherited-configuration))
(asdf:initialize-output-translations
 `(:output-translations (t (,(namestring (merge-pathnames "asdf-tree/" *probe-cache*)) :implementation)) :ignore-inherited-configuration))
(asdf:load-system "lispos")
(let ((*default-pathname-defaults* *native-source*) (*compile-verbose* nil) (*compile-print* nil))
  (cold-generator:set-up-cross-compiler :architecture :x86-64))
(assert (not (find-package "WONDERWORLD")))
(assert (not (find-package "THREST")))
(dolist (name '("scope" "entries" "records" "arrays" "arithmetic"))
  (mezzano.compiler::load-for-cross-compiler
   (merge-pathnames (format nil "adapters/mezzano-access/~A.lisp" name) *leaf-root*) :verbose nil :print nil))
(mezzano.compiler::load-for-cross-compiler
 (merge-pathnames "tests/mezzano-width-fixture.lisp" *source-root*) :verbose nil :print nil)
(defun width-symbol (name) (find-symbol name "SNOWGRAVE.MEZZANO-WIDTH-FIXTURE"))
(let* ((class (mezzano.internals::get-structure-type (width-symbol "WIDTHS")))
       (layout (mezzano.clos:class-layout class)))
  (assert (= (mezzano.internals::layout-heap-size layout) 5))
  (loop for slot in (mezzano.clos:class-slots class)
        for offset in '(0 1 2 4 8 12 16 24 32)
        do (assert (= (mezzano.runtime::location-offset (mezzano.clos:slot-definition-location slot)) offset))
           (format t "ACTUAL-NATIVE-LAYOUT ~S type=~S offset=~D location=~D~%"
                   (mezzano.clos:slot-definition-name slot) (mezzano.clos:slot-definition-type slot)
                   offset (mezzano.runtime::location-type (mezzano.clos:slot-definition-location slot))))
  (format t "ACTUAL-NATIVE-RECORD payload=40B header=8B allocation=48B~%"))
(assert (handler-case
            (progn (snowgrave.mezzano-access::install-record-accessors
                    (width-symbol "WIDE") (list (list (width-symbol "WIDE-U64") (width-symbol "U64")))) nil)
          (error () t)))
(assert (null (cross-cl:compiler-macro-function (width-symbol "WIDE-U64"))))
(dolist (type '(bit (unsigned-byte 1) (unsigned-byte 17) (unsigned-byte 32)
                (signed-byte 1) (signed-byte 32)))
  (assert (nth-value 1 (snowgrave.mezzano-access::record-slot-domain type))))
(dolist (type '((unsigned-byte 0) (unsigned-byte 33) (unsigned-byte 64)
                (signed-byte 64) (signed-byte *) (unsigned-byte 8 16)))
  (assert (not (nth-value 1 (snowgrave.mezzano-access::record-slot-domain type)))))
(defun width-emitted-worker (assembly name)
  (let* ((start (or (search (format nil "~%~A:~%" name) assembly) (error "Missing worker ~A" name)))
         (end (or (search "MEZZANO.COMPILER.BACKEND.X86-64::LITERAL-POOL/128" assembly :start2 start)
                  (length assembly))))
    (subseq assembly start end)))
(ensure-directories-exist (merge-pathnames "width-fixture.llf" *probe-cache*))
(let ((mezzano.compiler::*target-architecture* :x86-64)
      (cross-cl:*features* (cons :x86-64 cross-cl:*features*)))
  (dolist (name '("scope" "entries" "records" "arrays" "arithmetic"))
    (mezzano.compiler::cross-compile-file
     (merge-pathnames (format nil "adapters/mezzano-access/~A.lisp" name) *leaf-root*)
     :output-file (merge-pathnames (format nil "~A.llf" name) *probe-cache*) :verbose nil :print nil))
  (let ((assembly (with-output-to-string (out)
                    (let ((*standard-output* out) (mezzano.compiler::*trace-asm* t))
                      (mezzano.compiler::cross-compile-file
                       (merge-pathnames "tests/mezzano-width-fixture.lisp" *source-root*)
                       :output-file (merge-pathnames "width-fixture.llf" *probe-cache*) :verbose nil :print nil)))))
    (with-open-file (out (merge-pathnames "width-fixture.lap" *probe-cache*) :direction :output :if-exists :supersede)
      (write-string assembly out))
    (dolist (slot '("U8" "S8" "U16" "S16" "U17" "S32" "BIT" "U32"))
      (dolist (operation '("READ" "WRITE" "CAS"))
        (let* ((name (format nil "~A-~A" operation slot)) (code (width-emitted-worker assembly name)))
          (dolist (forbidden '(":CALL" ":NAMED-CALL" "ALLOCATE" "%STRUCT-SLOT"))
            (assert (not (search forbidden code))))
          (when (string= operation "CAS") (assert (search "CMPXCHG" code)) (assert (search "LOCK" code)))
          (format t "ACTUAL-NATIVE-EMITTED ~A NO-CALL/NO-ALLOCATOR~%" name))))
    (dolist (name '("ARRAY-READ" "ARRAY-WRITE" "ARRAY-CAS"))
      (let ((code (width-emitted-worker assembly name)))
        (dolist (forbidden '(":CALL" ":NAMED-CALL" "ALLOCATE")) (assert (not (search forbidden code))))
        (when (string= name "ARRAY-CAS") (assert (search "CMPXCHG" code)) (assert (search "LOCK" code)))
        (format t "ACTUAL-NATIVE-EMITTED ~A NO-CALL/NO-ALLOCATOR~%" name)))
    (assert (search "%STRUCT-SLOT" (width-emitted-worker assembly "ORDINARY-WIDTH-READ")))))
(format t "MEZZANO-WIDTH-CROSS-PASSED~%")
