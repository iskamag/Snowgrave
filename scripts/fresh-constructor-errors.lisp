(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-constructor-errors-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(load (compile-file (first (uiop:command-line-arguments))))
(let* ((metadata (with-open-file (stream (second (uiop:command-line-arguments))) (read stream)))
       (identity (getf metadata :identity))
       (package (find-package (format nil "SNOWGRAVE.UNIT.~A" (with-standard-io-syntax (write-to-string identity)))))
       (layout (find "CHILD-RECORD" (getf metadata :record-layouts)
                     :key (lambda (layout) (symbol-name (getf layout :class))) :test #'string=)))
  (assert (not (find-class (getf layout :class) nil)))
  (assert (handler-case (funcall (snowgrave.artifact-tests:artifact-function metadata "BOOT"))
            (sb-pcl::initarg-error (condition)
              (and (eq (sb-pcl::initarg-error-class condition) (getf layout :class-token))
                   (equal (sb-pcl::initarg-error-initargs condition) '(:unknown))))))
  (let ((record (funcall (snowgrave.artifact-tests:artifact-function metadata "BOOT-DEFAULT"))))
    (assert (eq (snowgrave:sg-record-class record) (getf layout :class-token))))
  (format t "Fresh constructor errors executed.~%"))
