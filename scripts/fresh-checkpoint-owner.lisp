(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-checkpoint-owner-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "CLAMSARA")))
(destructuring-bind (source metadata expected) (uiop:command-line-arguments)
  (multiple-value-bind (artifact warnings failure)
      (compile-file source :output-file (merge-pathnames ".build/fresh-checkpoint-owner.fasl" (asdf:system-source-directory "snowgrave")))
    (declare (ignore warnings)) (assert (not failure)) (load artifact))
  (let* ((unit (with-open-file (stream metadata) (read stream)))
         (observations (with-open-file (stream expected) (read stream)))
         (base (funcall (snowgrave.artifact-tests:artifact-function unit "CHECKPOINT-PROOF-BOOT")))
         (child (funcall (snowgrave.artifact-tests:artifact-function unit "CHECKPOINT-PROOF-BOOT-CHILD")))
         (objects (list base child nil 0)))
    (dolist (name '("COMPOSED-BARRIER" "CHECKPOINT-PROOF-CHILD"))
      (assert (not (find-class (find-symbol name "CLAMSARA") nil))))
    (dolist (name '("CHECKPOINT-OWNER-SUPPORTED-P" "CHECKPOINT-PROOF-ENTRY" "CHECKPOINT-PROOF-BOOT" "CHECKPOINT-FORWARD"))
      (assert (not (fboundp (find-symbol name "CLAMSARA")))))
    (dolist (case observations)
      (destructuring-bind (name index mode values) case
        (assert (equal values
                       (multiple-value-list
                        (if (equal name "CHECKPOINT-PROOF-ENTRY")
                            (funcall (snowgrave.artifact-tests:artifact-function unit name) (nth index objects) mode)
                            (funcall (snowgrave.artifact-tests:artifact-function unit name) (nth index objects))))))))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh actual checkpoint owner executed.~%")
