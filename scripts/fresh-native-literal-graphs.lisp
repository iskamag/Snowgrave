(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-native-literal-graphs-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.LITERAL-GRAPH.FIXTURE")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (multiple-value-bind (artifact warnings failure)
      (compile-file source :output-file (merge-pathnames ".build/fresh-native-literal-graphs.fasl"
                                                        (asdf:system-source-directory "snowgrave")))
    (declare (ignore warnings)) (assert (not failure)) (load artifact))
  (let* ((unit (with-open-file (stream metadata) (read stream)))
         (root (funcall (snowgrave.artifact-tests:artifact-function unit "ROOT")))
         (alias (funcall (snowgrave.artifact-tests:artifact-function unit "ALIAS")))
         (other (funcall (snowgrave.artifact-tests:artifact-function unit "OTHER"))))
    (let* ((record (funcall (snowgrave.artifact-tests:artifact-function unit "BOOT")))
           (values (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function unit "READ-ROOT") record))))
      (assert (every (lambda (value) (eq value root)) values))
      (assert (not (find-class (find-symbol "NODE" "SNOWGRAVE.LITERAL-GRAPH.FIXTURE") nil))))
    (assert (equal '(t nil nil nil t)
                   (multiple-value-list (funcall (snowgrave.artifact-tests:artifact-function unit "OBSERVE")))))
    (assert (eq root alias)) (assert (not (eq root other)))
    (assert (eq (svref root 0) (cdr (svref root 0))))
    (assert (eq (svref root 1) (svref (svref root 1) 0)))
    (assert (eq root (row-major-aref (svref root 8) 0)))
    (assert (eq (svref root 3) (array-displacement (svref root 4))))
    (assert (eq (svref root 12) (array-displacement (svref root 13))))
    (assert (eq (svref root 13) (svref (svref root 12) 3)))
    (assert (eq (svref root 13) (array-displacement (svref root 14))))
    (assert (char= #\h (row-major-aref (svref root 3) 7)))
    (assert (= 5 (aref (svref root 6) 1)))
    (assert (equal '(1 0 1 0 1) (coerce (svref root 7) 'list)))
    (assert (= 1 (array-total-size (svref root 9))))
    (assert (not (eq (svref root 10) (svref root 11))))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh native literal graphs executed.~%")
