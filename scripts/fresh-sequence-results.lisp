(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-sequence-results-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.SEQUENCE-RESULT.FIXTURE")))
(destructuring-bind (source metadata) (uiop:command-line-arguments)
  (load (compile-file source :output-file (merge-pathnames ".build/fresh-sequence-results.fasl" (asdf:system-source-directory "snowgrave"))))
  (let ((unit (with-open-file (stream metadata) (read stream))))
    (loop for name in '("LIST-REVERSE" "IDENTITY-LISTSTAR" "IDENTITY-APPEND" "LISTSTAR-PAIR" "APPEND-CONS-TAIL"
                        "APPEND-LIST-TAIL" "APPEND-EMPTY" "VECTOR-REVERSE" "STRING-REVERSE")
          for args in (list '((1 2)) '((1 2)) '((1 2)) '(1 :tail) '((1 2) :tail) '(nil (8 9)) nil
                            (list (vector 1 2)) '("abc"))
          for expected in (list '((2 1) :list) '((1 2) :list) '((1 2) :list) '((1 . :tail) :list)
                                '((1 2 . :tail) :list) '((8 9) :list) '(nil :list) (list (vector 2 1) :vector) '("cba" :vector))
          for original = (find-symbol name "SNOWGRAVE.SEQUENCE-RESULT.FIXTURE")
          do (assert (not (fboundp original)))
             (assert (equalp (multiple-value-list (apply (snowgrave.artifact-tests:artifact-function unit original) args)) expected)))
    (let ((value (list 1 2)))
      (dolist (name '("IDENTITY-LISTSTAR" "IDENTITY-APPEND"))
        (assert (eq (funcall (snowgrave.artifact-tests:artifact-function unit name) value) value)))
      (assert (eq (funcall (snowgrave.artifact-tests:artifact-function unit "APPEND-LIST-TAIL") nil value) value)))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh sequence result domains executed.~%")
