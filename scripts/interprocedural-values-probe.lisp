(require :asdf)
(let* ((root (or (uiop:getenv "SNOWGRAVE_PROBE_SOURCE")
                 (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *load-truename*))))
       (cache (or (uiop:getenv "SNOWGRAVE_PROBE_CACHE")
                  (merge-pathnames ".build/interprocedural-values-probe-fasl/" root))))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave/sbcl")
(defpackage #:snowgrave.interprocedural-values-probe (:use #:cl) (:shadowing-import-from #:snowgrave #:defclass #:defgeneric #:defmethod))
(let* ((*package* (find-package :snowgrave.interprocedural-values-probe))
       (baselinep (equal (uiop:command-line-arguments) '("baseline")))
       (class (intern "RECORD")) (generic (intern "VALUE")) (entry (intern "ENTRY")) (boot (intern "BOOT"))
       (forms (read-from-string "((defclass record () ((payload :initarg :payload)))
              (defgeneric value (r)) (defmethod value ((r record)) (slot-value r 'payload))
              (defun relay (r) (pack r))
              (defun pack (r) (values :tag r #'value))
              (defun boot () (make-instance 'record :payload 17))
              (defun entry (r) (multiple-value-bind (tag object function missing) (relay r)
                 (values (funcall function object) tag missing))))")))
  (dolist (form forms) (eval form))
  (let ((ordinary (multiple-value-list (funcall entry (funcall boot)))))
    (format t "ORDINARY-INTERPROCEDURAL-VALUES: ~S~%" ordinary)
    (handler-case
        (let* ((unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(interprocedural-values-probe)
                       :closed-classes (list class) :closed-generics (list generic) :universe (list class)
                       :entries (list entry boot) :external-domains (list (list entry (list class)) (list boot nil))))
               (closed (multiple-value-list (funcall (snowgrave:unit-function unit entry) (funcall (snowgrave:unit-function unit boot))))))
          (assert (not baselinep)) (assert (equal ordinary closed)) (format t "CLOSED-INTERPROCEDURAL-VALUES: ~S~%" closed))
      (snowgrave:snowgrave-error (condition)
        (assert baselinep) (assert (eq (snowgrave:error-feature condition) :computed-function))
        (format t "INTERPROCEDURAL-VALUES-REFUSAL: ~S/~S~%" (type-of condition) (snowgrave:error-feature condition))))))
