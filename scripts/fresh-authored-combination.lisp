(require :asdf)
(let* ((root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname *load-truename*)))
       (cache (merge-pathnames ".build/fresh-authored-combination-fasl/" root)))
  (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
  (asdf:initialize-output-translations `(:output-translations (t ,cache) :ignore-inherited-configuration)))
(asdf:load-system "snowgrave")
(load (merge-pathnames "artifact-functions.lisp" *load-truename*))
(assert (not (find-package "SNOWGRAVE.AUTHORED-COMBINATIONS.FIXTURE")))
(destructuring-bind (source metadata-file) (uiop:command-line-arguments)
  (load (compile-file source))
  (let* ((*read-eval* nil)
         (metadata (with-open-file (stream metadata-file) (read stream)))
         (record (funcall (snowgrave.artifact-tests:artifact-function metadata "BOOT"))))
    (assert (equal (multiple-value-list
                    (funcall (snowgrave.artifact-tests:artifact-function metadata "RUN") record))
                   '(105 :primary)))
    (assert (= 60 (funcall (snowgrave.artifact-tests:artifact-function metadata "CURRENT-VALUE") record)))
    (let ((package (find-package "SNOWGRAVE.AUTHORED-COMBINATIONS.FIXTURE")))
      (assert (not (find-class (find-symbol "COUNTER" package) nil)))
      (assert (not (fboundp (find-symbol "EXECUTE" package)))))))
(assert (not (fboundp 'snowgrave.sbcl:close-source)))
(format t "Fresh authored combination executed.~%")
