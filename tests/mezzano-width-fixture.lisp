;;;; Real native declarations; no simulator layout or projected parent.
(defpackage #:snowgrave.mezzano-width-fixture (:use #:cl) (:export #:run))
(in-package #:snowgrave.mezzano-width-fixture)
(defstruct (widths :sealed (:area :wired))
  (u8 0 :type (unsigned-byte 8)) (s8 0 :type (signed-byte 8))
  (u16 0 :type (unsigned-byte 16)) (s16 0 :type (signed-byte 16))
  (u17 0 :type (unsigned-byte 17)) (s32 0 :type (signed-byte 32))
  (bit 0 :type bit) boxed (u32 0 :type (unsigned-byte 32)))
(snowgrave.mezzano-access:define-record-accessors widths
  ((widths-u8 u8) (widths-s8 s8) (widths-u16 u16) (widths-s16 s16)
   (widths-u17 u17) (widths-s32 s32) (widths-bit bit) (widths-boxed boxed) (widths-u32 u32)))
(defstruct (wide :sealed (:area :wired)) (u64 0 :type (unsigned-byte 64)))

(defmacro define-width-workers (slot)
  (let ((accessor (intern (format nil "WIDTHS-~A" slot)))
        (read (intern (format nil "READ-~A" slot)))
        (write (intern (format nil "WRITE-~A" slot)))
        (cas (intern (format nil "CAS-~A" slot))))
    `(progn
       (snowgrave.mezzano-access:define-admitted-entry ,read (object) (values nil :bad-count)
         (snowgrave.mezzano-access:with-admitted-access (return-from ,read (values nil :invalid))
           (,accessor object)))
       (snowgrave.mezzano-access:define-admitted-entry ,write (object value) (values nil :bad-count)
         (snowgrave.mezzano-access:with-admitted-access (return-from ,write (values nil :invalid))
           (setf (,accessor object) value)))
       (snowgrave.mezzano-access:define-admitted-entry ,cas (object old new) (values nil :bad-count)
         (snowgrave.mezzano-access:with-admitted-access (return-from ,cas (values nil :invalid))
           (mezzano.internals::cas (,accessor object) old new))))))
(define-width-workers u8) (define-width-workers s8)
(define-width-workers u16) (define-width-workers s16)
(define-width-workers u17) (define-width-workers s32)
(define-width-workers bit) (define-width-workers u32)
(snowgrave.mezzano-access:define-admitted-entry array-read (object index) (values nil :bad-count)
  (snowgrave.mezzano-access:with-admitted-access (return-from array-read (values nil :invalid))
    (aref object index)))
(snowgrave.mezzano-access:define-admitted-entry array-write (object index value) (values nil :bad-count)
  (snowgrave.mezzano-access:with-admitted-access (return-from array-write (values nil :invalid))
    (setf (aref object index) value)))
(snowgrave.mezzano-access:define-admitted-entry array-cas (object index old new) (values nil :bad-count)
  (snowgrave.mezzano-access:with-admitted-access (return-from array-cas (values nil :invalid))
    (mezzano.internals::cas (aref object index) old new)))
(defun ordinary-width-read (object) (widths-u32 object))
