(in-package #:snowgrave.tests)

(defun literal-identity-tests ()
  (let* ((*package* (or (find-package "SNOWGRAVE.LITERAL.IDENTITY")
                       (make-package "SNOWGRAVE.LITERAL.IDENTITY" :use '("COMMON-LISP"))))
         (text (copy-seq "same"))
         (other-text (copy-seq text))
         (tail (list text))
         (left (cons :head tail))
         (right (cons :head tail))
         (graph (vector left right text other-text))
         (other-graph (copy-seq graph))
         (entry (intern "OBSERVE"))
         (eqstr (intern "EQSTR")) (eqlist (intern "EQLIST"))
         (left-entry (intern "LEFT"))
         (right-entry (intern "RIGHT"))
         (other-entry (intern "OTHER"))
         (box (intern "BOX"))
         (a (intern "A")) (b (intern "B")) (c (intern "C"))
         (boot (intern "BOOT"))
         (forms (append
                 ;; Read here so the test file's compiler cannot merge the
                 ;; very literals whose identity is under test.
                 (read-from-string
                  "((defun eqstr () (eq \"a\" \"a\"))
                    (defun eqlist () (eq '(1 2) '(1 2))))")
                 `((defclass ,box () ((,a :initform ',left) (,b :initform ',right) (,c :initform ',left)))
                   (defun ,boot () (make-instance ',box))
                   (defun ,left-entry () ,graph)
                   (defun ,right-entry () ',graph)
                   (defun ,other-entry () ,other-graph)
                   (defun ,entry ()
                     (let ((object (,boot)) (graph (,left-entry)))
                       (values (,eqstr) (,eqlist)
                               (eq (,left-entry) (,right-entry))
                               (eq graph (,other-entry))
                               (eq (aref graph 0) (aref graph 1))
                               (eq (cdr (aref graph 0)) (cdr (aref graph 1)))
                               (eq (aref graph 2) (aref graph 3))
                               (eq (aref graph 2) (car (cdr (aref graph 0))))
                               (eq (slot-value object ',a) (aref graph 0))
                               (eq (slot-value object ',a) (slot-value object ',c))
                               (eq (slot-value object ',a) (slot-value object ',b))))))))
         (unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(literal-identity)
                 :closed-classes (list box) :universe (list box)
                 :entries (list entry left-entry right-entry other-entry)
                 :external-domains (mapcar (lambda (name) (list name nil))
                                          (list entry left-entry right-entry other-entry)))))
    (dolist (form forms) (eval form))
    (let ((expected (multiple-value-list (funcall entry))))
      (check (equal expected '(nil nil t nil nil t nil t t t nil)))
      (check (equal expected (multiple-value-list (funcall (snowgrave:unit-function unit entry)))))
      (check (not (eq graph (funcall (snowgrave:unit-function unit left-entry)))))
      (check (equalp (funcall (snowgrave:unit-function unit left-entry))
                     (funcall (snowgrave:unit-function unit other-entry))))
      ;; Neither the source owner nor a public source copy owns installed data.
      (setf (char text 0) #\X)
      (check (string= "same" (aref (funcall (snowgrave:unit-function unit left-entry)) 2)))
      (labels ((change-string (form)
                 (cond ((stringp form) (setf (char form 0) #\Y))
                       ((consp form) (change-string (car form)) (change-string (cdr form))))))
        (change-string (snowgrave:unit-source unit)))
      (check (string= "same" (aref (funcall (snowgrave:unit-function unit left-entry)) 2)))
      (let* ((root (asdf:system-source-directory "snowgrave"))
             (source (merge-pathnames ".build/fresh-literal-identity.lisp" root))
             (metadata (merge-pathnames ".build/fresh-literal-identity.metadata" root)))
        (with-open-file (out source :direction :output :if-exists :supersede)
          (snowgrave:write-unit-source unit out))
        (with-open-file (out metadata :direction :output :if-exists :supersede)
          (snowgrave:write-unit-metadata unit out))
        (check (search "Fresh literal identity executed."
                       (uiop:run-program
                        (list "sbcl" "--no-sysinit" "--no-userinit" "--script"
                              (namestring (merge-pathnames "scripts/fresh-literal-identity.lisp" root))
                              (namestring source) (namestring metadata)) :output :string)))))))
