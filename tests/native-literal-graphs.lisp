(defpackage #:snowgrave.literal-graph.fixture (:use #:cl))
(in-package #:snowgrave.tests)

(defun literal-graph-fixture ()
  (let* ((ring (cons :ring nil)) (self (vector nil nil))
         (mixed (cons self ring))
         (text (make-array 8 :element-type 'base-char :adjustable t :fill-pointer 3
                            :initial-contents "abcdefgh"))
         (text-view (make-array 3 :element-type 'base-char :displaced-to text :displaced-index-offset 2))
         (bytes (make-array '(2 3) :element-type '(unsigned-byte 8) :initial-contents '((1 2 3) (4 5 6))))
         (byte-view (make-array 2 :element-type '(unsigned-byte 8) :displaced-to bytes :displaced-index-offset 3))
         (bits (make-array 5 :element-type 'bit :initial-contents '(1 0 1 0 1)))
         (scalar (make-array nil))
         (empty-values (make-array 1 :element-type nil))
         (parent (vector :p :q :r nil))
         (view (make-array 2 :adjustable t :fill-pointer 1 :displaced-to parent :displaced-index-offset 1))
         (chain (make-array 1 :displaced-to view :displaced-index-offset 1))
         (root (vector ring self mixed text text-view bytes byte-view bits scalar empty-values
                       (copy-seq "same") (copy-seq "same") parent view chain)))
    (setf (cdr ring) ring (svref self 0) self (svref self 1) mixed
          (row-major-aref scalar 0) root (svref parent 3) view)
    root))

(defun literal-array-description (array)
  (list (array-dimensions array) (array-element-type array)
        (not (null (adjustable-array-p array)))
        (not (null (array-has-fill-pointer-p array)))
        (when (array-has-fill-pointer-p array) (fill-pointer array))
        (nth-value 1 (array-displacement array))))

(defun check-native-literal-graph (root)
  (let ((ring (svref root 0)) (self (svref root 1)) (mixed (svref root 2)))
    (check (eq ring (cdr ring))) (check (eq self (svref self 0)))
    (check (eq mixed (svref self 1))) (check (eq self (car mixed)))
    (check (eq ring (cdr mixed)))
    (check (eq root (row-major-aref (svref root 8) 0)))
    (check (eq (svref root 3) (array-displacement (svref root 4))))
    (check (eq (svref root 5) (array-displacement (svref root 6))))
    (check (eq (svref root 12) (array-displacement (svref root 13))))
    (check (eq (svref root 13) (svref (svref root 12) 3)))
    (check (eq (svref root 13) (array-displacement (svref root 14))))
    (check (not (eq (svref root 10) (svref root 11))))
    (check (string= (svref root 4) "cde"))
    (check (= 8 (array-total-size (svref root 3))))
    (check (char= #\h (row-major-aref (svref root 3) 7)))
    (check (= 5 (aref (svref root 6) 1)))
    (check (equal '(1 0 1 0 1) (coerce (svref root 7) 'list)))
    (check (= 1 (array-total-size (svref root 9))))
    (check (eq :r (aref (svref root 14) 0)))))

(defun native-literal-graph-tests ()
  (let* ((*package* (find-package :snowgrave.literal-graph.fixture))
         (root (literal-graph-fixture)) (other (copy-seq root))
         (node (intern "NODE")) (payload (intern "PAYLOAD")) (peer (intern "PEER")) (extra (intern "EXTRA"))
         (forms (append `((defclass ,node () ((,payload :initform ',root) (,peer :type ,node)
                                              (,extra :initarg :extra))
                            (:default-initargs :extra ',root))
                          (defun ,(intern "BOOT") () (make-instance ',node))
                          (defun ,(intern "READ-ROOT") (object)
                            (values (slot-value object ',payload) (slot-value object ',extra)))
                          (defun ,(intern "ROOT") () ',root)
                          (defun ,(intern "ALIAS") () ,root)
                          (defun ,(intern "OTHER") () ',other))
                        (list (read-from-string "(defun observe ()
                    (let ((root (root)))
                      (values (eq root (alias)) (eq root (other))
                              (typep (svref root 3) 'simple-base-string)
                              (typep (svref root 4) 'simple-base-string)
                              (typep (svref root 10) 'simple-string))))"))))
         (entries (mapcar #'intern '("ROOT" "ALIAS" "OTHER" "OBSERVE" "BOOT" "READ-ROOT")))
         (unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(native-literal-graphs)
                 :closed-classes (list node) :universe (list node)
                 :entries entries :external-domains
                 (mapcar (lambda (entry) (list entry (when (eq entry (intern "READ-ROOT")) (list node)))) entries))))
    (dolist (form forms) (eval form))
    (check (equal '(t nil nil nil t) (multiple-value-list (funcall (intern "OBSERVE")))))
    (check (equal (multiple-value-list (funcall (intern "OBSERVE")))
                  (multiple-value-list (funcall (snowgrave:unit-function unit (intern "OBSERVE"))))))
    (let ((closed (funcall (snowgrave:unit-function unit (intern "ROOT")))))
      (let* ((record (funcall (snowgrave:unit-function unit (intern "BOOT"))))
             (values (multiple-value-list (funcall (snowgrave:unit-function unit (intern "READ-ROOT")) record)))
             (layout (first (getf (snowgrave:unit-metadata unit) :record-layouts))))
        (check (every (lambda (value) (eq value closed)) values))
        (check (not (snowgrave:sg-record-boundp record peer)))
        (check (null (getf layout :slot-initforms)))
        (check (equal (getf layout :slot-initializer-keys) '(((native-literal-graphs) 1) nil nil)))
        (check (equal (getf layout :default-initializer-keys) '((:extra ((native-literal-graphs) 1))))))
      (check-native-literal-graph closed)
      (check (eq closed (funcall (snowgrave:unit-function unit (intern "ALIAS")))))
      (check (not (eq closed (funcall (snowgrave:unit-function unit (intern "OTHER"))))))
      (check (eq (svref closed 0) (svref (funcall (snowgrave:unit-function unit (intern "OTHER"))) 0)))
      (loop for original across root for copied across closed when (arrayp original) do
        (check (equal (literal-array-description original) (literal-array-description copied))))
      (check (not (eq root closed)))
      (setf (row-major-aref (svref root 3) 7) #\X)
      (check (char= #\h (row-major-aref (svref closed 3) 7))))
    (let* ((directory (asdf:system-source-directory "snowgrave"))
           (source (merge-pathnames ".build/fresh-native-literal-graphs.lisp" directory))
           (metadata (merge-pathnames ".build/fresh-native-literal-graphs.metadata" directory)))
      (with-open-file (stream source :direction :output :if-exists :supersede) (snowgrave:write-unit-source unit stream))
      (with-open-file (stream metadata :direction :output :if-exists :supersede) (snowgrave:write-unit-metadata unit stream))
      (check (search "Fresh native literal graphs executed."
                     (uiop:run-program
                      (list "sbcl" "--no-sysinit" "--no-userinit" "--script"
                            (namestring (merge-pathnames "scripts/fresh-native-literal-graphs.lisp" directory))
                            (namestring source) (namestring metadata)) :output :string)))))
  ;; A failed cyclic traversal must not publish a partial SCC as validated.
  (let* ((a (cons nil nil)) (b (cons a nil)) (memo (make-hash-table :test #'eq)))
    (setf (car a) b (cdr a) #'identity)
    (check (not (snowgrave.sbcl::serializable-literal-graph-p a memo)))
    (check (not (snowgrave.sbcl::serializable-literal-graph-p b memo))))
  ;; Uniform backing needs compact initialization rather than one code form
  ;; per cell; a real word arena is predominantly empty at installation.
  (let* ((data (make-array 8192 :initial-element nil))
         (entry 'snowgrave.literal-graph.fixture::large)
         (unit (progn (setf (aref data 8191) data)
                      (snowgrave:close-source-unit (list :forms `((defun ,entry () ',data)))
                        :unit-name '(large-native-literal) :entries (list entry)
                        :external-domains (list (list entry nil))))))
    (check (< (length (with-output-to-string (stream) (snowgrave:write-unit-source unit stream))) 20000))
    (let ((closed (funcall (snowgrave:unit-function unit entry))))
      (check (eq closed (aref closed 8191)))
      (check (null (aref closed 4000)))))
  ;; Displacement is an allocation dependency, not an element back edge.
  (let* ((a (make-array 1 :adjustable t)) (b (make-array 1 :displaced-to a)))
    (adjust-array a 1 :displaced-to b)
    (signals snowgrave:nonreproducible-source (snowgrave::immutable-copy a)))
  ;; Native graph support does not admit opaque leaves or cyclic unit names.
  (dolist (bad (list (vector #'identity) (vector (make-symbol "UNINTERNED"))
                    (make-array 2 :fill-pointer 0 :initial-contents (list #'identity nil))
                    (make-array 1 :displaced-to (vector nil (make-symbol "HIDDEN")))))
    (signals snowgrave:residual-metaobject
      (snowgrave:close-source-unit (list :forms `((defun snowgrave.literal-graph.fixture::bad () ',bad)))
        :unit-name (list :bad-graph (type-of (aref bad 0))) :entries '(snowgrave.literal-graph.fixture::bad)
        :external-domains '((snowgrave.literal-graph.fixture::bad nil)))))
  (let ((identity (list :cycle)))
    (setf (cdr identity) identity)
    (signals snowgrave:nonreproducible-source
      (snowgrave:close-source-unit '(:forms ((defun snowgrave.literal-graph.fixture::unused () 7)))
        :unit-name identity :entries '(snowgrave.literal-graph.fixture::unused)
        :external-domains '((snowgrave.literal-graph.fixture::unused nil))))))
