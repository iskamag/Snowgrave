(in-package #:snowgrave.tests)

(defun predicate-refinement-tests ()
  (let* ((*package* (or (find-package "SNOWGRAVE.PREDICATE.FIXTURE")
                       (make-package "SNOWGRAVE.PREDICATE.FIXTURE" :use '("COMMON-LISP"))))
         (forms (read-from-string
           "((defclass box () ((payload :initform 17))) (defclass child (box) ())
             (defclass cell () ((held :initarg :held))) (defparameter *log* nil)
             (defun boot () (make-instance 'box)) (defun boot-child () (make-instance 'child))
             (defun boot-cell (value) (make-instance 'cell :held value))
             (defun observe (owner) (push :read *log*) (slot-value owner 'held))
             (defun guard-and (owner expected)
               (let ((held (observe owner))) (and (typep held 'box) (eq expected held))))
             (defun guard-if (owner expected)
               (let ((held (observe owner))) (if (typep held 'box) (eq expected held) nil)))
             (defun guard-cond (owner expected)
               (let ((held (observe owner))) (cond ((typep held 'box) (eq expected held)) (t nil))))
             (defun guard-when (owner expected)
               (let ((held (observe owner))) (when (typep held 'box) (eq expected held))))
             (defun guard-unless (owner expected)
               (let ((held (observe owner))) (unless (not (typep held 'box)) (eq expected held))))
             (defun guard-or (owner expected)
               (let ((held (observe owner))) (or (not (typep held 'box)) (eq expected held))))
             (defun guard-null (owner expected)
               (let ((held (observe owner))) (unless (null (typep held 'box)) (eq expected held))))
             (defun guard-parallel (owner expected)
               (let ((held (observe owner)))
                 (let ((held nil) (same (and (typep held 'box) (eq expected held))))
                   (declare (special held)) same)))
             (defgeneric guarded-method (owner expected))
             (defmethod guarded-method ((owner cell) (expected box))
               (let ((held (observe owner))) (and (typep held 'box) (eq expected held))))
             (defun guard-method (owner expected) (guarded-method owner expected))
             (defun native-tag (owner)
               (let ((held (observe owner)))
                 (values (eq :tag held) (eql :tag held) (equal :tag held) (equalp :tag held)
                         (eql 17 held) (equal 17 held) (equalp 17 held)
                         (eql #\\a held) (equalp #\\A held))))
             (defun guarded-pack (value)
               (if (typep value 'box) (values value :box) (values nil :foreign)))
             (defun guarded-escape (value)
               (when (typep value 'box) (return-from guarded-escape (values value :box)))
               (values nil :foreign))
             (defun use-pack (owner)
               (multiple-value-bind (object tag) (guarded-pack (observe owner))
                 (values (if (typep object 'box) (slot-value object 'payload) nil) tag)))
             (defun use-escape (owner)
               (multiple-value-bind (object tag) (guarded-escape (observe owner))
                 (values (if (typep object 'box) (slot-value object 'payload) nil) tag)))
             (defun with-environment (object)
               (values (typep (progn (push :object *log*) object) 'box
                              (progn (push :environment *log*) nil)) (reverse *log*)))
             (defun local-typep (object)
               (flet ((typep (value kind) (declare (ignore value kind)) :custom))
                 (typep object 'box))))"))
         (classes (mapcar #'intern '("BOX" "CHILD" "CELL")))
         (guards (mapcar #'intern '("GUARD-AND" "GUARD-IF" "GUARD-COND" "GUARD-WHEN"
                                   "GUARD-UNLESS" "GUARD-OR" "GUARD-NULL" "GUARD-PARALLEL" "GUARD-METHOD")))
         (uses (mapcar #'intern '("USE-PACK" "USE-ESCAPE" "NATIVE-TAG")))
         (boot (intern "BOOT")) (child (intern "BOOT-CHILD")) (cell (intern "BOOT-CELL"))
         (environment (intern "WITH-ENVIRONMENT")) (local (intern "LOCAL-TYPEP"))
         (log (intern "*LOG*"))
         (entries (append (list boot child cell environment local) guards uses)))
    (sb-ext:without-package-locks
      (dolist (form forms) (eval form))
      (let* ((unit (snowgrave:close-source-unit
                    (list :forms forms) :unit-name '(predicate-refinement)
                    :closed-classes classes :universe classes :entries entries
                    :closed-generics (list (intern "GUARDED-METHOD"))
                    :external-operations '(gensym)
                    :external-domains
                    (append (list (list boot nil) (list child nil) (list cell '(t))
                                  (list environment '(t)) (list local '(t)))
                            (mapcar (lambda (name) (list name (list (third classes) (first classes)))) guards)
                            (mapcar (lambda (name) (list name (list (third classes)))) uses))))
             (natives (list (funcall boot) (funcall child)))
             (records (list (funcall (snowgrave:unit-function unit boot))
                            (funcall (snowgrave:unit-function unit child)))))
        (loop for expected in natives for record in records do
          (loop for held in (append (list nil 17 :foreign :tag #\a (vector :native)) natives)
                for lowered in (append (list nil 17 :foreign :tag #\a (vector :native)) records) do
            (let ((native-cell (funcall cell held))
                  (record-cell (funcall (snowgrave:unit-function unit cell) lowered)))
              (dolist (entry (append guards uses))
                (let ((native
                        (progv (list log) (list nil)
                          (list (multiple-value-list (if (member entry guards)
                                                       (funcall entry native-cell expected)
                                                       (funcall entry native-cell)))
                                (symbol-value log))))
                      (closed
                        (progv (list log) (list nil)
                          (list (multiple-value-list (if (member entry guards)
                                                       (funcall (snowgrave:unit-function unit entry) record-cell record)
                                                       (funcall (snowgrave:unit-function unit entry) record-cell)))
                                (symbol-value log)))))
                  (check (equal native closed))
                  (check (equal (second closed) '(:read))))))))
        (progv (list log) (list nil)
          (check (equal (multiple-value-list (funcall (snowgrave:unit-function unit environment) (first records)))
                        '(t (:object :environment)))))
        (check (eq :custom (funcall (snowgrave:unit-function unit local) (first records))))
        (let* ((root (asdf:system-source-directory "snowgrave"))
               (source (merge-pathnames ".build/fresh-predicate.lisp" root))
               (metadata (merge-pathnames ".build/fresh-predicate.metadata" root)))
          (with-open-file (stream source :direction :output :if-exists :supersede) (snowgrave:write-unit-source unit stream))
          (with-open-file (stream metadata :direction :output :if-exists :supersede) (snowgrave:write-unit-metadata unit stream))
          (check (search "Fresh predicate guards executed."
                         (uiop:run-program
                           (list "sbcl" "--no-sysinit" "--no-userinit" "--script"
                                 (namestring (merge-pathnames "scripts/fresh-predicate.lisp" root))
                                 (namestring source) (namestring metadata)) :output :string))))))
    ;; The entry's slot contents are arbitrary. Neither a declaration nor an
    ;; earlier observation makes a subsequent dynamic read stable.
    (labels ((refused (body &optional prefix feature)
               (let* ((entry (intern "REFUSED"))
                      (source (append (subseq forms 0 4) prefix
                                      (list `(defun ,entry (,(intern "OWNER") ,(intern "EXPECTED")) ,(read-from-string body)))))
                      (condition
                        (sb-ext:without-package-locks
                          (handler-case
                              (snowgrave:close-source-unit (list :forms source) :unit-name (list :predicate-refused body)
                                :closed-classes classes :universe classes :entries (list entry)
                                :external-operations '(gensym)
                                :external-domains (list (list entry (list (third classes) (first classes)))))
                            (snowgrave:snowgrave-error (error) error)))))
                 (check (typep condition 'snowgrave:snowgrave-error))
                 (when feature (check (eq feature (snowgrave:error-feature condition)))))))
      (refused "(let ((held (slot-value owner 'held))) (if (typep held 'box) nil (eq expected held)))")
      (refused "(let ((held (slot-value owner 'held))) (progn (typep held 'box) (eq expected held)))")
      (refused "(let ((held nil)) (declare (special held)) (and (typep held 'box) (eq expected held)))")
      (refused "(let* ((held nil) (same (and (typep held 'box) (eq expected held)))) (declare (special held)) same)")
      (refused "(and (typep *held* 'box) (eq expected *held*))"
               (list `(defparameter ,(intern "*HELD*") nil)))
      (refused "(let ((held (slot-value owner 'held))) (and (typep held 'box) (progn (setq held nil) (eq expected held))))"
               nil :value-domain-mutation)
      (refused "(let ((held (slot-value owner 'held))) (flet ((typep (x y) (declare (ignore x y)) t)) (and (typep held 'box) (eq expected held))))")
      (refused "(typep expected 'box owner)" nil :type-environment)
      (refused "(typep expected 'box nil nil)" nil :typep-arity))))
