(in-package #:snowgrave.tests)

(defun configuration-sharing-tests ()
  (multiple-value-bind (unit package) (publication-fixture)
    (flet ((entry (name) (find-symbol name package))
           (latest () (first (snowgrave::closed-unit-configured-bindings unit))))
      (let* ((construct (snowgrave:unit-function unit (entry "CONSTRUCT")))
             (a (funcall construct)) (b (funcall construct))
             (left (snowgrave:unit-function unit (entry "READ-LEFT")))
             (initial (funcall left a))
             (value (funcall (snowgrave:unit-function unit (entry "READ-RIGHT")) a))
             (one (snowgrave:bind-entry unit (entry "WRITE-LEFT") (list a value)))
             (first (latest))
             (functions (snowgrave::unit-plan-function-sources (snowgrave::closed-unit-plan unit)))
             (two (snowgrave:bind-entry unit (entry "WRITE-LEFT") (list a value)))
             (second (latest))
             (other (snowgrave:bind-entry unit (entry "WRITE-LEFT") (list b value)))
             (third (latest))
             (original (snowgrave::configured-binding-generation first))
             (unrelated (snowgrave::configured-binding-generation third))
             (old-package (snowgrave::configured-generation-package original))
             (roles (fixture-read package "((holder left))")))
        (check (eq original (snowgrave::configured-binding-generation second))
               "Identical binding facts compiled duplicate implementations")
        (check (not (eq (snowgrave::configured-binding-name first) (snowgrave::configured-binding-name second)))
               "Shared code lost independent publication targets")
        (check (not (eq original unrelated)) "Different argument identities shared an implementation")
        (check (eq functions (snowgrave::unit-plan-function-sources (snowgrave::closed-unit-plan unit)))
               "Binding rebuilt the immutable source index")
        (check (null (snowgrave::function-source-normalized
                      (gethash (snowgrave::configuration-entry-name unit (entry "CONSTRUCT")) functions)))
               "Binding normalized an unreachable constructor entry")
        (check (and (eq value (funcall one)) (eq value (funcall two))) "Shared implementation changed its result")
        (funcall (snowgrave:unit-function unit (entry "WRITE-LEFT")) a initial)
        (let ((reader nil) (retired 0) (discard (fdefinition 'snowgrave::discard-configuration-package)))
          (unwind-protect
               (progn
                 (setf (fdefinition 'snowgrave::discard-configuration-package)
                       (lambda (package)
                         (when (eq package old-package) (incf retired))
                         (funcall discard package)))
                 (setf reader (snowgrave:bind-entry unit (entry "READ-LEFT") (list a) :roles roles)))
            (setf (fdefinition 'snowgrave::discard-configuration-package) discard))
          (check (= 1 retired) "Shared code was retired more than once")
          (check (and (not (eq original (snowgrave::configured-binding-generation first)))
                      (eq (snowgrave::configured-binding-generation first)
                          (snowgrave::configured-binding-generation second)))
                 "Publication duplicated equivalent replacements")
          (check (null (package-name old-package)) "Unreferenced shared implementation was not retired")
          (check (eq unrelated (snowgrave::configured-binding-generation third))
                 "Seal recompiled a writer for an unrelated known receiver")
          (check-signals (error) (funcall one) "First shared target bypassed its new seal")
          (check-signals (error) (funcall two) "Second shared target bypassed its new seal")
          (check (eq value (funcall other)) "Seal affected a different receiver")
          ;; Reuse a live shared implementation, then force bridge compilation
          ;; to fail. Cleanup must not destroy code owned by earlier bindings.
          (let ((compiler (fdefinition 'snowgrave::compile-function))
                (bindings (snowgrave::closed-unit-configured-bindings unit)))
            (unwind-protect
                 (progn
                   (setf (fdefinition 'snowgrave::compile-function)
                         (lambda (name source &optional (feature :compilation))
                           (when (eq feature :configuration-compilation) (error "Injected bridge failure"))
                           (funcall compiler name source feature)))
                   (check-signals (error)
                     (snowgrave:bind-entry unit (entry "WRITE-LEFT") (list b value))
                     "Bridge failure did not abort the new binding"))
              (setf (fdefinition 'snowgrave::compile-function) compiler))
            (check (and (eq bindings (snowgrave::closed-unit-configured-bindings unit))
                        (eq value (funcall other)) (eq initial (funcall reader)))
                   "Failed reuse destroyed previously published code"))
          (check (eq unrelated (snowgrave::configured-binding-generation third))
                 "Failed reuse replaced a live implementation"))))))

(defun configuration-recipe-tests ()
  (multiple-value-bind (unit package) (publication-fixture)
    (flet ((entry (name) (find-symbol name package))
           (generation () (snowgrave::configured-binding-generation
                           (first (snowgrave::closed-unit-configured-bindings unit)))))
      (let* ((root (funcall (snowgrave:unit-function unit (entry "CONSTRUCT"))))
             (one (snowgrave:bind-entry unit (entry "READ-LEFT") (list root)
                                       :roles (fixture-read package "((holder (left right)))")))
             (original (generation))
             (two (snowgrave:bind-entry unit (entry "READ-LEFT") (list root)
                                       :roles (fixture-read package "((holder (right left)))"))))
        (check (eq original (generation)) "Role declaration order prevented equivalent code reuse")
        (check (eq (funcall one) (funcall two)) "Equivalent role maps produced different results"))
      (let* ((root (funcall (snowgrave:unit-function unit (entry "CONSTRUCT")))))
        (snowgrave:bind-entry unit (entry "READ-LEFT") (list root))
        (let ((without-roles (generation)))
          (snowgrave:bind-entry unit (entry "READ-LEFT") (list root)
                               :roles (fixture-read package "((holder left))"))
          (check (not (eq without-roles (generation))) "Different frozen role facts shared code")))
      (let* ((a (copy-seq "same")) (b (copy-seq "same"))
             (one (snowgrave:bind-entry unit (entry "IDENTITY-QUERY") (list a a)))
             (two (snowgrave:bind-entry unit (entry "IDENTITY-QUERY") (list a b))))
        (check (and (eq :same (funcall one)) (eq :different (funcall two)))
               "Code reuse compared argument contents instead of identity")))))

(defun configuration-reassigned-receiver-tests ()
  (multiple-value-bind (unit package) (publication-fixture)
    (flet ((entry (name) (find-symbol name package)))
      (let* ((construct (snowgrave:unit-function unit (entry "CONSTRUCT")))
             (a (funcall construct)) (b (funcall construct))
             (left (snowgrave:unit-function unit (entry "READ-LEFT")))
             (initial (funcall left b))
             (value (funcall (snowgrave:unit-function unit (entry "READ-RIGHT")) b))
             (data (vector b))
             (writer (snowgrave:bind-entry unit (entry "REDIRECTED-WRITE") (list a data value))))
        (let ((reader (snowgrave:bind-entry unit (entry "READ-LEFT") (list b)
                                          :roles (fixture-read package "((holder left))"))))
          (check-signals (error) (funcall writer) "Reassigned receiver kept its original owner dependency")
          (check (eq initial (funcall reader)) "Reassigned write damaged the selected owner's seal")
          (setf (aref data 0) a)
          (check (eq value (funcall writer)) "Conservative dependency blocked an unsealed reassigned owner"))))))

(defun configuration-singleton-role-tests ()
  (multiple-value-bind (unit package)
      (make-fixture
       :singleton-role-owner
       "((defclass node () ((next :initform nil :accessor next)))
          (defclass holder () ((model :initarg :model :reader model)))
          (defun construct () (make-instance 'holder :model (make-instance 'node)))
          (defun new-node () (make-instance 'node))
          (defun component (h) (model h))
          (defun write-next (h value) (setf (next (model h)) value))
          (defun read-next (n) (next n))
          (defun set-next (n value) (setf (next n) value)))"
       "(construct new-node component write-next read-next set-next)"
       "((construct ()) (new-node ()) (component (holder)) (write-next (holder t))
          (read-next (node)) (set-next (node t)))" "(next (setf next) model)")
    (flet ((entry (name) (find-symbol name package)))
      (let* ((root (funcall (snowgrave:unit-function unit (entry "CONSTRUCT"))))
             (owner (funcall (snowgrave:unit-function unit (entry "COMPONENT")) root))
             (other (funcall (snowgrave:unit-function unit (entry "NEW-NODE"))))
             (value (funcall (snowgrave:unit-function unit (entry "NEW-NODE"))))
             (writer (snowgrave:bind-entry unit (entry "WRITE-NEXT") (list root value)
                                          :roles (fixture-read package "((holder model))")))
             (recipe (first (snowgrave::closed-unit-configured-bindings unit)))
             (generation (snowgrave::configured-binding-generation recipe))
             (roles (fixture-read package "((node next))")))
        (snowgrave:bind-entry unit (entry "READ-NEXT") (list other) :roles roles)
        (check (eq generation (snowgrave::configured-binding-generation recipe))
               "Singleton role identity was lost through its accessor")
        (check (eq value (funcall writer)) "Unsealed data behind a singleton role stopped being mutable")
        (funcall (snowgrave:unit-function unit (entry "SET-NEXT")) owner nil)
        (let ((reader (snowgrave:bind-entry unit (entry "READ-NEXT") (list owner) :roles roles)))
          (check-signals (error) (funcall writer) "Singleton receiver lost its own mutation dependency")
          (check (null (funcall reader)) "Singleton receiver mutation damaged its new seal"))))))

(defun configuration-cache-tests ()
  (configuration-sharing-tests)
  (configuration-recipe-tests)
  (configuration-reassigned-receiver-tests)
  (configuration-singleton-role-tests))
