(in-package #:snowgrave.tests)

(defun run-tests ()
  (let ((*checks* 0))
    (method-linkage-tests)
    (method-combination-tests)
    (record-tests)
    (dynamic-record-tests)
    (typed-storage-tests)
    (typed-method-tests)
    (argument-tests)
    (bounded-call-tests)
    (slot-helper-tests)
    (literal-scale-tests)
    (configuration-tests)
    (configuration-publication-tests)
    (configuration-contour-tests)
    (configuration-shared-helper-tests)
    (configured-accessor-tests)
    (portable-source-tests)
    (control-tests)
    (binding-tests)
    (native-partition-tests)
    (method-boundary-tests)
    (constant-tests)
    (logical-equalp-tests)
    (logical-metadata-tests)
    (frozen-macro-tests)
    (fresh-artifact-test)
    (pruned-helper-tests)
    (write-only-slot-test)
    (string-literal-pool-test)
    (self-contained-artifact-tests)
    (package-replay-test)
    (multi-package-replay-test)
    (shared-export-replay-test)
    (reexport-replay-test)
    (rejection-tests)
    (admission-boundary-tests)
    (lifecycle-tests)
    (format t "Snowgrave core: ~D checks passed.~%" *checks*)
    t))
