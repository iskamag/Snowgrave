(in-package #:snowgrave.mezzano-width-fixture)
(mezzano.internals::defglobal *positive-control*)
(defun check (truth reason)
  (unless truth (mezzano.supervisor:panic "Snowgrave width fixture: " reason)))
(defmacro refusal (form)
  `(multiple-value-bind (value reason) ,form
     (check (and (null value) (eq reason :invalid)) :expected-refusal)))
(defmacro width-history (slot minimum maximum)
  (let ((read (intern (format nil "READ-~A" slot)))
        (write (intern (format nil "WRITE-~A" slot)))
        (cas (intern (format nil "CAS-~A" slot))))
    `(progn
       (check (= (,write object ,minimum) ,minimum) :minimum-write)
       (check (= (,read object) ,minimum) :minimum-read)
       (check (= (,cas object ,minimum ,maximum) ,minimum) :cas-success)
       (check (= (,cas object ,minimum ,minimum) ,maximum) :cas-mismatch)
       (check (= (,read object) ,maximum) :maximum-read)
       (refusal (,write object ,(1- minimum)))
       (refusal (,write object ,(1+ maximum)))
       (refusal (,write object :invalid))
       (refusal (,write object #x100000000000000000000))
       (refusal (,cas object ,minimum ,(1+ maximum)))
       (refusal (,cas object ,(1- minimum) ,minimum))
       (check (= (,read object) ,maximum) :refusal-preserves-field)
       (refusal (,read nil)) (refusal (,write foreign ,minimum))
       (multiple-value-bind (value reason) (funcall (function ,read) object :extra)
         (check (and (null value) (eq reason :bad-count)) :count-before-body)))))
(defun record-round (object foreign)
  (width-history u8 0 255) (width-history s8 -128 127)
  (width-history u16 0 65535) (width-history s16 -32768 32767)
  (width-history u17 0 131071) (width-history s32 -2147483648 2147483647)
  (width-history bit 0 1) (width-history u32 0 4294967295)
  ;; A narrower authored range lives in its actual native 32-bit location.
  (setf (mezzano.internals::%%object-ref-unsigned-byte-32-unscaled object 8) 131072)
  (refusal (read-u17 object)) (refusal (cas-u17 object 131071 0))
  (check (= (mezzano.internals::%%object-ref-unsigned-byte-32-unscaled object 8) 131072)
         :corrupt-read-does-not-store)
  (check (= (write-u17 object 131071) 131071) :repair-with-admitted-value)
  ;; Every byte/word store and CAS left its adjacent field intact.
  (check (and (= (read-u8 object) 255) (= (read-s8 object) 127)
              (= (read-u16 object) 65535) (= (read-s16 object) 32767)
              (= (read-s32 object) 2147483647) (= (read-bit object) 1)
              (= (read-u32 object) 4294967295) (eq (widths-boxed object) :boxed))
         :neighbors)
  :passed)
(snowgrave.mezzano-access:define-admitted-entry array-history (object minimum maximum)
    (mezzano.supervisor:panic "Bad fixture arity")
  (check (= (array-write object 1 minimum) minimum) :array-minimum-write)
  (check (= (array-read object 1) minimum) :array-minimum-read)
  (check (= (array-write object 1 maximum) maximum) :array-maximum-write)
  (check (= (array-read object 1) maximum) :array-maximum-read)
  (refusal (array-write object 1 (1- minimum)))
  (refusal (array-write object 1 (1+ maximum)))
  (refusal (array-write object 1 :invalid))
  (refusal (array-write object -1 minimum))
  (refusal (array-write object (array-total-size object) minimum))
  (refusal (array-read object :invalid))
  (refusal (array-read nil 0))
  (check (= (array-read object 1) maximum) :array-refusal-preserves)
  (check (= (array-read object 0) minimum) :array-left-neighbor)
  (check (= (array-read object (1- (array-total-size object))) minimum) :array-right-neighbor))
(defun array-cas-history (object minimum maximum)
  (check (= (array-cas object 1 maximum minimum) maximum) :array-cas-success)
  (check (= (array-cas object 1 maximum maximum) minimum) :array-cas-mismatch)
  (refusal (array-cas object 1 minimum (1+ maximum)))
  (refusal (array-cas object 1 (1- minimum) minimum))
  (refusal (array-cas object -1 minimum maximum))
  (check (= (array-read object 1) minimum) :array-cas-preserves)
  (check (= (array-write object 1 maximum) maximum) :restore-after-cas))
(defun array-round (arrays)
  (array-history (aref arrays 0) 0 1)
  (array-history (aref arrays 1) 0 255)
  (array-history (aref arrays 2) 0 65535)
  (array-history (aref arrays 3) 0 4294967295)
  (array-history (aref arrays 4) -128 127)
  (array-history (aref arrays 5) -32768 32767)
  (array-history (aref arrays 6) -2147483648 2147483647)
  (array-history (aref arrays 7) 0 4294967295)
  (refusal (array-cas (aref arrays 0) 1 1 0))
  (array-cas-history (aref arrays 1) 0 255)
  (array-cas-history (aref arrays 2) 0 65535)
  (array-cas-history (aref arrays 3) 0 4294967295)
  (array-cas-history (aref arrays 4) -128 127)
  (array-cas-history (aref arrays 5) -32768 32767)
  (array-cas-history (aref arrays 6) -2147483648 2147483647)
  (array-cas-history (aref arrays 7) 0 4294967295)
  ;; Cross a byte and machine-word boundary; BIT stores preserve other bits.
  (let ((bits (aref arrays 0)))
    (check (= (array-write bits 7 1) 1) :bit7)
    (check (= (array-write bits 8 1) 1) :bit8)
    (check (= (array-write bits 63 1) 1) :bit63)
    (check (= (array-write bits 64 1) 1) :bit64)
    (check (and (= (array-read bits 6) 0) (= (array-read bits 9) 0)
                (= (array-read bits 62) 0) (= (array-read bits 65) 0)) :packed-bit-neighbors))
  :passed)
(defmacro measured (name &body body)
  `(let* ((thread (mezzano.supervisor:current-thread))
          (before (mezzano.supervisor:thread-bytes-consed thread)))
     ,@body
     (let ((after (mezzano.supervisor:thread-bytes-consed thread)))
       (unless (= before after)
         (mezzano.supervisor:debug-print-line "SNOWGRAVE-WIDTH-ALLOCATED " ,name " " (- after before)))
       (check (= before after) :hot-allocation))
     (mezzano.supervisor:debug-print-line "SNOWGRAVE-WIDTH-ZERO " ,name)))
(defun wired-entry (sp fp object arrays foreign)
  (declare (ignore sp fp))
  (check (not (mezzano.internals::%interrupt-state)) :interrupt-state)
  (measured :record-first (record-round object foreign))
  (measured :record256 (dotimes (i 256) (record-round object foreign)))
  (measured :array-first (array-round arrays))
  (measured :array256 (dotimes (i 256) (array-round arrays)))
  :passed)
(defun run ()
  (let ((object (make-widths :boxed :boxed)) (foreign (make-wide))
        (arrays (make-array 8 :area :wired)))
    (loop for type in '(bit (unsigned-byte 8) (unsigned-byte 16) (unsigned-byte 32)
                       (signed-byte 8) (signed-byte 16) (signed-byte 32))
          for minimum in '(0 0 0 0 -128 -32768 -2147483648)
          for i from 0 do
      (setf (aref arrays i) (make-array (if (eq type 'bit) 70 3) :element-type type
                                      :initial-element minimum :area :wired)))
    (setf (aref arrays 7) (make-array 3 :element-type '(unsigned-byte 32)
                                     :initial-element 0 :fill-pointer 1 :adjustable t :area :wired))
    ;; Allocations and native MOP inspection occur cold, before the intervals.
    (let* ((class (mezzano.internals::get-structure-type 'widths))
           (layout (mezzano.clos:class-layout class)))
      (check (= (mezzano.internals::layout-heap-size layout) 5) :native-payload-size)
      (mezzano.supervisor:debug-print-line "SNOWGRAVE-WIDTH-NATIVE-LAYOUT payload40 allocation48"))
    (let* ((thread (mezzano.supervisor:current-thread))
           (before (mezzano.supervisor:thread-bytes-consed thread)))
      (setf *positive-control* (cons (cons nil nil) (cons nil nil)))
      (check (= (- (mezzano.supervisor:thread-bytes-consed thread) before) 48) :allocation-meter)
      (mezzano.supervisor:debug-print-line "SNOWGRAVE-WIDTH-POSITIVE48"))
    (check (eq (mezzano.supervisor::%call-on-wired-stack-without-interrupts
                #'wired-entry nil object arrays foreign) :passed) :wired-return)
    (mezzano.supervisor:debug-print-line "SNOWGRAVE-WIDTH-NATIVE-PASSED")))
