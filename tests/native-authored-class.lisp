(defpackage #:snowgrave.native-authored (:use #:cl))
(in-package #:snowgrave.native-authored)
(defclass left ()
  ((u :type (unsigned-byte 8) :initarg :u :accessor u)
   (signed :type (signed-byte 16) :initarg :signed :accessor signed)))
(defclass right ()
  ((wide :type (unsigned-byte 32) :initarg :wide :accessor wide)))
(defclass leaf (left right)
  ((flag :type bit :initarg :flag :accessor flag)
   (data :type (or null (simple-array (unsigned-byte 8) (*))
                       (simple-array (unsigned-byte 16) (*))
                       (simple-array (unsigned-byte 32) (*)))
         :initarg :data :initform nil :accessor data)))
;; Real authored initialization makes the allowed-keyword protocol explicit.
(defmethod initialize-instance :after ((r left) &rest arguments &key &allow-other-keys)
  (declare (ignore r arguments)))
(defgeneric compute-value (record))
(defmethod compute-value ((r t)) (declare (ignore r)) 0)
(defmethod compute-value :before ((r left)) (u r))
(defmethod compute-value :after ((r right)) (wide r))
(defmethod compute-value ((r leaf))
  (+ (u r) (signed r) (wide r) (call-next-method)))
(defmethod compute-value :around ((r leaf))
  (values (call-next-method) (flag r)))
(defun boot (data)
  (make-instance 'leaf :u 255 :signed -32768 :wide 4294967295 :flag 1 :data data))
(defun observe (r) (values (u r) (signed r) (wide r) (flag r) (data r)))
(defun compute-entry (r) (compute-value r))
(defun write-u (r v) (setf (u r) v))
(defun write-signed (r v) (setf (slot-value r 'signed) v))
(defun write-data (r v) (setf (data r) v))
(defun bound-u (r) (slot-boundp r 'u))
(defun unbind-u (r) (slot-makunbound r 'u))
(defun bound-data (r) (slot-boundp r 'data))
(defun unbind-data (r) (slot-makunbound r 'data))
(defun class-token (r) (eq (class-of r) (find-class 'leaf)))
(defun is-left (r) (typep r 'left))
(defun is-right (r) (typep r 'right))
