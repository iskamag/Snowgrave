(defpackage #:snowgrave.mezzano-access-fixture (:use #:cl))
(in-package #:snowgrave.mezzano-access-fixture)
(defvar *special-entry-argument* nil)

;; Deliberately global: only the actual lexical MACROLET grants admission.
(defmacro snowgrave.mezzano-access::%admitted-access-scope () '(return-from never-the-entry (values nil :wrong-global)))

(defstruct (entity :sealed (:area :wired))
  scheduler (id 0 :type fixnum) (generation 0 :type fixnum) (phase :new) roots scopes)
(snowgrave.mezzano-access:define-record-accessors entity
  ((entity-scheduler scheduler) (entity-id id) (entity-generation generation)
   (entity-phase phase) (entity-roots roots) (entity-scopes scopes)))
(defstruct (finite-domain :sealed (:area :wired))
  ;; Exact declarations of the native THREAD state/priority domains; this
  ;; fixture supplies no scheduler policy or foreign layout projection.
  (state 0 :type (member :active :runnable :sleeping :dead
                         :waiting-for-page-read :waiting-for-page-write
                         :pager-request :stopped 0))
  (priority :normal :type (member :low :normal :high :supervisor :idle))
  (single :active :type (eql :active)))
(snowgrave.mezzano-access:define-record-accessors finite-domain
  ((finite-domain-state state) (finite-domain-priority priority)
   (finite-domain-single single)))
(defstruct (unsupported-finite :sealed (:area :wired)) tag
  (value :active :type (member :active 42)))
(defstruct (unboxed-eql :sealed (:area :wired)) tag (zero 0 :type (eql 0)))
(defstruct (immutable :sealed (:area :wired)) (value nil :read-only t))
(snowgrave.mezzano-access:define-record-accessors immutable ((immutable-value value)))
(defstruct (unsupported :sealed (:area :wired)) tag (value 0 :type (unsigned-byte 64)))
(defstruct (included-base (:area :wired)) (id 0 :type fixnum) roots)
(defstruct (included-child (:include included-base) :sealed (:area :wired)) extra)
(snowgrave.mezzano-access:define-record-accessors included-child
  ((included-child-id id) (included-child-roots roots)))
(defvar *accessor-effect* 0)
(defstruct (effectful-getter :sealed (:area :wired)) value)
(defun effectful-getter-value (mezzano.internals::object)
  (incf *accessor-effect*)
  (mezzano.internals::%struct-slot mezzano.internals::object 'effectful-getter 'value))
(defstruct (effectful-writer :sealed (:area :wired)) value)
(defun (setf effectful-writer-value) (mezzano.internals::new-value mezzano.internals::object)
  (incf *accessor-effect*)
  (setf (mezzano.internals::%struct-slot mezzano.internals::object 'effectful-writer 'value)
        mezzano.internals::new-value))
(defstruct (effectful-cas :sealed (:area :wired)) value)
(defun (mezzano.internals::cas effectful-cas-value)
    (mezzano.internals::old mezzano.internals::new mezzano.internals::object)
  (incf *accessor-effect*)
  (mezzano.internals::cas
   (mezzano.internals::%struct-slot mezzano.internals::object 'effectful-cas 'value)
   mezzano.internals::old mezzano.internals::new))

(defun ordinary-record-read (entity) (entity-id entity))
(defun ordinary-array-read (array index) (aref array index))
(defun ordinary-array-length (array) (length array))
(defun ordinary-vectorp (object) (vectorp object))
(defun ordinary-callable (function value) (funcall function value))
(defun ordinary-record-cas (entity old new)
  (mezzano.internals::cas (entity-generation entity) old new))
(defun ordinary-finite-read (object) (finite-domain-state object))
(defun ordinary-finite-write (value object) (setf (finite-domain-state object) value))
(defun ordinary-finite-cas (object old new)
  (mezzano.internals::cas (finite-domain-state object) old new))

(defmacro define-bounded (name arguments &body body)
  `(snowgrave.mezzano-access:define-admitted-entry ,name ,arguments (values nil :invalid-count)
     (declare (optimize (safety 3) (speed 1)))
     (snowgrave.mezzano-access:with-admitted-access (return-from ,name (values nil :invalid-record))
       ,@body)))

(define-bounded bounded-record-read (entity) (entity-id entity))
(define-bounded bounded-record-write (value entity) (setf (entity-generation entity) value))
(define-bounded bounded-boxed-read (entity) (entity-roots entity))
(define-bounded bounded-boxed-write (value entity) (setf (entity-roots entity) value))
(define-bounded bounded-record-cas (entity old new)
  (mezzano.internals::cas (entity-generation entity) old new))
(define-bounded bounded-boxed-cas (entity old new)
  (mezzano.internals::cas (entity-roots entity) old new))
(define-bounded bounded-included-cas (entity old new)
  (mezzano.internals::cas (included-child-id entity) old new))
(define-bounded bounded-finite-read (object) (finite-domain-state object))
(define-bounded bounded-finite-write (value object) (setf (finite-domain-state object) value))
(define-bounded bounded-finite-cas (object old new)
  (mezzano.internals::cas (finite-domain-state object) old new))
(define-bounded bounded-priority-read (object) (finite-domain-priority object))
(define-bounded bounded-priority-write (value object) (setf (finite-domain-priority object) value))
(define-bounded bounded-priority-cas (object old new)
  (mezzano.internals::cas (finite-domain-priority object) old new))
(define-bounded bounded-eql-read (object) (finite-domain-single object))
(define-bounded bounded-eql-write (value object) (setf (finite-domain-single object) value))
(define-bounded bounded-eql-cas (object old new)
  (mezzano.internals::cas (finite-domain-single object) old new))
(snowgrave.mezzano-access:define-record-accessors mezzano.supervisor::thread
  ((mezzano.supervisor::thread-state mezzano.supervisor::state)
   (mezzano.supervisor::thread-priority mezzano.supervisor::priority)))
(define-bounded bounded-thread-state-read (object) (mezzano.supervisor::thread-state object))
(define-bounded bounded-thread-state-write (value object)
  (setf (mezzano.supervisor::thread-state object) value))
(define-bounded bounded-thread-state-cas (object old new)
  (mezzano.internals::cas (mezzano.supervisor::thread-state object) old new))
(define-bounded bounded-thread-priority-read (object) (mezzano.supervisor::thread-priority object))
(define-bounded bounded-thread-priority-write (value object)
  (setf (mezzano.supervisor::thread-priority object) value))
(define-bounded bounded-thread-priority-cas (object old new)
  (mezzano.internals::cas (mezzano.supervisor::thread-priority object) old new))
(define-bounded bounded-array-read (array index) (aref array index))
(define-bounded bounded-array-write (value array index) (funcall #'(setf aref) value array index))
(define-bounded bounded-native-read (array index) (mezzano.internals::aref-1 array index))
(define-bounded bounded-native-write (value array index) (funcall #'(setf mezzano.internals::aref-1) value array index))
(define-bounded bounded-length (array) (length array))
(define-bounded bounded-size (array) (array-total-size array))
(define-bounded bounded-fill-read (array) (fill-pointer array))
(define-bounded bounded-fill-write (value array) (setf (fill-pointer array) value))
(define-bounded bounded-vectorp (object) (vectorp object))

(snowgrave.mezzano-access:define-admitted-entry shared-optional
    (entity &optional (value (entity-id entity) supplied-p)) (values nil :invalid-entry)
  "Defaults run only after accepted count, inside the admitted access scope."
  (declare (optimize (safety 3) (speed 1)))
  (values value supplied-p))
(snowgrave.mezzano-access:define-admitted-entry shared-five (a b c d e) (values nil :invalid-entry)
  (declare (ignore b c d) (optimize (safety 3) (speed 1)))
  (values a e))
(snowgrave.mezzano-access:define-admitted-entry shared-empty () (values nil :invalid-entry)
  (declare (optimize (safety 3) (speed 1)))
  (values nil :empty))
(snowgrave.mezzano-access:define-admitted-entry (setf shared-value) (value entity) (values nil :invalid-entry)
  (declare (optimize (safety 3) (speed 1)))
  (setf (entity-generation entity) value))
(snowgrave.mezzano-access:define-admitted-entry shared-call (function value) (values nil :invalid-entry)
  (declare (optimize (safety 3) (speed 1)))
  (snowgrave.mezzano-access:call-admitted-entry function value))

(defun ordinary-anonymous-factory ()
  (lambda (entity) (entity-id entity)))
(defun shared-anonymous-factory ()
  (snowgrave.mezzano-access:admitted-lambda
      (entity &optional (value (entity-id entity) supplied-p)) (values nil :invalid-entry)
    "Anonymous defaults share the count and raw access contract."
    (declare (optimize (safety 3) (speed 1)))
    (values value supplied-p)))
(defun shared-anonymous-capture-factory (seed)
  (snowgrave.mezzano-access:admitted-lambda
      (x &optional (y seed supplied-p)) (values nil :invalid-entry)
    (declare (optimize (safety 3) (speed 1)))
    (values x y supplied-p)))
(snowgrave.mezzano-access:define-admitted-entry shared-nested-anonymous-factory ()
    (values nil :invalid-factory-count)
  (declare (optimize (safety 3) (speed 1)))
  (block outer-failure
    (snowgrave.mezzano-access:with-admitted-access
        (return-from outer-failure (values nil :wrong-outer-failure))
      (snowgrave.mezzano-access:admitted-lambda
          (entity &optional (value (entity-id entity) supplied-p))
          (values nil :local-entry-failure)
        (declare (optimize (safety 3) (speed 1)))
        (values value supplied-p)))))

;; Numeric controls use the same shared entry/scope as actual owner consumers.
(defun ordinary-number-add (left right) (+ left right))
(defun ordinary-number-product (left right) (* left right))
(defun ordinary-number-eql (left right) (eql left right))
(defun ordinary-number-truncate (left right) (truncate left right))
(defmacro define-numeric-control (name arguments expression)
  `(snowgrave.mezzano-access:define-admitted-entry ,name ,arguments (values nil :invalid-count)
     (declare (optimize (safety 3) (speed 1)))
     (snowgrave.mezzano-access:with-admitted-access (return-from ,name (values nil :invalid-numeric))
       ,expression)))
(define-numeric-control bounded-number-add (a b c) (+ a b c))
(define-numeric-control bounded-number-subtract (a b c) (- a b c))
(define-numeric-control bounded-number-negate (a) (- a))
(define-numeric-control bounded-number-product (a b c) (* a b c))
(define-numeric-control bounded-number-truncate (a b) (truncate a b))
(define-numeric-control bounded-number-truncate-one (a) (truncate a))
(define-numeric-control bounded-number-truncate-call (a b) (funcall #'truncate a b))
(define-numeric-control bounded-number-truncate-nested (a b c) (truncate a (truncate b c)))
(define-numeric-control bounded-number-shift (a b) (ash a b))
(define-numeric-control bounded-number-increment (a) (1+ a))
(define-numeric-control bounded-number-decrement (a) (1- a))
(define-numeric-control bounded-number-less (a b c) (< a b c))
(define-numeric-control bounded-number-less-equal (a b c) (<= a b c))
(define-numeric-control bounded-number-greater (a b c) (> a b c))
(define-numeric-control bounded-number-greater-equal (a b c) (>= a b c))
(define-numeric-control bounded-number-equal (a b c) (= a b c))
(define-numeric-control bounded-number-distinct (a b c) (/= a b c))
(define-numeric-control bounded-number-eql (a b) (eql a b))
(define-numeric-control bounded-number-min (a b c) (min a b c))
(define-numeric-control bounded-number-max (a b c) (max a b c))
(define-numeric-control bounded-number-plusp (a) (plusp a))
(define-numeric-control bounded-number-minusp (a) (minusp a))
(define-numeric-control bounded-number-zerop (a) (zerop a))
(define-numeric-control bounded-number-logand (a b c) (logand a b c))
(define-numeric-control bounded-number-logior (a b c) (logior a b c))
(define-numeric-control bounded-number-logxor (a b c) (logxor a b c))
(define-numeric-control bounded-number-lognot (a) (lognot a))
(define-numeric-control bounded-number-evenp (a) (evenp a))
(define-numeric-control bounded-number-oddp (a) (oddp a))
(define-numeric-control bounded-number-empty-add () (+))
(define-numeric-control bounded-number-empty-product () (*))
(define-numeric-control bounded-number-empty-and () (logand))
(define-numeric-control bounded-number-empty-or () (logior))
