(defpackage #:snowgrave.typed-slots.fixture (:use #:cl))
(in-package #:snowgrave.tests)

(defun typed-slot-tests ()
  (let* ((*package* (find-package :snowgrave.typed-slots.fixture))
         (forms (read-from-string
          "((defclass base () ((u :type (unsigned-byte 17) :initarg :u :accessor u)))
            (defclass leaf (base)
              ((s :type (signed-byte 16) :initarg :s :accessor s)
               (bits :type bit :initarg :bits :accessor bits)
               (data :type (simple-array (unsigned-byte 32) (*)) :initarg :data :accessor data)
               (optional :type (or null (simple-array (unsigned-byte 32) (*)))
                         :initform nil :accessor optional)))
            (defun boot (v) (make-instance 'leaf :u 131071 :s -32768 :bits 1 :data v))
            (defun observe (r) (values (u r) (s r) (bits r) (data r)))
            (defun write-u (r v) (setf (u r) v))
            (defun write-s (r v) (setf (slot-value r 's) v))
            (defun write-data (r v) (setf (data r) v))
            (defun write-optional (r v) (setf (optional r) v)))"))
         (unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(:typed-slots)
                 :closed-classes (read-from-string "(base leaf)")
                 :universe (read-from-string "(base leaf number t)")
                 :closed-generics (read-from-string "(u (setf u) s (setf s) bits (setf bits) data (setf data) optional (setf optional))")
                 :entries (read-from-string "(boot observe write-u write-s write-data write-optional)")
                 :external-domains (read-from-string "((boot (t)) (observe (leaf)) (write-u (base t)) (write-s (leaf t)) (write-data (leaf t)) (write-optional (leaf t)))")))
         (vector (make-array 3 :element-type '(unsigned-byte 32) :initial-element #xffffffff))
         (record (funcall (test-unit-function unit "BOOT") vector))
         (description (find (intern "LEAF") (getf (snowgrave:unit-metadata unit) :record-layouts)
                            :key (lambda (layout) (getf layout :class)))))
    (dolist (form forms) (eval form))
    (check (equal (getf description :slot-types)
                  '((unsigned-byte 17) (signed-byte 16) bit (simple-array (unsigned-byte 32) (*))
                    (or null (simple-array (unsigned-byte 32) (*))))))
    (let ((native (funcall (intern "BOOT") vector)))
      (check (equal (multiple-value-list (funcall (intern "OBSERVE") native))
                    (multiple-value-list (funcall (test-unit-function unit "OBSERVE") record))))
      (dolist (value '(0 131071))
        (check (= (funcall (intern "WRITE-U") native value)
                  (funcall (test-unit-function unit "WRITE-U") record value))))
      (dolist (value '(-32768 32767))
        (check (= (funcall (intern "WRITE-S") native value)
                  (funcall (test-unit-function unit "WRITE-S") record value)))))
    (dolist (value '(-1 131072 nil :invalid #x100000000000000000))
      (signals type-error (funcall (test-unit-function unit "WRITE-U") record value))
      (check (= (snowgrave:sg-record-read record (intern "U")) 131071)))
    (signals type-error (funcall (test-unit-function unit "WRITE-DATA") record (make-array 3)))
    (check (eq (snowgrave:sg-record-read record (intern "DATA")) vector))
    (let ((other (make-array 4 :element-type '(unsigned-byte 32) :initial-element 0)))
      (check (eq other (funcall (test-unit-function unit "WRITE-DATA") record other))))
    (check (eq vector (funcall (test-unit-function unit "WRITE-OPTIONAL") record vector)))
    (check (null (funcall (test-unit-function unit "WRITE-OPTIONAL") record nil)))
    (signals type-error (funcall (test-unit-function unit "WRITE-OPTIONAL") record :invalid))
    ;; A same-name untyped logical layout is not the admitted typed receiver.
    (let ((untyped (snowgrave:sg-make-record
                    (snowgrave:make-layout (getf description :identity) (getf description :class)
                                          (getf description :ancestors) (getf description :slots)
                                          :error-mapping (getf description :error-mapping)))))
      (signals snowgrave:domain-violation (funcall (test-unit-function unit "OBSERVE") untyped)))
    (let* ((root (asdf:system-source-directory "snowgrave"))
           (source (merge-pathnames ".build/fresh-typed-slots.lisp" root))
           (data (merge-pathnames ".build/fresh-typed-slots.metadata" root)))
      (with-open-file (stream source :direction :output :if-exists :supersede)
        (snowgrave:write-unit-source unit stream))
      (with-open-file (stream data :direction :output :if-exists :supersede)
        (snowgrave:write-unit-metadata unit stream))
      (check (search "Fresh typed slots executed."
                     (uiop:run-program
                      (list "sbcl" "--no-sysinit" "--no-userinit" "--script"
                            (namestring (merge-pathnames "scripts/fresh-typed-slots.lisp" root))
                            (namestring source) (namestring data)) :output :string))))
    t))
