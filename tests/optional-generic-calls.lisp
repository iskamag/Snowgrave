(in-package #:snowgrave.tests)
(defpackage #:snowgrave.optional-calls.fixture (:use #:cl))

(defun optional-generic-call-tests ()
  (let* ((*package* (find-package :snowgrave.optional-calls.fixture))
         (identity '(:finite-optional-calls))
         (forms (read-from-string
          "((defclass optional-base () ((payload :initarg :payload)))
            (defclass optional-leaf (optional-base) ())
            (defparameter *optional-events* nil)
            (defgeneric combine (r &optional x y))
            (defmethod combine :around ((r optional-base)
                                        &optional (x (progn (push :around-x *optional-events*) 101) xp)
                                                  (y (progn (push :around-y *optional-events*) 102) yp))
              (push (list :around x xp y yp) *optional-events*)
              (unwind-protect (call-next-method) (push :cleanup *optional-events*)))
            (defmethod combine :before ((r optional-base)
                                        &optional (x (progn (push :before-x *optional-events*) 201) xp)
                                                  (y 202 yp))
              (push (list :before x xp y yp) *optional-events*))
            (defmethod combine :after ((r optional-base)
                                       &optional (x (progn (push :after-x *optional-events*) 301) xp)
                                                 (y 302 yp))
              (push (list :after x xp y yp) *optional-events*))
            (defmethod combine ((r optional-base)
                                 &optional (x (progn (push :base-x *optional-events*) 401) xp)
                                           (y (+ x 1) yp) &aux (saved x))
              (push (list :base saved xp y yp) *optional-events*)
              (values saved xp y yp (slot-value r 'payload)))
            (defmethod combine ((r optional-leaf)
                                 &optional (x (progn (push :leaf-x *optional-events*) 501) xp)
                                           (y 502 yp))
              (push (list :leaf x xp y yp) *optional-events*)
              (setf x 999)
              (call-next-method))
            (defgeneric alternate (r &optional x y))
            (defmethod alternate ((r optional-base) &optional (x 601 xp) (y 602 yp))
              (values x xp y yp (slot-value r 'payload)))
            (defgeneric lone (r &optional x))
            (defmethod lone ((r optional-base) &optional (x 701 xp))
              (declare (ignore x xp)) (call-next-method))
            (defgeneric (setf optional-value) (value r &optional owner))
            (defmethod (setf optional-value) (value (r optional-base) &optional owner)
              (declare (ignore owner)) (setf (slot-value r 'payload) value))
            (defun write-direct (r) (setf (optional-value r) 31))
            (defun write-indirect (r) (funcall #'(setf optional-value) 37 r nil))
            (defgeneric no-required (&optional x))
            (defmethod no-required (&optional (x 17 xp)) (values x xp))
            (defun boot () (make-instance 'optional-leaf :payload 19))
            (defun omitted (r) (combine r))
            (defun one (r) (combine r 23))
            (defun supplied-nil (r) (combine r nil nil))
            (defun literal (r) (funcall #'combine r))
            (defun via-apply (r) (apply #'combine r (list 23 24)))
            (defun via-values (r) (multiple-value-call #'combine (values r) (values 23 24)))
            (defun relay (callback r) (funcall callback r))
            (defun via-helper (r) (relay #'combine r))
            (defun finite-choice (r choose)
              (funcall (progn (push :callee *optional-events*) (if choose #'combine #'alternate))
                       (progn (push :receiver *optional-events*) r)
                       (progn (push :argument *optional-events*) 23)))
            (defun variable-tail (r tail) (apply #'combine r tail))
            (defun no-next (r) (lone r))
            (defun no-next-supplied (r) (lone r nil))
            (defun zero-omitted () (no-required))
            (defun zero-supplied () (funcall #'no-required nil))
            (defun capture () #'combine))"))
         (base (intern "OPTIONAL-BASE")) (leaf (intern "OPTIONAL-LEAF"))
         (combine (intern "COMBINE")) (lone (intern "LONE"))
         (events (intern "*OPTIONAL-EVENTS*"))
         (entries (read-from-string "(boot omitted one supplied-nil literal via-apply via-values
                                       via-helper finite-choice variable-tail no-next no-next-supplied
                                       zero-omitted zero-supplied capture write-direct write-indirect)"))
         (unit (snowgrave:close-source-unit
                (list :forms forms) :unit-name identity :closed-classes (list base leaf)
                :closed-generics (read-from-string "(combine alternate lone no-required (setf optional-value))")
                :universe (list base leaf 'number 'list t) :entries entries
                :external-domains
                (read-from-string "((boot ()) (omitted (optional-base)) (one (optional-base))
                   (supplied-nil (optional-base)) (literal (optional-base)) (via-apply (optional-base))
                   (via-values (optional-base)) (via-helper (optional-base))
                   (finite-choice (optional-base t)) (variable-tail (optional-base list))
                   (no-next (optional-base)) (no-next-supplied (optional-base))
                   (zero-omitted ()) (zero-supplied ()) (capture ())
                   (write-direct (optional-base)) (write-indirect (optional-base)))"))))
    (dolist (form forms) (eval form))
    (let* ((native (funcall (intern "BOOT")))
           (record (funcall (test-unit-function unit "BOOT")))
           (native-gf (fdefinition combine)) (closed-gf (test-code-function unit combine))
           (native-bindings (list (cons native :record) (cons native-gf (list identity :generic combine))))
           (closed-bindings (list (cons record :record) (cons closed-gf (list identity :generic combine)))))
      ;; Initial miss/max-arity state and subsequent public parser errors remain
      ;; those of the one retained public generic identity.
      (check (equal (miss-trace native-gf '(17 23 24 25) native-bindings nil)
                    (miss-trace closed-gf '(17 23 24 25) closed-bindings nil)))
      (dolist (name '("OMITTED" "ONE" "SUPPLIED-NIL" "LITERAL" "VIA-APPLY" "VIA-VALUES" "VIA-HELPER"))
        (setf (symbol-value events) nil)
        (let ((expected (multiple-value-list (funcall (intern name) native)))
              (trace (copy-tree (symbol-value events))))
          (setf (symbol-value events) nil)
          (check (equal expected (multiple-value-list (funcall (test-unit-function unit name) record))))
          (check (equal trace (symbol-value events)))))
      (check (equal '(401 nil 402 nil 19) (multiple-value-list (funcall (test-unit-function unit "OMITTED") record))))
      (check (equal '(23 t 24 nil 19) (multiple-value-list (funcall (test-unit-function unit "ONE") record))))
      (check (equal '(nil t nil t 19) (multiple-value-list (funcall (test-unit-function unit "SUPPLIED-NIL") record))))
      (dolist (choice '(nil t))
        (setf (symbol-value events) nil)
        (let ((expected (multiple-value-list (funcall (intern "FINITE-CHOICE") native choice)))
              (trace (copy-tree (symbol-value events))))
          (setf (symbol-value events) nil)
          (check (equal expected (multiple-value-list (funcall (test-unit-function unit "FINITE-CHOICE") record choice))))
          (check (equal trace (symbol-value events)))))
      (dolist (args '(nil (17) (17 23 24 25)))
        (let ((expected (miss-trace native-gf args native-bindings nil))
              (actual (miss-trace closed-gf args closed-bindings nil)))
          (unless (equal expected actual) (format t "~&OPTIONAL-MISS ~S native=~S closed=~S~%" args expected actual))
          (check (equal expected actual))))
      (dolist (tail '(nil (23) (23 24) (23 24 25)))
        (let ((expected (contract-observation (intern "VARIABLE-TAIL") (list native tail) native-bindings))
              (actual (contract-observation (test-unit-function unit "VARIABLE-TAIL") (list record tail) closed-bindings)))
          (unless (equal expected actual) (format t "~&OPTIONAL-TAIL ~S native=~S closed=~S~%" tail expected actual))
          (check (equal expected actual))))
      (dolist (name '("NO-NEXT" "NO-NEXT-SUPPLIED"))
        (let* ((native-lone (fdefinition lone)) (closed-lone (test-code-function unit lone))
               (method (find-method native-lone nil (list (find-class base))))
               (method-key (list identity :method lone nil (list base))))
          (check (equal (contract-observation (intern name) (list native)
                                            (list (cons native :record) (cons native-lone (list identity :generic lone))
                                                  (cons method method-key)))
                        (contract-observation (test-unit-function unit name) (list record)
                                              (list (cons record :record) (cons closed-lone (list identity :generic lone))))))))
      (check (equal '(17 nil) (multiple-value-list (funcall (test-unit-function unit "ZERO-OMITTED")))))
      (check (equal '(nil t) (multiple-value-list (funcall (test-unit-function unit "ZERO-SUPPLIED")))))
      (check (eq closed-gf (funcall (test-unit-function unit "CAPTURE"))))
      (check (= 31 (funcall (test-unit-function unit "WRITE-DIRECT") record)))
      (check (= 31 (snowgrave:sg-record-read record (intern "PAYLOAD"))))
      (check (= 37 (funcall (test-unit-function unit "WRITE-INDIRECT") record)))
      (check (= 37 (snowgrave:sg-record-read record (intern "PAYLOAD"))))
      (dolist (row (getf (snowgrave:unit-metadata unit) :dispatch))
        (check (getf row :fixed-call-kernel))
        (let ((definition (find (getf row :fixed-call-kernel)
                                (getf (snowgrave:unit-metadata unit) :definitions)
                                :key (lambda (row) (getf row :code-key)) :test #'equal)))
          (check definition)
          (check (not (member '&rest (getf definition :lambda-list))))
          (check (equal (if (eq (getf row :generic) (intern "NO-REQUIRED")) '(0 1)
                           (if (consp (getf row :generic)) '(2 3)
                               (if (eq (getf row :generic) lone) '(1 2) '(1 3))))
                        (getf row :fixed-call-arities)))))
      ;; Runtime-only source replay includes the fixed convention and ordinary
      ;; optional method binders, with no adapter or MOP present at invocation.
      (let* ((root (asdf:system-source-directory "snowgrave"))
             (source (merge-pathnames ".build/fresh-optional-calls.lisp" root)))
        (ensure-directories-exist source)
        (with-open-file (stream source :direction :output :if-exists :supersede)
          (snowgrave:write-unit-source unit stream))
        (check (search "Fresh optional calls executed."
                       (uiop:run-program
                        (list "sbcl" "--no-sysinit" "--no-userinit" "--script"
                              (namestring (merge-pathnames "scripts/fresh-optional-calls.lisp" root))
                              (namestring source)) :output :string)))))))

(defun optional-parser-payload-tests ()
  (loop for (tag call expected) in
        '((:private-record "(operation root nil root)" :graph-state-parser-payload)
          (:private-callable "(operation root nil #'retained)" :graph-state-parser-payload)
          (:native-car "(operation root nil (car '(23)))" :accepted)
          (:optional-count "(operation root nil root)" :accepted)
          (:mixed-native-private "(if (slot-value root 'choose) (operation root nil root)
                                     (operation root nil (car '(23))))" :graph-state-parser-payload)
          (:ordinary-count "(apply #'ordinary root tail)" :accepted))
        for number from 0
        do
    (let* ((*package* (make-package (format nil "SNOWGRAVE.OPTIONAL-PARSER.~D" number) :use '("CL")))
           (forms (read-from-string
                   (format nil "((defclass optional-node () ((choose :initform t)))
                                 (defgeneric operation (root &optional x))
                                 ~A
                                 (defmethod operation ((root optional-node) &optional x)
                                   (declare (ignore root x)) 17)
                                 (defun retained () 19)
                                 (defun ordinary (root &optional x) (declare (ignore root x)) 17)
                                 (defun entry (root ~A) (operation root) (ordinary root) ~A 17))"
                           (if (eq tag :optional-count) ""
                               "(defmethod operation :around ((root optional-node) &optional x)
                                  (declare (ignore root x)) (call-next-method))")
                           (if (eq tag :ordinary-count) "tail" "") call)))
           (node (intern "OPTIONAL-NODE")) (entry (intern "ENTRY"))
           (operation (intern "OPERATION")) (root nil) (tail (list nil 23)) (unit nil) (failure nil))
      (dolist (form forms) (eval form))
      (setf root (make-instance node))
      (let ((native (handler-case (progn (apply entry root (when (eq tag :ordinary-count) (list tail))) nil)
                      (error (condition) condition))))
        (check (typep native 'sb-int:simple-program-error))
        (when (member tag '(:private-record :mixed-native-private))
          (check (eq root (first (first (simple-condition-format-arguments native))))))
        (when (eq tag :private-callable)
          (check (eq (fdefinition (intern "RETAINED"))
                     (first (first (simple-condition-format-arguments native))))))
        (handler-case
            (setf unit (snowgrave:close-source-unit
                        (list :forms forms) :unit-name (list :optional-parser-payload tag)
                        :deployment-roots :entries :closed-classes (list node) :closed-generics (list operation)
                        :universe (list node t) :entries (list entry)
                        :external-domains (list (list entry (append (list (list 'eql root))
                                                                  (when (eq tag :ordinary-count) (list (list 'eql tail))))))))
          (snowgrave:snowgrave-error (condition) (setf failure condition)))
        (if (eq expected :accepted)
            (progn
              (when failure (format t "~&OPTIONAL-POSITIVE ~S ~A~%" tag failure))
              (check unit)
              (check (equal (condition-observation native (list (cons root :root)))
                            (contract-observation (snowgrave:unit-function unit entry :bind-configuration t) nil))))
            (progn (check failure)
                   (unless (eq expected (snowgrave:error-feature failure)) (format t "~&OPTIONAL-PAYLOAD ~S ~A~%" tag failure))
                   (check (eq expected (snowgrave:error-feature failure)))))))))

(defpackage #:snowgrave.optional-cem.fixture
  (:use #:cl)
  (:shadowing-import-from #:snowgrave #:defclass #:defgeneric #:defmethod #:define-method-combination))

(defun optional-combination-call-tests ()
  (let* ((*package* (find-package :snowgrave.optional-cem.fixture))
         (forms (read-from-string
                 "((defclass optional-cem-cell () ())
                   (defparameter *optional-cem-events* nil)
                   (define-method-combination prefixed () ((primaries () :required t))
                     `(progn (push :prefix *optional-cem-events*)
                             (call-method ,(first primaries) ,(rest primaries))))
                   (define-method-combination unused () ((primaries () :required t))
                     (declare (ignore primaries))
                     '(progn (push :unused *optional-cem-events*) 29))
                   (defgeneric prefixed-call (r &optional x) (:method-combination prefixed))
                   (defmethod prefixed-call ((r optional-cem-cell) &optional (x 17 xp))
                     (declare (ignore r)) (values x xp))
                   (defgeneric unused-call (r &optional x) (:method-combination unused))
                   (defmethod unused-call ((r optional-cem-cell) &optional (x 19))
                     (declare (ignore r)) x)
                   (defun boot () (make-instance 'optional-cem-cell))
                   (defun omitted (r) (prefixed-call r))
                   (defun supplied (r) (funcall #'prefixed-call r nil))
                   (defun ignored (r) (unused-call r)))"))
         (class (intern "OPTIONAL-CEM-CELL"))
         (events (intern "*OPTIONAL-CEM-EVENTS*"))
         (unit (snowgrave:close-source-unit
                (list :forms forms) :unit-name '(:optional-cem-calls)
                :closed-classes (list class) :closed-generics (read-from-string "(prefixed-call unused-call)")
                :universe (list class t) :entries (read-from-string "(boot omitted supplied ignored)")
                :external-domains (read-from-string
                                   "((boot ()) (omitted (optional-cem-cell))
                                      (supplied (optional-cem-cell)) (ignored (optional-cem-cell)))"))))
    (dolist (form forms) (eval form))
    (let ((native (funcall (intern "BOOT"))) (record (funcall (test-unit-function unit "BOOT"))))
      (dolist (name '("OMITTED" "SUPPLIED" "IGNORED"))
        (setf (symbol-value events) nil)
        (let ((expected (multiple-value-list (funcall (intern name) native)))
              (trace (copy-list (symbol-value events))))
          (setf (symbol-value events) nil)
          (check (equal expected (multiple-value-list (funcall (test-unit-function unit name) record))))
          (check (equal trace (symbol-value events)))))
      ;; No validator may move ahead of returned CEM runtime effects or invent
      ;; an error when a valid combination deliberately does not call methods.
      (dolist (name '("PREFIXED-CALL" "UNUSED-CALL"))
        (let ((expected nil) (trace nil))
          (setf (symbol-value events) nil
                expected (contract-observation (intern name) (list native nil 23) (list (cons native :record)))
                trace (copy-list (symbol-value events))
                (symbol-value events) nil)
          (check (equal expected (contract-observation (test-code-function unit (intern name))
                                                      (list record nil 23) (list (cons record :record)))))
          (check (equal trace (symbol-value events))))))))
