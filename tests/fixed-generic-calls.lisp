(in-package #:snowgrave.tests)
(defpackage #:snowgrave.fixed-calls.fixture (:use #:cl) (:shadow #:write))

(defun fixed-generic-call-tests ()
  (let* ((*package* (find-package :snowgrave.fixed-calls.fixture))
         (identity '(:fixed-required-calls))
         (forms (read-from-string
          "((defclass base () ((payload :initarg :payload :accessor payload)))
            (defclass leaf (base) ()) (defparameter *events* nil)
            (defgeneric combine (r n))
            (defmethod combine :around ((r base) n)
              (push :around *events*)
              (unwind-protect (call-next-method) (push :cleanup *events*)))
            (defmethod combine :before ((r base) n) (push :before *events*))
            (defmethod combine :after ((r base) n) (push :after *events*))
            (defmethod combine ((r base) n &aux (saved n))
              (push :base *events*)
              (values saved (payload r) :base nil))
            (defmethod combine ((r leaf) n &aux (saved n))
              (push saved *events*) (call-next-method))
            (defgeneric lone (r n))
            (defmethod lone ((r base) n &aux (saved n))
              (push saved *events*) (call-next-method))
            (defgeneric flex (r))
            (defmethod flex ((r base)) (payload r))
            (defgeneric (setf flex) (value r &rest ignored))
            (defmethod (setf flex) (value (r base) &rest ignored)
              (declare (ignore ignored)) (setf (slot-value r 'payload) value))
            (defun increment (r) (incf (flex r)))
            (defgeneric zero ()) (defmethod zero () (values))
            (defun boot () (make-instance 'leaf :payload 19))
            (defun direct (r n) (combine r n))
            (defun literal (r n) (funcall #'combine r n))
            (defun via-apply (r n) (apply #'combine r (list n)))
            (defun no-next (r n) (lone r n))
            (defun empty () (zero))
            (defun write (r n)
              (setf (payload (progn (push :receiver *events*) r))
                    (progn (push :value *events*) n)))
            (defun capture () #'combine))"))
         (base (intern "BASE")) (leaf (intern "LEAF"))
         (combine (intern "COMBINE")) (lone (intern "LONE")) (events (intern "*EVENTS*"))
         (unit (snowgrave:close-source-unit (list :forms forms) :unit-name identity
                 :closed-classes (list base leaf) :universe (list base leaf 'number)
                 :closed-generics (read-from-string "(combine lone zero payload (setf payload) flex (setf flex))")
                 :entries (read-from-string "(boot direct literal via-apply no-next empty write capture increment)")
                 :external-domains (read-from-string
                    "((boot ()) (direct (base t)) (literal (base t)) (via-apply (base t))
                       (no-next (base t)) (empty ()) (write (base t)) (capture ()) (increment (base)))"))))
    (dolist (form forms) (eval form))
    (let* ((native (funcall (intern "BOOT"))) (record (funcall (test-unit-function unit "BOOT")))
           (native-gf (fdefinition combine)) (closed-gf (test-code-function unit combine))
           (generic-key (list identity :generic combine))
           (native-bindings (list (cons native :record) (cons native-gf generic-key)))
           (closed-bindings (list (cons record :record) (cons closed-gf generic-key))))
      ;; The public first miss still precedes maximum-arity checking. Required
      ;; direct calls then establish the SAME state used by the public wrapper.
      (check (equal (miss-trace native-gf '(17 23 29) native-bindings nil)
                    (miss-trace closed-gf '(17 23 29) closed-bindings nil)))
      (dolist (entry '("DIRECT" "LITERAL" "VIA-APPLY"))
        (setf (symbol-value events) nil)
        (let ((expected (multiple-value-list (funcall (intern entry) native 23)))
              (trace (copy-list (symbol-value events))))
          (setf (symbol-value events) nil)
          (check (equal expected (multiple-value-list (funcall (test-unit-function unit entry) record 23))))
          (check (equal trace (symbol-value events)))))
      (check (equal '(23 19 :base nil)
                    (multiple-value-list (funcall (test-unit-function unit "DIRECT") record 23))))
      (dolist (args '(nil (17) (17 23 29)))
        (check (equal (miss-trace native-gf args native-bindings nil)
                      (miss-trace closed-gf args closed-bindings nil))))
      (check (eq closed-gf (funcall (test-unit-function unit "CAPTURE"))))
      (check (null (multiple-value-list (funcall (test-unit-function unit "EMPTY")))))
      (setf (symbol-value events) nil)
      (check (= 41 (funcall (test-unit-function unit "WRITE") record 41)))
      (check (equal '(:value :receiver) (symbol-value events)))
      (check (= 41 (snowgrave:sg-record-read record (intern "PAYLOAD"))))
      (check (= 42 (funcall (test-unit-function unit "INCREMENT") record)))
      (check (= 42 (snowgrave:sg-record-read record (intern "PAYLOAD"))))
      ;; No-next errors retain original receiver/value through the AUX binding.
      ;; The method and generic retain their logical keys.
      (let* ((native-lone (fdefinition lone)) (closed-lone (test-code-function unit lone))
             (method (find-method native-lone nil (list (find-class base) (find-class t))))
             (method-key (list identity :method lone nil (list base t))))
        (check (equal
                (contract-observation (intern "NO-NEXT") (list native 23)
                   (list (cons native :record) (cons native-lone (list identity :generic lone))
                         (cons method method-key)))
                (contract-observation (test-unit-function unit "NO-NEXT") (list record 23)
                   (list (cons record :record) (cons closed-lone (list identity :generic lone)))))))
      ;; One public wrapper and one private dispatch kernel, never two CEMs.
      (dolist (row (getf (snowgrave:unit-metadata unit) :dispatch))
        (if (equal (getf row :generic) (list 'setf (intern "FLEX")))
            (check (null (getf row :fixed-call-kernel)))
            (progn
              (check (getf row :fixed-call-kernel))
              (let ((definition (find (getf row :fixed-call-kernel)
                                      (getf (snowgrave:unit-metadata unit) :definitions)
                                      :key (lambda (row) (getf row :code-key)) :test #'equal)))
                (check definition)
                (check (not (member '&rest (getf definition :lambda-list)))))))))))
