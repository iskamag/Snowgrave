(in-package #:snowgrave.native-authored-runtime)
(mezzano.internals::defglobal *positive-control*)
(defun check (truth reason)
  (unless truth (mezzano.supervisor:panic "Snowgrave authored materializer: " reason)))
(defmacro measured (name &body body)
  `(let* ((thread (mezzano.supervisor:current-thread))
          (before (mezzano.supervisor:thread-bytes-consed thread)))
     ,@body
     (let ((delta (- (mezzano.supervisor:thread-bytes-consed thread) before)))
       (mezzano.supervisor:debug-print-line "SNOWGRAVE-MATERIALIZER-BYTES " ,name " " delta)
       (check (zerop delta) :hot-allocation))))
(defun hot-round (r data)
  (multiple-value-bind (u signed wide flag actual-data) (entry "OBSERVE" r)
    (check (and (= u 255) (= signed -32768) (= wide 4294967295)
                (= flag 1) (eq actual-data data)) :authored-observe))
  (multiple-value-bind (value flag) (entry "COMPUTE-ENTRY" r)
    (check (and (= value 4294934782) (= flag 1)) :cem-qualifiers-and-next-values))
  (check (and (entry "IS-LEFT" r) (entry "IS-RIGHT" r) (entry "CLASS-TOKEN" r)) :logical-cpl-identity)
  (check (not (entry "IS-LEFT" nil)) :foreign-type-false)
  (check (entry "BOUND-U" r) :bound)
  (check (= (entry "WRITE-U" r 0) 0) :u8-min)
  (check (= (entry "WRITE-U" r 255) 255) :u8-max)
  (check (= (entry "WRITE-SIGNED" r 32767) 32767) :s16-max)
  (check (= (entry "WRITE-SIGNED" r -32768) -32768) :s16-min)
  (check (eq (entry "WRITE-DATA" r nil) nil) :bound-nil)
  (check (and (entry "BOUND-DATA" r) (null (nth-value 4 (entry "OBSERVE" r)))) :read-bound-nil)
  (check (eq (entry "WRITE-DATA" r data) data) :exact-array-alias)
  :passed)
(defun wired-entry (sp fp record data)
  (declare (ignore sp fp))
  (check (not (mezzano.internals::%interrupt-state)) :interrupts)
  (measured :first (hot-round record data))
  (measured :round256 (dotimes (i 256) (hot-round record data)))
  :passed)
(defun negative-round (r)
  ;; Allocating standard conditions run on the ordinary user stack, separately
  ;; from every hot interval and from the refused supervisor admission.
  (dolist (value '(-1 256 nil :invalid #x10000000000000000000))
    (check (handler-case (progn (entry "WRITE-U" r value) nil)
             (type-error (condition)
               (and (eq (type-error-datum condition) value)
                    (equal (type-error-expected-type condition) '(unsigned-byte 8))))) :typed-write-error)
    (check (= (nth-value 0 (entry "OBSERVE" r)) 255) :refused-write-unchanged))
  (dolist (value '(-32769 32768))
    (check (handler-case (progn (entry "WRITE-SIGNED" r value) nil)
             (type-error (condition)
               (and (eql (type-error-datum condition) value)
                    (equal (type-error-expected-type condition) '(signed-byte 16))))) :signed-write-error)
    (check (= (nth-value 1 (entry "OBSERVE" r)) -32768) :signed-refused-unchanged))
  (check (handler-case (progn (entry "WRITE-DATA" r (make-array 3)) nil)
           (type-error () t)) :wrong-array-refusal)
  (check (handler-case (progn (entry "WRITE-DATA" r (make-array 2 :element-type '(unsigned-byte 64))) nil)
           (type-error () t)) :u64-refusal)
  (entry "UNBIND-U" r)
  (check (not (entry "BOUND-U" r)) :unbound-distinct-from-nil)
  (check (handler-case (progn (entry "OBSERVE" r) nil)
           (unbound-slot (condition)
             (and (eq (unbound-slot-instance condition) r)
                  (eq (cell-error-name condition) 'snowgrave.native-authored::u)))) :ordinary-unbound)
  (check (= (handler-bind ((unbound-slot (lambda (c) (invoke-restart (find-restart 'store-value c) 255))))
              (nth-value 0 (entry "OBSERVE" r))) 255) :store-value-restart)
  (check (entry "BOUND-U" r) :restart-bound)
  (entry "UNBIND-DATA" r)
  (check (not (entry "BOUND-DATA" r)) :array-unbound)
  (check (handler-case (progn (entry "OBSERVE" r) nil)
           (unbound-slot (condition)
             (and (eq (unbound-slot-instance condition) r)
                  (eq (cell-error-name condition) 'snowgrave.native-authored::data)))) :array-unbound-error)
  (check (null (handler-bind ((unbound-slot (lambda (c) (invoke-restart (find-restart 'store-value c) nil))))
                 (nth-value 4 (entry "OBSERVE" r)))) :array-store-nil-restart)
  (check (entry "BOUND-DATA" r) :array-nil-bound)
  (check (handler-case (progn (entry "BOOT" :invalid) nil)
           (type-error (condition) (eq (type-error-datum condition) :invalid))) :constructor-type-error)
  (check (handler-case (progn (entry "OBSERVE") nil)
           (program-error () t)) :entry-arity-error)
  (check (handler-case (progn (entry "WRITE-U" nil 5) nil)
           (snowgrave:domain-violation () t)) :entry-domain)
  (check (handler-case (progn (snowgrave.mezzano-materializer:admit-supervisor-unit '(:native-authored-typed)) nil)
           (error () t)) :unsupported-module-refused))
(defun miss-retry-history (layouts record)
  (let* ((package (symbol-package (getf (first layouts) :native-class)))
         (gf (let ((found nil))
               (do-symbols (name package)
                 (when (and (fboundp name) (typep (fdefinition name) 'generic-function)
                            (eq (mezzano.clos:generic-function-name (fdefinition name)) 'snowgrave.native-authored::u))
                   (setf found (fdefinition name)))) found))
         (count 0))
    (check gf :genuine-native-generic)
    (check (= (handler-bind
                  ((simple-error
                     (lambda (condition)
                       (let* ((args (simple-condition-format-arguments condition)) (tuple (third args)))
                         (check (and (eq (first args) gf) (eq (second args) 'snowgrave.native-authored::u)
                                     (consp tuple) (eql (car tuple) 17) (null (cdr tuple))) :miss-native-gf-identity)
                         ;; The actual native continuation uses this same
                         ;; mutable argument tuple, rather than a copied proxy.
                         (setf (car tuple) record))
                       (incf count)
                       (check (find-restart 'continue condition) :native-miss-retry)
                       (invoke-restart 'continue))))
                (funcall gf 17)) 255) :miss-retry-result)
    (check (= count 1) :miss-retry-count)))

(defun run ()
  (let* ((arrays (mapcar (lambda (type) (make-array 3 :element-type type :area :wired))
                       '((unsigned-byte 8) (unsigned-byte 16) (unsigned-byte 32))))
         (data (third arrays)) (r (entry "BOOT" data))
         (layouts (snowgrave.mezzano-materializer:native-unit-layouts '(:native-authored-typed)))
         (leaf (find 'snowgrave.native-authored::leaf layouts :key (lambda (x) (getf x :class)))))
    (check (= (getf leaf :payload-bytes) 24) :real-native-payload)
    (check (equal (getf leaf :ancestors) '(snowgrave.native-authored::leaf snowgrave.native-authored::left snowgrave.native-authored::right)) :frozen-multiple-inheritance)
    (check (equal (mapcar (lambda (x) (getf x :byte-offset)) (getf leaf :fields)) '(4 8 10 12 16)) :actual-locations)
    (mezzano.supervisor:debug-print-line "SNOWGRAVE-MATERIALIZER-NATIVE-PAYLOAD24")
    (dolist (array arrays)
      (check (eq (entry "WRITE-DATA" r array) array) :finite-array-union))
    (entry "WRITE-DATA" r data)
    (negative-round r)
    (entry "WRITE-DATA" r data)
    (let ((other (entry "OTHER-BOOT" nil)))
      (check (handler-case (progn (entry "OBSERVE" other) nil)
               (snowgrave:domain-violation (condition)
                 (eq (first (snowgrave:violation-arguments condition)) other))) :wrong-unit-refusal)
      (multiple-value-bind (u signed wide flag data) (entry "OTHER-OBSERVE" other)
        (check (and (= u 255) (= signed -32768) (= wide 4294967295) (= flag 1) (null data)) :wrong-unit-unchanged)))
    (check (handler-case
               (progn (snowgrave.mezzano-materializer::expand-record-operation :write
                         '(record 'unknown-slot value '(snowgrave.native-authored::leaf)) layouts) nil)
             (error () t)) :unknown-slot-refused-before-emission)
    (miss-retry-history layouts r)
    (let* ((thread (mezzano.supervisor:current-thread))
           (before (mezzano.supervisor:thread-bytes-consed thread)))
      (setf *positive-control* (cons (cons nil nil) (cons nil nil)))
      (check (= (- (mezzano.supervisor:thread-bytes-consed thread) before) 48) :meter))
    (mezzano.supervisor:debug-print-line "SNOWGRAVE-MATERIALIZER-POSITIVE48")
    (check (eq (mezzano.supervisor::%call-on-wired-stack-without-interrupts #'wired-entry nil r data) :passed) :wired-return)
    (mezzano.supervisor:debug-print-line "SNOWGRAVE-MATERIALIZER-NATIVE-PASSED")))
