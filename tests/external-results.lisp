(in-package #:snowgrave.tests)

(defpackage #:snowgrave.external.results.fixture (:use #:cl))

(defun value-provenance-scaling-tests ()
  ;; Count actual cold analysis visits rather than wall-clock thresholds.
  ;; Repeated syntax under different lexical bindings must still be analysed
  ;; in its own scope; this regression does not rely on a form-only cache.
  (let* ((build (snowgrave.sbcl::make-build
                 :identity '(value-provenance-scaling)
                 :source (snowgrave:make-authored-source nil :identity '(value-provenance-scaling))))
         (raw (fdefinition 'snowgrave.sbcl::raw-value-domain)) (visits 0))
    (unwind-protect
         (progn
           (setf (fdefinition 'snowgrave.sbcl::raw-value-domain)
                 (lambda (build form) (incf visits) (funcall raw build form)))
           (dolist (operator '(reverse car list* append values load-time-value identity))
             (dolist (origin '(:unknown :external-result))
               (let ((form 'x) (snowgrave.sbcl::*argument-domains* (list (cons 'x origin))))
                 (dotimes (i 64) (setf form (list operator form)))
                 (setf visits 0)
                 (check (eq origin (snowgrave.sbcl::value-domain build form)))
                 (check (= visits 65)))))
           (dolist (origin '(:unknown :external-result))
             (let ((form 'x) (snowgrave.sbcl::*argument-domains* (list (cons 'x origin))))
               (dotimes (i 64) (setf form (list 'car (list 'list form))))
               (setf visits 0)
               (check (eq origin (snowgrave.sbcl::value-domain build form)))
               (check (= visits 129))))
           (dolist (domain '(string :unknown :external-result))
             (let ((snowgrave.sbcl::*argument-domains* (list (cons 'x domain))))
               (check (eq domain (snowgrave.sbcl::value-domain build '(reverse x))))))
           (let ((snowgrave.sbcl::*argument-domains* '((x . :unknown) (y . :external-result))))
             ;; Secondary values have their own tuple origin; they must not
             ;; falsely classify the primary unknown value as external.
             (check (eq :unknown (snowgrave.sbcl::value-domain build '(values x y))))))
      (setf (fdefinition 'snowgrave.sbcl::raw-value-domain) raw))))

(defun external-result-tests ()
  (value-provenance-scaling-tests)
  (let* ((*package* (find-package :snowgrave.external.results.fixture))
         (box (intern "BOX")) (slot (intern "PAYLOAD")) (entry (intern "ENTRY"))
         (external (intern "EXTERNAL-BOX")) (pair (intern "EXTERNAL-PAIR"))
         (factory (intern "EXTERNAL-BYTES")) (alias (intern "EXTERNAL-ALIAS"))
         (tuple (intern "EXTERNAL-TUPLE")) (zero (intern "EXTERNAL-ZERO"))
         (bytes (intern "*BYTES*")) (log (intern "*LOG*"))
         (serial 0) (write-byte (intern "STORE-OCTET")) (tuple-entry (intern "TUPLE-ENTRY"))
         (write-any (intern "STORE-ANY")) (boot (intern "BOOT")) (observe-error (intern "OBSERVE-ERROR"))
         (zero-entry (intern "ZERO-ENTRY")) (guarded (intern "GUARDED-BYTES")))
    (dolist (form (read-from-string
                  "((cl:defclass box () ((payload :initarg :payload)))
                    (defvar *bytes*) (defvar *log*)
                    (defun external-box () (make-instance 'box))
                    (defun external-pair () (values 17 (make-instance 'box)))
                    (defun external-bytes ()
                      (push :factory *log*)
                      (setf *bytes* (make-array 1 :element-type '(unsigned-byte 8) :initial-element 19)))
                    (defun external-alias (data) (push :alias *log*) data)
                    (defun external-tuple () (let ((data (external-bytes))) (values data data :native)))
                    (defun external-zero () (push :zero *log*) (values)))")) (eval form))
    (labels ((close-forms (forms name &rest options)
               (apply #'snowgrave:close-source-unit (list :forms forms) :unit-name (list name)
                      :closed-classes (list box) :universe (list box 'number 'symbol)
                      :entries (list entry) :external-domains (list (list entry nil))
                      :external-operations (list external pair) options))
             (refused (forms feature &rest options)
               (let ((condition (handler-case (apply #'close-forms forms (list :external-result (incf serial)) options)
                                  (snowgrave:snowgrave-error (c) c))))
                 (check (typep condition 'snowgrave:snowgrave-error))
                 (check (eq (snowgrave:error-feature condition) feature)))))
      ;; Each native run returns true. Neither no arguments, a scalar input,
      ;; nor an unchanged external binding proves the returned class identity.
      (dolist (body '("(typep (external-box) 'box)"
                      "(typep (funcall #'external-box) 'box)"
                      "(typep (apply #'external-box nil) 'box)"
                      "(typep (multiple-value-call #'external-box) 'box)"
                      "(let ((value (external-box))) (typep value 'box))"
                      "(typep (car (list (external-box))) 'box)"
                      "(typep (car (reverse (list (external-box)))) 'box)"
                      "(typep (car (append nil (list (external-box)))) 'box)"
                      "(typep (if t (external-box) nil) 'box)"
                      "(typep (if (integerp 17) (external-box) (slot-value (make-instance 'box) 'payload)) 'box)"
                      "(multiple-value-bind (ignored value) (external-pair)
                         (declare (ignore ignored)) (typep value 'box))"
                      "(destructuring-bind (ignored value) (list 17 (external-box))
                         (declare (ignore ignored)) (typep value 'box))"
                      "(eq (class-of (external-box)) (find-class 'box))"))
        (let ((forms (read-from-string (format nil "((cl:defclass box () ((payload :initarg :payload)))
                                                    (defun entry () ~A))" body))))
          (dolist (form forms) (eval form))
          (check (funcall entry))
          (refused forms :external-result-class-observation)))
      (refused (read-from-string "((cl:defclass box () ((payload :initarg :payload)))
                                   (defun helper (value) (typep value 'box))
                                   (defun entry () (helper (external-box))))") :external-result-class-observation)
      (refused (read-from-string "((cl:defclass box () ((payload :initarg :payload)))
                                   (defun entry () (make-instance 'box :payload (external-box))))") :external-result-state)
      (refused (read-from-string "((cl:defclass box () ((payload :initarg :payload)))
                                   (defun entry () (external-box)))") :external-result-escape)
      (refused (read-from-string "((cl:defclass box () ((payload :initarg :payload)))
                                   (defgeneric inspect-box (value))
                                   (defmethod inspect-box ((value box)) t)
                                   (defun entry () (inspect-box (external-box))))")
               :external-result-dispatch :closed-generics (list (intern "INSPECT-BOX")))
      (dolist (domain (list t box 'function 'list 'simple-vector '(simple-array t (*))
                           '(simple-array number (*)) '(satisfies integerp) '(unsigned-byte -1)))
        (refused (read-from-string "((cl:defclass box () ()) (defun entry () 17))")
                 :external-return-contract :external-return-domains (list (list external (list domain)))))
      (refused (read-from-string "((cl:defclass box () ()) (defun entry () 17))")
               :external-return-contract :external-return-domains (list (list external '(number)) (list external '(number)))))
    ;; A real source guard can establish the same native storage fact without
    ;; a result promise. It executes normally; invalid native class returns
    ;; are never reinterpreted as a closed record by the guard.
    (let* ((forms (read-from-string "((cl:defclass box () ())
                                     (defun entry ()
                                       (let ((data (external-bytes)))
                                         (if (typep data '(simple-array (unsigned-byte 8) (*))) data nil))))"))
           (unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(guarded-native-external-result)
                   :closed-classes (list box) :universe (list box) :entries (list entry)
                   :external-domains (list (list entry nil)) :external-operations (list factory))))
      (progv (list log bytes) (list nil nil)
        (check (eq (funcall (snowgrave:unit-function unit entry)) (symbol-value bytes)))))
    (let* ((forms (read-from-string
                  "((cl:defclass box () ((payload :initarg :payload)))
                    (defun boot () (make-instance 'box :payload 72))
                    (defun store-octet (value)
                      (let ((data (external-bytes)))
                        (setf (aref data 0) value)
                        (values data (aref data 0) (eq data (external-alias data)))))
                    (defun store-any (value)
                      (let ((data (external-bytes)))
                        (setf (aref data 0) value)
                        (values data (aref data 0) (eq data (external-alias data)))))
                    (defun observe-error (condition value)
                      (let ((datum (type-error-datum condition)))
                        (values (if (typep datum 'box) (slot-value datum 'payload) nil)
                                (if (and (typep datum 'box) (typep value 'box)) (eq datum value) nil)
                                (type-error-expected-type condition))))
                    (defun tuple-entry ()
                      (multiple-value-bind (data alias tag) (external-tuple)
                        (values (eq data alias) (aref data 0) tag)))
                    (defun zero-entry () (external-zero))
                    (defun guarded-bytes ()
                      (let ((data (external-bytes)))
                        (if (typep data '(simple-array (unsigned-byte 8) (*))) data nil))))"))
           (entries (list write-byte write-any boot observe-error tuple-entry zero-entry guarded))
           (contracts (list (list factory '((simple-array (unsigned-byte 8) (*))))
                            (list alias '((simple-array (unsigned-byte 8) (*))))
                            (list tuple '((simple-array (unsigned-byte 8) (*))
                                          (simple-array (unsigned-byte 8) (*)) symbol))
                            (list zero nil)))
           (unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(native-external-storage)
                   :closed-classes (list box) :universe (list box 'number) :entries entries
                   :external-domains (list (list write-byte '(number)) (list write-any '(t)) (list boot nil)
                                           (list observe-error '(t t)) (list tuple-entry nil)
                                           (list zero-entry nil) (list guarded nil))
                   :external-operations (list factory alias tuple zero) :external-return-domains contracts)))
      (dolist (form forms) (eval form))
      (let ((native (funcall boot)) (record (funcall (snowgrave:unit-function unit boot))))
        (progv (list log bytes) (list nil nil)
          ;; The ordinary caller catches the real type condition; this tests
          ;; its payload's logical interpretation, not in-unit handler closure.
          (let ((condition (handler-case (funcall write-any native) (type-error (c) c))))
            (check (equal (multiple-value-list (funcall observe-error condition native)) '(72 t (unsigned-byte 8)))))
          (let ((condition (handler-case (funcall (snowgrave:unit-function unit write-any) record) (type-error (c) c))))
            (check (equal (multiple-value-list (funcall (snowgrave:unit-function unit observe-error) condition record))
                          '(72 t (unsigned-byte 8)))))
          (check (= 19 (aref (symbol-value bytes) 0)))))
      (loop for native in (list nil :bad "native" #'identity (funcall boot) (list (funcall boot)))
            for value in (list nil :bad "native" #'identity (funcall (snowgrave:unit-function unit boot))
                              (list (funcall (snowgrave:unit-function unit boot)))) do
        (loop for call in (list (lambda () (funcall write-any native))
                               (lambda () (funcall (snowgrave:unit-function unit write-any) value)))
              for datum in (list native value) do
          (progv (list log bytes) (list nil nil)
            (let ((condition (handler-case (funcall call) (type-error (c) c))))
              (check (typep condition 'type-error))
              (check (eq datum (type-error-datum condition)))
              (check (equal '(unsigned-byte 8) (type-error-expected-type condition)))
              (check (= 19 (aref (symbol-value bytes) 0)))
              (check (equal (symbol-value log) '(:factory)))))))
      (dolist (value '(0 255 256 -1 1/2 1.0 1000000000000000000000000000000000000000000))
        (let ((native (progv (list log bytes) (list nil nil)
                        (handler-case
                            (let ((values (multiple-value-list (funcall write-byte value))))
                              (list :ok (cdr values) (eq (first values) (symbol-value bytes)) (symbol-value log)))
                          (type-error (c) (list :error (type-error-datum c) (type-error-expected-type c)
                                                (aref (symbol-value bytes) 0) (symbol-value log))))))
              (closed (progv (list log bytes) (list nil nil)
                        (handler-case
                            (let ((values (multiple-value-list (funcall (snowgrave:unit-function unit write-byte) value))))
                              (list :ok (cdr values) (eq (first values) (symbol-value bytes)) (symbol-value log)))
                          (type-error (c) (list :error (type-error-datum c) (type-error-expected-type c)
                                                (aref (symbol-value bytes) 0) (symbol-value log)))))))
          (check (equal native closed))))
      (progv (list log bytes) (list nil nil)
        (check (equal (multiple-value-list (funcall (snowgrave:unit-function unit tuple-entry))) '(t 19 :native)))
        (check (null (multiple-value-list (funcall (snowgrave:unit-function unit zero-entry)))))
        (check (eq (funcall (snowgrave:unit-function unit guarded)) (symbol-value bytes))))
      (let ((metadata (snowgrave:unit-metadata unit)))
        (check (every (lambda (operation) (getf operation :returned-value-count-complete-p))
                      (getf metadata :external-operations)))
        (check (equal (getf (find zero (getf metadata :external-operations) :key (lambda (operation) (getf operation :identity)))
                           :returned-value-domains) nil)))
      (let* ((root (asdf:system-source-directory "snowgrave"))
             (source (merge-pathnames ".build/fresh-external-results.lisp" root))
             (metadata (merge-pathnames ".build/fresh-external-results.metadata" root)))
        (with-open-file (stream source :direction :output :if-exists :supersede) (snowgrave:write-unit-source unit stream))
        (with-open-file (stream metadata :direction :output :if-exists :supersede) (snowgrave:write-unit-metadata unit stream))
        (check (search "Fresh native external results executed."
                       (uiop:run-program (list "sbcl" "--no-sysinit" "--no-userinit" "--script"
                                               (namestring (merge-pathnames "scripts/fresh-external-results.lisp" root))
                                               (namestring source) (namestring metadata)) :output :string)))))))
