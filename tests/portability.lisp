(in-package #:snowgrave.tests)

(defun portable-source-tests ()
  (multiple-value-bind (unit package)
      (make-fixture
       :portable-bindings
       "((defclass box () ((value :initform 1)))
          (defun alias-write ()
            (let ((object (make-instance 'box)))
              (symbol-macrolet ((alias (slot-value object 'value)))
                (setq alias 9) alias)))
          (defun swap (a b) (funcall (lambda (a b) (list a b)) b a))
          (defgeneric kind (object))
          (defmethod kind ((object box)) :box)
          (defun construct () (make-instance 'box))
          (defun operator-lambda (object) ((lambda (x) (kind x)) object))
          (defun anonymous-escape (x) (funcall (let ((x 3)) (lambda () x))))
          (defun local-escape (x) (funcall (let ((x 3)) (flet ((read-it () x)) #'read-it))))
          (defun documented (n) \"A function documentation string.\" (declare (type integer n)) (+ n 1))
          (defvar *flag* nil)
          (defun flip () (setq *flag* nil))
          (defun dynamic (flag) (let ((*flag* flag)) (flip) (if *flag* :wrong :right)))
          (defun function-effects (n)
            (funcall (progn (snowgrave.tests::note-event :function) #'+)
                     (progn (snowgrave.tests::note-event :argument) n) 1))
          (defun local-direct (n) (flet ((add-one (x) (+ x 1))) (funcall #'add-one n)))
          (defun local-effects (n)
            (flet ((add-one (x) (+ x 1)))
              (funcall (progn (snowgrave.tests::note-event :function) #'add-one) n)))
          (defun local-alias (n)
            (flet ((add-one (x) (+ x 1))) (let ((f #'add-one)) (funcall f n))))
          (defun function-root (f) (identity f))
          (defun call-values (name) (multiple-value-call name))
          (defun escaped-choice (object) (if (slot-value object 'value) #'kind #'construct)))"
       "(alias-write swap construct operator-lambda anonymous-escape local-escape documented dynamic function-effects
          local-direct local-effects local-alias function-root call-values escaped-choice)"
       "((alias-write ()) (swap (t t)) (construct ()) (operator-lambda (box))
          (anonymous-escape (integer)) (local-escape (integer)) (documented (integer))
          (dynamic (t)) (function-effects (integer)) (local-direct (integer)) (local-effects (integer))
          (local-alias (integer)) (function-root (function)) (call-values (symbol)) (escaped-choice (box)))"
       "(kind)" :external '(note-event))
    (compare-entry unit package "ALIAS-WRITE" nil '((9) nil))
    (let ((root (funcall (snowgrave:unit-function unit (find-symbol "CONSTRUCT" package)))))
      (dolist (row (list (list "SWAP" '(1 2) '(((2 1)) nil))
                        (list "OPERATOR-LAMBDA" (list root) '((:box) nil))
                        (list "DOCUMENTED" '(7) '((8) nil))
                        (list "DYNAMIC" '(t) '((:right) nil))
                        (list "LOCAL-DIRECT" '(7) '((8) nil))
                        (list "FUNCTION-EFFECTS" '(7) '((8) (:function :argument)))))
        (destructuring-bind (name arguments expected) row
          (let ((bound (snowgrave:bind-entry unit (find-symbol name package) arguments)))
            (check (equal expected (observed-call bound nil)) "Portable configured binding failed: ~A" name))))
      (dolist (row (list (list "ANONYMOUS-ESCAPE" '(7)) (list "LOCAL-ESCAPE" '(7))
                        (list "LOCAL-EFFECTS" '(7)) (list "LOCAL-ALIAS" '(7))
                        (list "FUNCTION-ROOT" (list #'+))
                        (list "CALL-VALUES"
                              (list (snowgrave::class-description-allocator
                                     (first (snowgrave::unit-plan-layouts (snowgrave::closed-unit-plan unit))))))
                        (list "ESCAPED-CHOICE" (list root))))
        (check (eq :configuration-indirect-call
                   (handler-case
                       (progn (snowgrave:bind-entry unit (find-symbol (first row) package) (second row)) nil)
                     (snowgrave:snowgrave-error (condition) (snowgrave:error-feature condition))))
               "Escaping callable was relocated or published: ~A" (first row)))))
  (portable-transfer-tests))

(defun portable-transfer-tests ()
  (multiple-value-bind (unit package)
      (make-fixture
       :portable-transfers
       "((defgeneric operation (x))
          (defmethod operation ((x integer)) (+ x 1))
          (defun escape-block () (block done (return-from done #'operation) nil))
          (defun escape-fallthrough (control)
            (block done (when (aref control 0) (return-from done nil)) #'operation))
          (defun escape-assignment () (let ((f nil)) (setq f #'operation) (list f)))
          (defun escape-initializer ()
            (let ((f #'operation)) (prog1 (list f) (setq f nil))))
          (defun escape-special ()
            (let ((f #'operation)) (declare (special f)) (list f)))
          (defun escape-multiple-native () (multiple-value-call #'list #'operation))
          (defun escape-multiple-lambda ()
            (multiple-value-call (lambda (f) (list f)) #'operation))
          (defun native-place (array)
            (setf (aref (progn (snowgrave.tests::note-event :place) array)
                        (progn (snowgrave.tests::note-event :index) 0))
                  (progn (snowgrave.tests::note-event :value) 11)))
          (defun native-simple (array) (setf (svref array 0) 29))
          (defun native-bits (bits)
            (setf (sbit bits 0) 1 (bit bits 1) 1)
            (+ (sbit bits 0) (bit bits 1)))
          (defun native-table (table) (setf (gethash :key table :ignored) 13))
          (defvar *multiple-value* 0)
          (defun native-values (n)
            (multiple-value-bind (*multiple-value* missing) (values n)
              (declare (special *multiple-value*) (type integer *multiple-value*))
              (setq *multiple-value* (+ *multiple-value* 1))
              (values *multiple-value* missing)))
          (defun escape-place (array) (setf (aref array 0) #'operation))
          (defun escape-load-time () (load-time-value #'operation)))"
       "(escape-block escape-fallthrough escape-assignment escape-initializer escape-special
          escape-multiple-native escape-multiple-lambda native-place native-simple native-bits native-table native-values escape-place escape-load-time)"
       "((escape-block ()) (escape-fallthrough (vector)) (escape-assignment ())
          (escape-initializer ()) (escape-special ()) (escape-multiple-native ()) (escape-multiple-lambda ())
          (native-place (vector)) (native-simple (simple-vector)) (native-bits (simple-bit-vector))
          (native-table (hash-table)) (native-values (integer)) (escape-place (vector)) (escape-load-time ()))"
       "(operation)" :universe "(integer)" :external '(note-event))
    (dolist (row (list (list "ESCAPE-BLOCK" nil)
                      (list "ESCAPE-FALLTHROUGH" (list (vector nil)))
                      (list "ESCAPE-ASSIGNMENT" nil) (list "ESCAPE-INITIALIZER" nil)
                      (list "ESCAPE-SPECIAL" nil) (list "ESCAPE-MULTIPLE-NATIVE" nil)
                      (list "ESCAPE-MULTIPLE-LAMBDA" nil) (list "ESCAPE-PLACE" (list (vector nil)))))
      (check (eq :configuration-indirect-call
                 (handler-case
                     (progn (snowgrave:bind-entry unit (find-symbol (first row) package) (second row)) nil)
                   (snowgrave:snowgrave-error (condition) (snowgrave:error-feature condition))))
             "Owned callable escaped a value transfer: ~A" (first row)))
    (check (eq :configuration-form
               (handler-case
                   (progn (snowgrave:bind-entry unit (find-symbol "ESCAPE-LOAD-TIME" package) nil) nil)
                 (snowgrave:snowgrave-error (condition) (snowgrave:error-feature condition))))
           "Authored LOAD-TIME-VALUE bypassed configured call auditing")
    (let ((array (vector 0)) (bits (make-array 2 :element-type 'bit :initial-element 0))
          (table (make-hash-table)))
      (dolist (row (list (list "NATIVE-PLACE" (list array) '((11) (:place :index :value)))
                        (list "NATIVE-SIMPLE" (list array) '((29) nil))
                        (list "NATIVE-BITS" (list bits) '((2) nil))
                        (list "NATIVE-TABLE" (list table) '((13) nil))
                        (list "NATIVE-VALUES" '(7) '((8 nil) nil))))
        (destructuring-bind (name arguments expected) row
          (check (equal expected
                        (observed-call (snowgrave:bind-entry unit (find-symbol name package) arguments) nil))
                 "Native configured SETF changed evaluation or result: ~A" name)))
      (check (and (= (aref array 0) 29) (= (sbit bits 0) 1) (= (sbit bits 1) 1)
                  (= (gethash :key table) 13))
             "Native configured SETF did not update its borrowed data"))))
