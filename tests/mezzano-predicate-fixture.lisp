(defpackage #:snowgrave.mezzano-predicate-fixture (:use #:cl))
(in-package #:snowgrave.mezzano-predicate-fixture)

(defstruct (entity :sealed (:area :wired)) (id 0 :type fixnum) roots)
(snowgrave.mezzano-access:define-record-predicate entity entity-p)
(defstruct (base (:area :wired)) (id 0 :type fixnum))
(defstruct (child (:include base) :sealed (:area :wired)) roots)
(snowgrave.mezzano-access:define-record-predicate child child-p)
(defstruct (named :sealed (:area :wired) (:predicate actual-named-p)) value)
(snowgrave.mezzano-access:define-record-predicate named actual-named-p)
(defstruct (foreign :sealed (:area :wired)) value)
(defstruct (effectful :sealed (:area :wired)) value)
(defvar *effects* nil)
(defun effectful-p (object)
  (push :predicate *effects*) (typep object 'effectful))
(defun wrong-p (object) (typep object 'foreign))
(defstruct (rebound :sealed (:area :wired)) value)
(snowgrave.mezzano-access:define-record-predicate rebound rebound-p)
(defun rebound-p (object)
  (push :rebound *effects*) (typep object 'rebound))

;; A global marker is never admission; the actual lexical marker is required.
(defmacro snowgrave.mezzano-access::%admitted-access-scope ()
  '(return-from never-the-entry (values nil :wrong-global)))

(defun ordinary-entity-p (object) (entity-p object))
(defun ordinary-base-p (object) (base-p object))
(snowgrave.mezzano-access:define-admitted-entry bounded-entity-p (object) (values nil :bad-count)
  (declare (optimize (safety 3) (speed 1)))
  (entity-p object))
(snowgrave.mezzano-access:define-admitted-entry bounded-child-p (object) (values nil :bad-count)
  (declare (optimize (safety 3) (speed 1)))
  (child-p object))
(snowgrave.mezzano-access:define-admitted-entry bounded-named-p (object) (values nil :bad-count)
  (declare (optimize (safety 3) (speed 1)))
  (actual-named-p object))
(snowgrave.mezzano-access:define-admitted-entry bounded-funcall-p (object) (values nil :bad-count)
  (declare (optimize (safety 3) (speed 1)))
  (funcall #'entity-p object))
(snowgrave.mezzano-access:define-admitted-entry bounded-local-p (object) (values nil :bad-count)
  (declare (optimize (safety 3) (speed 1)))
  (flet ((entity-p (object) (declare (ignore object)) :local)) (entity-p object)))
(snowgrave.mezzano-access:define-admitted-entry bounded-notinline-p (object) (values nil :bad-count)
  (declare (optimize (safety 3) (speed 1)) (notinline entity-p))
  (entity-p object))
