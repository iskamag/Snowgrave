(in-package #:snowgrave.tests)

(defun publication-fixture ()
  (make-fixture
   :publication
   "((defclass component () ())
      (defclass holder () ((left :initarg :left :accessor left-value)
                          (right :initarg :right :accessor right-value)))
      (defun construct () (make-instance 'holder :left (make-instance 'component)
                                               :right (make-instance 'component)))
      (defun read-left (h) (left-value h))
      (defun read-right (h) (right-value h))
      (defun write-left (h value) (setf (left-value h) value))
      (defun write-right (h value) (setf (right-value h) value))
      (defun recursive-write (h value n)
        (declare (type fixnum n))
        (if (zerop n) (values (setf (left-value h) value) :done)
            (recursive-write h value (1- n))))
      (defun write-alias (data value) (setf (slot-value (aref data 0) 'left) value))
      (defun clear-alias (data) (slot-makunbound (aref data 0) 'left)))"
   "(construct read-left read-right write-left write-right recursive-write write-alias clear-alias)"
   "((construct ()) (read-left (holder)) (read-right (holder))
      (write-left (holder t)) (write-right (holder t)) (recursive-write (holder t fixnum))
      (write-alias (vector t)) (clear-alias (vector)))"
   "(left-value (setf left-value) right-value (setf right-value))"))

(defun publication-alias-tests ()
  (multiple-value-bind (unit package) (publication-fixture)
    (flet ((entry (name) (find-symbol name package)))
      (let* ((construct (snowgrave:unit-function unit (entry "CONSTRUCT")))
             (a (funcall construct)) (b (funcall construct))
             (left (snowgrave:unit-function unit (entry "READ-LEFT")))
             (initial (funcall left a))
             (replacement (funcall (snowgrave:unit-function unit (entry "READ-RIGHT")) a))
             (data (vector a)) (arguments (list data replacement))
             (writer (snowgrave:bind-entry unit (entry "WRITE-ALIAS") arguments))
             (clearer (snowgrave:bind-entry unit (entry "CLEAR-ALIAS") (list data)))
             (roles (fixture-read package "((holder left))"))
             (reader (snowgrave:bind-entry unit (entry "READ-LEFT") (list a) :roles roles))
             (reader-recipe (first (snowgrave::closed-unit-configured-bindings unit)))
             (reader-generation (snowgrave::configured-binding-generation reader-recipe)))
        (check (functionp writer) "Configured bridge is not a function")
        (setf (second arguments) nil)
        (check-signals (error) (funcall writer) "Alias writer bypassed the first seal")
        (check-signals (error) (funcall clearer) "Alias unbinding bypassed the first seal")
        (setf (aref data 0) b)
        (check (eq b (funcall clearer)) "Seal blocked an unsealed owner of the same layout")
        (check (eq replacement (funcall writer)) "Binding resampled its caller's argument list")
        (check (eq replacement (funcall left b)) "Alias writer failed on an unsealed owner")
        (let ((second-reader (snowgrave:bind-entry unit (entry "READ-LEFT") (list b) :roles roles)))
          (check (eq reader-generation (snowgrave::configured-binding-generation reader-recipe))
                 "Publication rebuilt a binding with no mutation dependency")
          (check-signals (error) (funcall clearer) "Alias unbinding bypassed the second seal")
          ;; Cold compiler state must not be reachable through a runtime lookup.
          (let ((registry (snowgrave::closed-unit-seals unit)))
            (unwind-protect
                 (progn
                   (setf (snowgrave::closed-unit-seals unit) nil)
                   (check (eq replacement (funcall writer)) "Static seal guard consulted the unit")
                   (setf (aref data 0) a)
                   (check-signals (error) (funcall writer) "Second publication lost the first seal")
                   (check (and (eq initial (funcall reader)) (eq replacement (funcall second-reader)))
                          "Returned bridges lost their independent configurations"))
              (setf (snowgrave::closed-unit-seals unit) registry))))))))

(defun publication-exchange-tests ()
  (multiple-value-bind (unit package) (publication-fixture)
    (flet ((entry (name) (find-symbol name package)))
      (let* ((construct (snowgrave:unit-function unit (entry "CONSTRUCT")))
             (a (funcall construct)) (b (funcall construct))
             (left (snowgrave:unit-function unit (entry "READ-LEFT")))
             (initial (funcall left a))
             (other (funcall (snowgrave:unit-function unit (entry "READ-RIGHT")) a))
             (writer (snowgrave:bind-entry unit (entry "WRITE-LEFT") (list a other)
                                          :roles (fixture-read package "((holder (left right)))"))))
        ;; Both roles may temporarily contain A, but B remains admitted.
        (funcall (snowgrave:unit-function unit (entry "WRITE-RIGHT")) a initial)
        (snowgrave:bind-entry unit (entry "READ-LEFT") (list b)
                             :roles (fixture-read package "((holder left))"))
        (check (eq other (funcall writer)) "Rebuilding shrank the original exchange identity set")
        (check (eq other (funcall left a)) "Rebuilt exchange writer lost its physical store")))))

(defun publication-recursion-tests ()
  (multiple-value-bind (unit package) (publication-fixture)
    (flet ((entry (name) (find-symbol name package)))
      (let* ((root (funcall (snowgrave:unit-function unit (entry "CONSTRUCT"))))
             (initial (funcall (snowgrave:unit-function unit (entry "READ-LEFT")) root))
             (other (funcall (snowgrave:unit-function unit (entry "READ-RIGHT")) root))
             (writer (snowgrave:bind-entry unit (entry "RECURSIVE-WRITE") (list root other 3)))
             (restore (snowgrave:bind-entry unit (entry "RECURSIVE-WRITE") (list root initial 3))))
        (check (equal (list other :done) (multiple-value-list (funcall writer)))
               "Recursive entry lost arguments or multiple values")
        (funcall restore)
        (snowgrave:bind-entry unit (entry "READ-LEFT") (list root)
                             :roles (fixture-read package "((holder left))"))
        (check-signals (error) (funcall writer) "Recursive entry bypassed replacement code")
        (check (equal (list initial :done) (multiple-value-list (funcall restore)))
               "Retirement broke the replacement generation's recursive helper")))))

(defun publication-failure-tests ()
  (multiple-value-bind (unit package) (publication-fixture)
    (flet ((entry (name) (find-symbol name package)))
      (let* ((root (funcall (snowgrave:unit-function unit (entry "CONSTRUCT"))))
             (replacement (funcall (snowgrave:unit-function unit (entry "READ-RIGHT")) root))
             (one (snowgrave:bind-entry unit (entry "WRITE-LEFT") (list root replacement)))
             (two (snowgrave:bind-entry unit (entry "WRITE-LEFT") (list root replacement)))
             (bindings (snowgrave::closed-unit-configured-bindings unit))
             (registry (snowgrave::closed-unit-seals unit))
             (writers (snowgrave::closed-unit-sealed-writers unit))
             (generations (mapcar #'snowgrave::configured-binding-generation bindings))
             (targets (mapcar (lambda (binding) (fdefinition (snowgrave::configured-binding-name binding))) bindings))
             (packages (list-all-packages))
             (wrapper (fdefinition 'snowgrave::compile-sealed-writer)) (staged nil))
        (dolist (phase '(:staging :commit))
          (unwind-protect
               (progn
                 (setf (fdefinition 'snowgrave::compile-sealed-writer)
                       (lambda (&rest arguments)
                         (setf staged (mapcar #'package-name (set-difference (list-all-packages) packages)))
                         (when (eq phase :staging) (error "Injected staging failure"))
                         (let ((result (apply wrapper arguments)))
                           ;; Force the function-cell installer to fail after
                           ;; replacement generation targets have been set.
                           (when result (setf (third result) :invalid-compiled-function))
                           result)))
                 (check-signals (error)
                   (snowgrave:bind-entry unit (entry "READ-LEFT") (list root)
                                        :roles (fixture-read package "((holder left))"))
                   "Injected publication ~S failure was ignored" phase))
            (setf (fdefinition 'snowgrave::compile-sealed-writer) wrapper))
          (check (= 3 (count-if (lambda (name) (search "SNOWGRAVE.GENERATION." name)) staged))
                 "Failure test did not stage the old implementations")
          (check (and (eq registry (snowgrave::closed-unit-seals unit))
                      (eq writers (snowgrave::closed-unit-sealed-writers unit))
                      (eq bindings (snowgrave::closed-unit-configured-bindings unit))
                      (every #'eq generations (mapcar #'snowgrave::configured-binding-generation bindings))
                      (every #'eq targets (mapcar (lambda (binding) (fdefinition (snowgrave::configured-binding-name binding))) bindings)))
                 "Failed ~S changed published bindings or seals" phase)
          (check (null (set-difference (list-all-packages) packages)) "Failed ~S leaked private packages" phase))
        (check (and (eq replacement (funcall one)) (eq replacement (funcall two)))
               "Failed staging damaged previously returned functions")
        ;; Retirement errors happen after commit and must not erase live code.
        (let* ((retired (snowgrave::configured-generation-package (first generations)))
               (discard (fdefinition 'snowgrave::discard-configuration-package)))
          (unwind-protect
               (progn
                 (setf (fdefinition 'snowgrave::discard-configuration-package)
                       (lambda (package)
                         (if (eq package retired) (error "Injected retirement failure")
                             (funcall discard package))))
                 (let ((reader (handler-bind ((warning #'muffle-warning))
                                 (snowgrave:bind-entry unit (entry "READ-LEFT") (list root)
                                                      :roles (fixture-read package "((holder left))")))))
                   (check (eq replacement (funcall reader))
                          "Retirement failure revoked the successfully published binding")))
            (setf (fdefinition 'snowgrave::discard-configuration-package) discard)
            (when (package-name retired) (funcall discard retired)))
          (check (and (eq replacement (funcall one)) (eq replacement (funcall two)))
                 "Retirement failure destroyed newly published implementations"))))))

(defun configuration-publication-tests ()
  (publication-alias-tests)
  (publication-exchange-tests)
  (publication-recursion-tests)
  (publication-failure-tests))
