(in-package #:snowgrave.tests)
(defpackage #:snowgrave.external.guards.fixture (:use #:cl))

(defun external-value-guard-tests ()
  (let* ((*package* (find-package :snowgrave.external.guards.fixture))
         (cap-type (intern "CAP")) (guard (intern "GUARD-CAP")) (guard-b (intern "GUARD-OTHER"))
         (get-data (intern "DATA")) (alias (intern "ALIAS-CAP")) (fresh (intern "FRESH-CAP"))
         (box (intern "BOX")) (reader (intern "BOX-PAYLOAD")) (boot (intern "BOOT"))
         (entry (intern "ENTRY")) (authority (intern "*AUTHORITY*")) (other (intern "*OTHER*"))
         (active (intern "*ACTIVE*")) (events (intern "*EVENTS*")) (serial 0)
         (key '(:test-guard :version 1)) (key-b '(:other-guard :version 1)))
    (dolist (form (read-from-string
                  "((defstruct cap data)
                    (defvar *authority*) (defvar *other*) (defvar *active*) (defvar *events*)
                    (defun guard-cap (candidate) (and *active* (eq candidate *authority*)))
                    (defun guard-other (candidate) (and *active* (eq candidate *other*)))
                    (defun data (cap) (push :data *events*) (cap-data cap))
                    (defun alias-cap (cap) (push :alias *events*) cap)
                    (defun fresh-cap () (make-cap :data (make-array 1 :element-type '(unsigned-byte 8) :initial-element 19))))"))
      (eval form))
    (let ((cap (funcall fresh)) (cap-b (funcall fresh)))
      (progv (list authority other active events) (list cap cap-b t nil)
        (labels ((declaration ()
                   (list :closed-classes (list box) :universe (list box 'number t)
                         :closed-generics (list reader)
                         :entries (list boot entry)
                         :external-domains `((,boot (t)) (,entry (,box t)))
                         :external-operations (list guard guard-b get-data alias fresh)
                         :external-value-guards (list (list key guard cap-type) (list key-b guard-b cap-type))
                         :external-argument-domains `((,get-data ((:external-value ,key))) (,alias ((:external-value ,key))))
                         :external-return-domains `((,guard (boolean)) (,guard-b (boolean))
                                                   (,get-data ((simple-array (unsigned-byte 8) (*))))
                                                   (,alias ((:external-value ,key))))))
                 (forms (body)
                   (append (read-from-string
                            "((cl:defclass box () ((payload :initarg :payload :accessor box-payload)))
                              (defun boot (cap)
                                (if (guard-cap cap) (make-instance 'box :payload cap) nil)))")
                           (list (list 'defun entry (read-from-string "(record value)") body))))
                 (close-body (body &optional (options (declaration)))
                   (apply #'snowgrave:close-source-unit (list :forms (forms body))
                          :unit-name (list :installed-guard-test (incf serial)) options))
                 (refused (body feature &optional (options (declaration)))
                   (let ((c (handler-case (close-body body options) (snowgrave:snowgrave-error (c) c))))
                     (check (typep c 'snowgrave:snowgrave-error))
                     (check (eq feature (snowgrave:error-feature c))))))
          (let* ((body (read-from-string
                        "(let ((cap (box-payload record)))
                           (if (guard-cap cap)
                               (let ((bytes (funcall #'data cap)))
                                 (setf (aref bytes 0) value)
                                 (values cap (alias-cap cap) bytes (aref bytes 0)))
                               (values nil :rejected :authority-lost)))"))
                 (unit (close-body body))
                 (record (funcall (snowgrave:unit-function unit boot) cap))
                 (bytes (funcall (intern "CAP-DATA") cap)))
            (check (snowgrave:sg-record-p record))
            (check (null (funcall (snowgrave:unit-function unit boot) cap-b)))
            (dolist (value '(0 255))
              (setf (symbol-value events) nil)
              (multiple-value-bind (returned repeated data written)
                  (funcall (snowgrave:unit-function unit entry) record value)
                (check (eq returned cap)) (check (eq repeated cap)) (check (eq data bytes))
                (check (= value written)) (check (= value (aref bytes 0)))
                (check (equal '(:alias :data) (symbol-value events)))))
            (dolist (value (list nil 256 :bad cap record #'identity))
              (setf (aref bytes 0) 19 (symbol-value events) nil)
              (let ((c (handler-case (funcall (snowgrave:unit-function unit entry) record value) (type-error (c) c))))
                (check (typep c 'type-error)) (check (eq value (type-error-datum c)))
                (check (equal '(unsigned-byte 8) (type-error-expected-type c)))
                (check (= 19 (aref bytes 0))) (check (equal '(:data) (symbol-value events)))))
            (dolist (foreign (list nil 17 :foreign cap-b record #'identity))
              (setf (snowgrave:sg-record-read record (intern "PAYLOAD")) foreign (symbol-value events) nil)
              (check (equal '(nil :rejected :authority-lost)
                            (multiple-value-list (funcall (snowgrave:unit-function unit entry) record 0))))
              (check (null (symbol-value events))))
            (setf (snowgrave:sg-record-read record (intern "PAYLOAD")) cap)
            (sb-ext:gc :full t)
            (check (eq cap (first (multiple-value-list (funcall (snowgrave:unit-function unit entry) record 0)))))
            (setf (symbol-value active) nil (symbol-value events) nil)
            (check (equal '(nil :rejected :authority-lost)
                          (multiple-value-list (funcall (snowgrave:unit-function unit entry) record 0))))
            (check (null (symbol-value events)))
            (setf (symbol-value active) t)
            (check (= 2 (length (getf (snowgrave:unit-metadata unit) :external-value-guards)))))
          (refused (read-from-string "(data (box-payload record))") :external-argument-contract)
          (refused (read-from-string "(let ((cap (box-payload record))) (if (guard-other cap) (data cap) nil))")
                   :external-argument-contract)
          (refused (read-from-string "(let ((cap (box-payload record))) (if (guard-cap cap) (typep cap 'box) nil))")
                   :external-value-class-observation)
          (refused (read-from-string "(let ((cap (box-payload record)))
                                       (flet ((guard-cap (ignored) (declare (ignore ignored)) t))
                                         (if (guard-cap cap) (data cap) nil)))") :external-argument-contract)
          (refused (read-from-string "(if (guard-cap *authority*) (data *authority*) nil)")
                   :external-argument-contract)
          (let ((options (declaration)))
            (setf (getf options :external-value-guards) (list (list key guard cap-type) (list key guard-b cap-type)))
            (refused nil :external-value-guard-contract options))
          (let ((options (declaration)))
            (setf (getf options :external-value-guards) (list (list key guard cap-type) (list key-b guard cap-type)))
            (refused nil :external-value-guard-contract options))
          (let ((options (declaration)))
            (setf (getf options :external-value-guards) (list (list key guard box)))
            (refused nil :external-value-guard-contract options))
          (let ((options (declaration)))
            (setf (getf options :external-value-guards) (list (list key guard 'standard-object)))
            (refused nil :external-value-guard-contract options))
          (dolist (type '(snowgrave::closed-record structure-object))
            (let ((options (declaration)))
              (setf (getf options :external-value-guards) (list (list key guard type)))
              (refused nil :external-value-guard-contract options)))
          (let ((options (declaration)))
            (setf (getf options :external-return-domains)
                  (append (getf options :external-return-domains) `((,fresh ((:external-value ,key))))))
            (refused nil :external-value-return-contract options)))))))
