(in-package #:snowgrave.tests)

(defun configuration-tests ()
  (multiple-value-bind (unit package)
      (make-fixture
       :configuration
       "((defclass model () ((value :initform 1 :accessor value)))
          (defclass first-model (model) ())
          (defclass second-model (model) ())
          (defclass collector () ((model :initarg :model :accessor model)))
          (defclass callbacks () ((target :initarg :target :reader callback-target)
                                 (option :initform :key :reader callback-option)))
          (defgeneric advance (model &optional amount))
          (defmethod advance ((model first-model) &optional (amount 2))
            (incf (value model) amount))
          (defmethod advance ((model second-model) &optional (amount 3))
            (incf (value model) amount))
          (defun construct (first)
            (make-instance 'collector :model (make-instance (if first 'first-model 'second-model))))
          (defun run (collector) (advance (model collector)))
          (defun component (collector) (model collector))
          (defun replace-component (collector component) (setf (model collector) component))
          (defun clear-component (collector) (slot-makunbound collector 'model))
          (defun make-callback (function) (make-instance 'callbacks :target function))
          (defun callback (holder) (funcall (callback-target holder)))
          (defun reduce-callback (holder items) (reduce (callback-target holder) items))
          (defun reduce-option (holder) (reduce #'+ '(1 2 3) (callback-option holder) (callback-target holder))))"
       "(construct run component replace-component clear-component make-callback callback reduce-callback reduce-option)"
       "((construct (t)) (run (collector)) (component (collector))
          (replace-component (collector t)) (clear-component (collector)) (make-callback (function))
          (callback (callbacks)) (reduce-callback (callbacks list)) (reduce-option (callbacks)))"
       "(value (setf value) model (setf model) callback-target callback-option advance)")
    (flet ((entry (name) (snowgrave:unit-function unit (find-symbol name package))))
      (let* ((first (funcall (entry "CONSTRUCT") t))
             (second (funcall (entry "CONSTRUCT") nil))
             (roles (fixture-read package "((collector model))"))
             (one (snowgrave:bind-entry unit (find-symbol "RUN" package) (list first) :roles roles))
             (two (snowgrave:bind-entry unit (find-symbol "RUN" package) (list second) :roles roles)))
        (check (= 3 (funcall one)) "First configured method was not selected")
        (check (= 4 (funcall two)) "Second configured method was not selected")
        (check (= 5 (funcall one)) "Later configuration changed an earlier entry")
        (check (= 7 (funcall two)) "Native data did not remain mutable")
        (check-signals (snowgrave:snowgrave-error :configuration-dispatch)
          (snowgrave:bind-entry unit (find-symbol "RUN" package) (list first))
          "Missing configuration facts did not reject residual dispatch")
        (check-signals (snowgrave:snowgrave-error :configuration-indirect-call)
          (snowgrave:bind-entry unit (find-symbol "CALLBACK" package)
                                (list (funcall (entry "MAKE-CALLBACK") (lambda () 17))))
          "Unknown function-valued call passed the directness audit")
        (check-signals (snowgrave:snowgrave-error :configuration-indirect-call)
          (snowgrave:bind-entry unit (find-symbol "REDUCE-CALLBACK" package)
                                (list (funcall (entry "MAKE-CALLBACK") #'+) '(1 2 3)))
          "Unknown native callback passed the directness audit")
        (check-signals (snowgrave:snowgrave-error :configuration-indirect-call)
          (snowgrave:bind-entry unit (find-symbol "REDUCE-OPTION" package)
                                (list (funcall (entry "MAKE-CALLBACK") #'1+)))
          "Computed callback keyword passed the directness audit")
        (check-signals (snowgrave:snowgrave-error :configuration-arguments)
          (snowgrave:bind-entry unit (find-symbol "RUN" package) '(7) :roles roles)
          "Binder did not validate the entry's declared root domain")
        (check-signals (error)
          (funcall (entry "REPLACE-COMPONENT") first (funcall (entry "COMPONENT") second))
          "Exposed setter reconfigured a bound collector")
        (check-signals (error) (funcall (entry "CLEAR-COMPONENT") first)
          "Exposed slot-makunbound unbound a component role")
        (check-signals (error)
          (funcall (entry "REPLACE-COMPONENT") first
                   (funcall (entry "COMPONENT") (funcall (entry "CONSTRUCT") t)))
          "Same-class replacement escaped the sealed component graph")
        (check (= 7 (funcall one)) "Failed reconfiguration damaged the original binding"))))
  (configuration-callback-tests)
  (configuration-slot-error-tests)
  (configuration-late-seal-tests))

(defun configuration-late-seal-tests ()
  (multiple-value-bind (unit package)
      (make-fixture
       :configuration-late-seals
       "((defclass left () ())
          (defclass right () ())
          (defclass holder () ((component :initarg :component :accessor component)
                               (count :type fixnum :initform 0)
                               (amount :type double-float :initform 0d0)
                               (nullable :type (or null fixnum) :initform nil)))
          (defgeneric identify (component))
          (defmethod identify ((component left)) :left)
          (defmethod identify ((component right)) :right)
          (defun construct () (make-instance 'holder :component (make-instance 'left)))
          (defun replacement () (make-instance 'right))
          (defun component-of (holder) (component holder))
          (defun read-component (holder) (identify (component holder)))
          (defun write-component (holder value) (setf (component holder) value))
          (defun clear-component (holder) (slot-makunbound holder 'component))
          (defun update-scalars (holder)
            (incf (slot-value holder 'count))
            (incf (slot-value holder 'amount) 1d0)
            (values (slot-value holder 'count) (slot-value holder 'amount)))
          (defun write-nullable (holder) (setf (slot-value holder 'nullable) 1))
          (defun read-nullable (holder) (slot-value holder 'nullable)))"
       "(construct replacement component-of read-component write-component clear-component
          update-scalars write-nullable read-nullable)"
       "((construct ()) (replacement ()) (component-of (holder))
          (read-component (holder)) (write-component (holder t)) (clear-component (holder))
          (update-scalars (holder)) (write-nullable (holder)) (read-nullable (holder)))"
       "(component (setf component) identify)")
    (flet ((entry (name) (find-symbol name package)))
      (let* ((root (funcall (snowgrave:unit-function unit (entry "CONSTRUCT"))))
             (other (funcall (snowgrave:unit-function unit (entry "REPLACEMENT"))))
             (original (funcall (snowgrave:unit-function unit (entry "COMPONENT-OF")) root))
             (writer (snowgrave:bind-entry unit (entry "WRITE-COMPONENT") (list root other)))
             (clearer (snowgrave:bind-entry unit (entry "CLEAR-COMPONENT") (list root)))
             (scalars (snowgrave:bind-entry unit (entry "UPDATE-SCALARS") (list root)))
             (nullable-writer (snowgrave:bind-entry unit (entry "WRITE-NULLABLE") (list root)))
             (allowed (snowgrave:bind-entry unit (entry "WRITE-COMPONENT") (list root original))))
        ;; Generated code must execute without consulting the cold seal table,
        ;; for reference mutations as well as scalar arithmetic.
        (let ((seals (snowgrave::closed-unit-seals unit)))
          (unwind-protect
               (progn
                 (setf (snowgrave::closed-unit-seals unit) nil)
                 (check (equal '(1 1d0) (multiple-value-list (funcall scalars)))
                        "Configured scalar updates changed")
                 (check (eq other (funcall writer)) "Configured reference write consulted cold state")
                 (funcall allowed))
            (setf (snowgrave::closed-unit-seals unit) seals)))
        ;; A numeric union containing NIL can still be sealed as a role.
        (let ((reader (snowgrave:bind-entry unit (entry "READ-NULLABLE") (list root)
                                          :roles (fixture-read package "((holder nullable))"))))
          (check (null (funcall reader)) "Nullable role lost its initial NIL")
          (check-signals (error) (funcall nullable-writer)
            "Nullable numeric store bypassed a later NIL role seal")
          (check (null (funcall (snowgrave:unit-function unit (entry "READ-NULLABLE")) root))
                 "Rejected nullable store changed the sealed field"))
        ;; Before publication these are ordinary mutable fields.
        (check (eq other (funcall writer)) "Unsealed configured writer failed")
        (check (eq root (funcall clearer)) "Unsealed configured unbinding failed")
        (check (eq original (funcall allowed)) "Unsealed configured restore failed")
        (let ((reader (snowgrave:bind-entry unit (entry "READ-COMPONENT") (list root)
                                          :roles (fixture-read package "((holder component))"))))
          (check-signals (error) (funcall writer)
            "Previously configured writer bypassed a later role seal")
          (check-signals (error) (funcall clearer)
            "Previously configured unbinding bypassed a later role seal")
          ;; Omitting role declarations in a later binding cannot bypass an
          ;; existing unit seal either.
          (let ((later-writer (snowgrave:bind-entry unit (entry "WRITE-COMPONENT") (list root other)))
                (later-clearer (snowgrave:bind-entry unit (entry "CLEAR-COMPONENT") (list root))))
            (check-signals (error) (funcall later-writer)
              "Later configured writer bypassed an existing role seal")
            (check-signals (error) (funcall later-clearer)
              "Later configured unbinding bypassed an existing role seal"))
          (check (eq original (funcall allowed)) "Seal rejected its original component")
          (check (eq :left (funcall reader)) "Failed mutations damaged a sealed reader")
          (check (eq :left (funcall (snowgrave:unit-function unit (entry "READ-COMPONENT")) root))
                 "Configured and ordinary reads disagree after sealed mutations"))))))

(defun configuration-callback-tests ()
  (multiple-value-bind (unit package)
      (make-fixture
       :configuration-callbacks
       "((defgeneric add (a b))
          (defmethod add ((a integer) (b integer)) (+ a b))
          (defun helper (a b) (add a b))
          (defun direct (items) (reduce #'add items))
          (defun indirect (items) (reduce #'helper items))
          (defun quoted (items) (reduce 'helper items)))"
       "(direct indirect quoted)" "((direct (list)) (indirect (list)) (quoted (list)))"
       "(add)" :universe "(integer)")
    (dolist (name '("DIRECT" "INDIRECT" "QUOTED"))
      (check-signals (snowgrave:snowgrave-error '(:configuration-dispatch :configuration-indirect-call))
        (snowgrave:bind-entry unit (find-symbol name package) '((1 2 3)))
        "Escaping ~A callback passed the directness audit" name))))

(defun configuration-slot-error-tests ()
  (multiple-value-bind (unit package)
      (make-fixture
       :configuration-slot-errors
       "((defclass a () ((x :initform 1)))
          (defclass b () ())
          (defclass holder () ((data :initarg :data :accessor data)))
          (defun construct () (make-instance 'holder :data (make-instance 'a)))
          (defun switch (holder) (setf (data holder) (make-instance 'b)))
          (defun entry (holder) (slot-value (data holder) 'x)))"
       "(construct switch entry)" "((construct ()) (switch (holder)) (entry (holder)))"
       "(data (setf data))")
    (let* ((root (funcall (snowgrave:unit-function unit (find-symbol "CONSTRUCT" package))))
           (base (snowgrave:unit-function unit (find-symbol "ENTRY" package)))
           (bound (snowgrave:bind-entry unit (find-symbol "ENTRY" package) (list root)))
           (make-instance (fdefinition 'make-instance)))
      (check (= 1 (funcall bound)) "Unique physical slot read failed")
      (funcall (snowgrave:unit-function unit (find-symbol "SWITCH" package)) root)
      (check (eq (handler-case (funcall base root) (error (condition) (type-of condition)))
                 (handler-case (funcall bound) (error (condition) (type-of condition))))
             "Configured slot failure changed the condition type")
      (check-signals (snowgrave:snowgrave-error :configuration-allocation)
        (snowgrave:bind-entry unit (find-symbol "CONSTRUCT" package) nil)
        "Configured entry admitted new components")
      (check (eq make-instance (fdefinition 'make-instance)) "Binding changed CL:MAKE-INSTANCE"))))

(defun configuration-contour-tests ()
  (multiple-value-bind (unit package)
      (make-fixture :configuration-contours
                    "((defgeneric classify (value))
                       (defmethod classify ((value integer)) :integer)
                       (defmethod classify ((value symbol)) :symbol)
                       (defun add-one (n) (+ n 1))
                       (defun apply-one (function n) (funcall function n))
                       (defun named-call (n) (apply-one #'add-one n))
                       (defun entry (data)
                         (let ((value (aref data 0)))
                           (values (locally (declare (type integer value)) (classify value))
                                   (classify value)))))"
                    "(entry named-call)" "((entry (vector)) (named-call (integer)))" "(classify)" :universe "(integer symbol)")
    (compare-entry unit package "ENTRY" (list (vector 7)) '((:integer :integer) nil))
    (compare-entry unit package "NAMED-CALL" '(7) '((8) nil))
    (check (= 8 (funcall (snowgrave:bind-entry unit (find-symbol "NAMED-CALL" package) '(7))))
           "Known owned callable lost its specialization identity")
    ;; The local declaration cannot justify specializing the later call. DATA is
    ;; borrowed mutable storage, so its sampled element supplies no lasting fact.
    (check-signals (snowgrave:snowgrave-error :configuration-dispatch)
      (snowgrave:bind-entry unit (find-symbol "ENTRY" package) (list (vector 7)))
      "Local type declarations escaped their lexical contour")))

(defun configuration-shared-helper-tests ()
  ;; Two branches share the same next helper at each level. Runtime follows
  ;; only one branch, so this is a linear computation and a linear source DAG.
  ;; Forcing every specialized helper inline expands it into a binary tree;
  ;; GenImmix's minor/escalation graph exhausted a 2GiB SBCL compile heap that way.
  (let* ((depth 12)
         (source
           (with-output-to-string (out)
             (format out "((defgeneric finish (n)) (defmethod finish ((n integer)) n)
                          (defun h0 (data n) (declare (ignore data) (type integer n)) (finish n))")
             (loop for i from 1 to depth do
               (format out " (defun h~D (data n) (declare (type integer n))
                             (if (zerop (aref data 0))
                                 (h~D data (+ n 1)) (h~D data (- n 1))))" i (1- i) (1- i)))
             (format out " (defun entry (data) (h~D data 0)))" depth))))
    (multiple-value-bind (unit package)
        (make-fixture :shared-configured-helpers source "(entry)" "((entry (vector)))" "(finish)"
                      :universe "(integer)")
      (let* ((data (vector 0)) (entry (find-symbol "ENTRY" package))
             (before (test-bytes-consed))
             (bound (snowgrave:bind-entry unit entry (list data)))
             (allocated (when before (- (test-bytes-consed) before)))
             (selector (snowgrave::generic-plan-name
                        (first (snowgrave::unit-plan-generics (snowgrave::closed-unit-plan unit)))))
             (original (fdefinition selector)))
        ;; Generous headroom over the measured ~5MiB cold bind. This detects
        ;; compiler expansion without a machine-speed-dependent timing limit.
        #+sbcl (check (< allocated (* 128 1024 1024))
                      "Shared configured DAG consumed ~D compilation bytes" allocated)
        #-sbcl (declare (ignore allocated))
        (unwind-protect
             (progn
               (setf (fdefinition selector)
                     (lambda (&rest args) (declare (ignore args)) (error "Residual method selector")))
               (check (= depth (funcall bound)) "Configured shared helper lost direct method selection")
               (setf (aref data 0) 1)
               (check (= (- depth) (funcall bound)) "Configured shared helper sampled mutable branch data"))
          (setf (fdefinition selector) original))))))
