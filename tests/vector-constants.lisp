(in-package #:snowgrave.tests)

(defun vector-constant-tests ()
  (let* ((package (or (find-package "SNOWGRAVE.CONSTANTS.FIXTURE")
                      (make-package "SNOWGRAVE.CONSTANTS.FIXTURE" :use '("COMMON-LISP"))))
         (data-package (or (find-package "SNOWGRAVE.VECTOR.ONLY")
                          (make-package "SNOWGRAVE.VECTOR.ONLY" :use nil)))
         (tag (intern "VECTOR-ONLY-TAG" data-package))
         (box (intern "CONSTANT-BOX" package))
         (child (intern "CONSTANT-CHILD" package))
         (boot (intern "VECTOR-BOOT" package))
         (read-one (intern "VECTOR-READ-ONE" package))
         (read-two (intern "VECTOR-READ-TWO" package))
         (read-whole (intern "VECTOR-READ-WHOLE" package))
         (left (intern "VECTOR-LEFT" package))
         (right (intern "VECTOR-RIGHT" package))
         (observe (intern "VECTOR-OBSERVE" package))
         (leaf (vector :leaf tag))
         (whole (vector leaf leaf (list leaf)))
         (one (intern "ONE" package)) (two (intern "TWO" package)) (all (intern "ALL" package))
         (receiver (intern "RECEIVER" package))
         (forms `((cl:defclass ,box () ((,one :initform ,leaf) (,two :initform ,leaf) (,all :initform ,whole :initarg :whole)))
                  (cl:defclass ,child (,box) () (:default-initargs :whole ,whole))
                  (defun ,boot () (make-instance ',child))
                  (defun ,read-one (,receiver) (slot-value ,receiver ',one))
                  (defun ,read-two (,receiver) (slot-value ,receiver ',two))
                  (defun ,read-whole (,receiver) (slot-value ,receiver ',all))
                  (defun ,left () ,whole) (defun ,right () ,whole)
                  (defun ,observe () (values (length (,left)) (eq (,left) (,right)) (vectorp (,right))))))
         (entries (list boot read-one read-two read-whole left right observe))
         (unit (snowgrave:close-source-unit (list :forms forms) :unit-name '(native-vector-constants)
                 :closed-classes (list box child) :universe (list box child)
                 :entries entries :external-domains
                 (mapcar (lambda (name) (list name (when (member name (list read-one read-two read-whole)) (list box)))) entries))))
    (export tag data-package)
    (dolist (form forms) (eval form))
    (let* ((native (funcall boot))
           (record (funcall (snowgrave:unit-function unit boot)))
           (a (funcall (snowgrave:unit-function unit read-one) record))
           (b (funcall (snowgrave:unit-function unit read-two) record))
           (graph (funcall (snowgrave:unit-function unit read-whole) record)))
      (check (equal (multiple-value-list (funcall observe))
                    (multiple-value-list (funcall (snowgrave:unit-function unit observe)))))
      (check (equalp (slot-value native one) a))
      (check (eq (slot-value native one) (slot-value native two)))
      (check (eq a b))
      (check (not (eq a leaf)))
      (check (eq a (aref graph 0)))
      (check (eq (aref graph 0) (aref graph 1)))
      (check (eq (aref graph 0) (car (aref graph 2))))
      (check (eq graph (funcall (snowgrave:unit-function unit left))))
      ;; The source owner and public source reader cannot lend these constants.
      (setf (aref leaf 0) :caller-mutated)
      (check (eq (aref a 0) :leaf))
      (let* ((source (snowgrave:unit-source unit))
             (pool (find-if (lambda (form) (and (eq (car form) 'defparameter)
                                               (consp (third form))
                                               (eq (car (third form)) 'let*))) source)))
        (check pool)
        ;; Literal nodes now have explicit cold allocation forms instead of
        ;; lending vectors to the file compiler's constant coalescer.
        (setf (third pool) :reader-mutated))
      (check (eq (aref a 0) :leaf)))
    (let* ((root (asdf:system-source-directory "snowgrave"))
           (source (merge-pathnames ".build/fresh-vector-constants.lisp" root))
           (metadata (merge-pathnames ".build/fresh-vector-constants.metadata" root)))
      (with-open-file (stream source :direction :output :if-exists :supersede) (snowgrave:write-unit-source unit stream))
      (with-open-file (stream metadata :direction :output :if-exists :supersede) (snowgrave:write-unit-metadata unit stream))
      (check (search "Fresh native vector constants executed."
                     (uiop:run-program (list "sbcl" "--no-sysinit" "--no-userinit" "--script"
                                             (namestring (merge-pathnames "scripts/fresh-vector-constants.lisp" root))
                                             (namestring source) (namestring metadata)) :output :string))))
    (dolist (bad (list (vector (make-instance box)) (vector #'identity)
                      (vector (make-symbol "UNINTERNED"))
                      (make-array 1 :displaced-to (vector :x))))
      (signals snowgrave:residual-metaobject
        (snowgrave:close-source-unit (list :forms (list `(defun ,observe () ',bad)))
          :unit-name (list :bad-vector (type-of (aref bad 0)))
          :entries (list observe) :external-domains (list (list observe nil)))))
    (let ((cycle (vector nil)))
      (setf (aref cycle 0) cycle)
      (signals snowgrave:residual-metaobject
        (snowgrave:close-source-unit (list :forms (list `(defun ,observe () ',cycle)))
          :unit-name '(cyclic-native-vector) :entries (list observe)
          :external-domains (list (list observe nil)))))
    ;; A shared graph's paths are not a tree-sized work obligation.
    (let ((dag (vector :leaf)))
      (dotimes (level 20) (setf dag (vector dag dag)))
      (let* ((dag-unit (snowgrave:close-source-unit (list :forms (list `(defun ,observe () ,dag)))
                        :unit-name '(shared-native-vector-dag) :entries (list observe)
                        :external-domains (list (list observe nil))))
             (value (funcall (snowgrave:unit-function dag-unit observe))))
        (dotimes (level 20)
          (check (eq (aref value 0) (aref value 1)))
          (setf value (aref value 0)))
        (check (eq (aref value 0) :leaf))))))
