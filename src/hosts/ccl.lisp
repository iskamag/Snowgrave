(in-package #:snowgrave)

(defmethod normalize-host-declaration ((name (eql 'ccl::settable)) declaration)
  (declare (ignore name declaration)) nil)
(defmethod normalize-host-declaration ((name (eql 'ccl::unsettable)) declaration)
  (declare (ignore name declaration)) nil)

(defun last-argument-store-source (form reader)
  (let ((arguments (loop repeat (length (rest form)) collect (gensym "ARGUMENT"))))
    `(let ,(mapcar #'list arguments (rest form))
       (setf (,reader ,@(butlast arguments)) ,@(last arguments)))))

(defmethod normalize-host-operation ((operator (eql 'ccl::aset)) form)
  (declare (ignore operator)) (last-argument-store-source form 'aref))
(defmethod normalize-host-operation ((operator (eql 'ccl::%sbitset)) form)
  (declare (ignore operator)) (last-argument-store-source form 'sbit))
(defmethod normalize-host-operation ((operator (eql 'ccl::%bitset)) form)
  (declare (ignore operator)) (last-argument-store-source form 'bit))
(defmethod normalize-host-operation ((operator (eql 'ccl::svset)) form)
  (declare (ignore operator)) (last-argument-store-source form 'svref))
(defmethod normalize-host-operation ((operator (eql 'ccl::puthash)) form)
  (declare (ignore operator)) (last-argument-store-source form 'gethash))

(defmethod normalize-host-operation ((operator (eql 'ccl::int>0-p)) form)
  (declare (ignore operator))
  (let ((value (gensym "COUNT")))
    `(let ((,value ,(second form)))
       (if (integerp ,value) (> ,value 0)
           (error 'type-error :datum ,value :expected-type 'integer)))))

(defmethod normalize-host-operation ((operator (eql 'ccl::%err-disp)) form)
  (declare (ignore operator))
  (if (eql (second form) ccl::$xwrongtype)
      `(error 'type-error :datum ,(third form) :expected-type ,(fourth form))
      form))
