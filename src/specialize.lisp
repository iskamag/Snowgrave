(in-package #:snowgrave)

;;; Source specialization has a deliberately small fact vocabulary. It never
;;; reads an ordinary mutable field at build time and never asks the compiler
;;; for inferred types or optimized IR. Every selected call is explicit source.
(defstruct fact (type t) value known callable owned-callable)
(defstruct specialization name fact source active)
(defstruct local-source name definition environment scope)
(defstruct local-scope (definitions nil) (cache (make-hash-table :test #'equal)))

(defun unknown-fact () (make-fact))
(defun literal-fact (value)
  (make-fact :type (cond ((null value) 'null) ((eq value t) '(eql t))
                         ((numberp value) (type-of value))
                         (t (class-name (class-of value))))
             :value value :known t
             :callable (and (functionp value) value)
             :owned-callable (functionp value)))
(defun fact-key (fact)
  (list (fact-type fact) (fact-known fact)
        (when (fact-known fact)
          (let ((value (fact-value fact)))
            (if (or (symbolp value) (numberp value) (characterp value)) value
                (or (gethash value (configuration-identities *configuration*))
                    (setf (gethash value (configuration-identities *configuration*)) (gensym "IDENTITY"))))))
        (fact-callable fact) (fact-owned-callable fact)))
(defun fact-union (left right)
  (if (equal (fact-key left) (fact-key right)) left
      (make-fact :type (if (equal (fact-type left) (fact-type right)) (fact-type left)
                          `(or ,(fact-type left) ,(fact-type right)))
                 :owned-callable (or (fact-owned-callable left) (fact-owned-callable right)))))
(defun configuration-data (configuration key)
  (getf (closed-unit-compiler-data (configuration-unit configuration)) key))
(defun configuration-plan (configuration key name)
  (find name (configuration-data configuration key) :key (lambda (plan) (getf plan :name)) :test #'equal))
(defun audit-callable-transfer (configuration fact destination)
  ;; Losing a value/type fact must not hide a reference to an unspecialized
  ;; function. Refuse these transfers instead of inferring mutable bindings.
  (let ((callee (fact-callable fact)))
    (when (or (fact-owned-callable fact)
              (and callee
                   (or (not (function-name-p callee))
                       (gethash callee (configuration-functions configuration))
                       (find callee (configuration-data configuration :layouts)
                             :key (lambda (layout) (getf layout :allocator))))))
      (unsupported nil :configuration-indirect-call
                   "Owned function value escapes through ~S." destination))))
(defun canonical-source (form)
  (walk-source-form form nil (lambda (node context environment)
                               (declare (ignore context environment)) node)))

(defun authored-load-time-value-p (form)
  (and (consp form) (not (eq (first form) 'quote))
       (or (eq (first form) 'load-time-value)
           (some #'authored-load-time-value-p form))))

(defun assigned-source-variables (form)
  ;; Over-approximating assignments is safe: a shadowed name can lose a fact,
  ;; but a mutable binding must never retain its incoming value/type promise.
  (let ((names nil))
    (walk-source-form form nil
      (lambda (node context environment)
        (declare (ignore environment))
        (when (and (eq context :set) (symbolp node)) (pushnew node names))
        node))
    names))

(defun declared-special-variables (body)
  (multiple-value-bind (prefix forms) (body-parts body)
    (declare (ignore forms))
    (loop for declaration in prefix when (consp declaration) append
      (loop for spec in (rest declaration) when (eq (first spec) 'special) append (rest spec)))))

(defun unstable-source-variables (configuration form body)
  (append (assigned-source-variables form) (declared-special-variables body)
          (configuration-data configuration :special-variables)))

(defun source-return-p (name form)
  (and (consp form) (not (eq (first form) 'quote))
       (or (and (eq (first form) 'return-from) (eq (second form) name))
           (some (lambda (part) (source-return-p name part)) form))))

(defun specialize-body (configuration body environment)
  (multiple-value-bind (prefix forms) (body-parts body)
    (let ((result nil) (fact (literal-fact nil)) (environment (copy-list environment)))
      (setf (getf environment :variables) (copy-tree (getf environment :variables)))
      (dolist (declaration prefix)
        (when (and (consp declaration) (eq (first declaration) 'declare))
          (dolist (spec (rest declaration))
            (when (eq (first spec) 'special)
              (dolist (name (rest spec))
                (let ((old (cdr (assoc name (getf environment :variables)))))
                  (when old (audit-callable-transfer configuration old 'special)))
                (push (cons name (unknown-fact)) (getf environment :variables))))
            (when (eq (first spec) 'type)
              (dolist (name (cddr spec))
                (let* ((old (cdr (assoc name (getf environment :variables))))
                       (new (if old (copy-fact old) (unknown-fact))))
                  (setf (fact-type new) (second spec))
                  (push (cons name new) (getf environment :variables))))))))
      (dolist (form forms)
        (multiple-value-bind (new value) (specialize-form configuration form environment)
          (push new result) (setf fact value)))
      (values (append prefix (nreverse result)) fact))))

(defun specialize-lambda-source (configuration form environment)
  ;; Used for MULTIPLE-VALUE-BIND's ordinary lambda: the host retains its
  ;; variable value count, while component facts in the surrounding scope stay
  ;; available. Its result parameters begin unknown, never sampled from data.
  (let ((inner (copy-list environment)) (lambda-list nil) (mode :required))
    (setf (getf inner :variables) (copy-list (getf environment :variables)))
    (dolist (item (second form))
      (if (member item lambda-list-keywords)
          (progn (setf mode item) (push item lambda-list))
          (let ((name (if (consp item) (first item) item)))
            (unless (symbolp name)
              (unsupported nil :configuration-lambda-list "Unsupported multiple-value lambda list."))
            (push (if (consp item)
                      (list* name (specialize-form configuration (second item) inner) (cddr item)) item)
                  lambda-list)
            (push (cons name (make-fact :type (if (eq mode '&rest) 'list t))) (getf inner :variables))
            (when (and (consp item) (third item))
              (push (cons (third item) (make-fact :type 'boolean)) (getf inner :variables))))))
    (multiple-value-bind (body fact) (specialize-body configuration (cddr form) inner)
      (values `(lambda ,(nreverse lambda-list) ,@body) fact))))

(defun specialize-lambda-call (configuration definition arguments facts environment &optional block-name)
  ;; Bind the supplied prefix before defaults, with the ordinary method lambda
  ;; list's sequencing. Optional initforms see earlier bindings and continuations.
  (let* ((lambda-list (first definition)) (body (rest definition)) (bindings nil)
         (temporaries (loop repeat (length arguments) collect (gensym "ACTUAL")))
         (inner (copy-list environment)) (mode :required) (remaining temporaries) (values facts)
         (assigned (unstable-source-variables configuration `(lambda ,lambda-list ,@body) body)))
    (setf (getf inner :variables) (copy-list (getf environment :variables)))
    (labels ((bind (name form fact)
               (when (member name assigned)
                 (audit-callable-transfer configuration fact 'mutable-binding))
               (push (list name form) bindings)
               (push (cons name (if (member name assigned) (unknown-fact) fact)) (getf inner :variables))))
      (dolist (item lambda-list)
        (cond ((member item lambda-list-keywords)
               (unless (member item '(&optional &aux &rest))
                 (unsupported nil :configuration-lambda-list "Unsupported configured lambda list ~S." lambda-list))
               (setf mode item))
              ((eq mode :required)
               (unless remaining (unsupported nil :configuration-arity "Too few arguments."))
               (bind item (pop remaining) (pop values)))
              ((eq mode '&rest)
               (when remaining (unsupported nil :configuration-variable-tail "Configured rest arguments need a lifetime realization."))
               (bind item nil (literal-fact nil)) (setf mode :after-rest))
              ((member mode '(&optional &aux))
               (let* ((name (if (consp item) (first item) item))
                      (default (and (consp item) (second item)))
                      (supplied (and (consp item) (third item)))
                      (present (and (eq mode '&optional) (not (null remaining)))))
                 (if present (bind name (pop remaining) (pop values))
                     (multiple-value-bind (new fact) (specialize-form configuration default inner)
                       (bind name new fact)))
                 (when supplied (bind supplied present (literal-fact present)))))
              (t (unsupported nil :configuration-lambda-list "Invalid configured lambda list ~S." lambda-list))))
      (when remaining (unsupported nil :configuration-arity "Too many configured arguments."))
      (multiple-value-bind (new fact) (specialize-body configuration body inner)
        (multiple-value-bind (prefix executable) (body-parts new)
          (setf prefix (remove-if #'stringp prefix))
          (values `(let ,(mapcar #'list temporaries arguments)
                     (let* ,(nreverse bindings) ,@prefix
                       ,@(if block-name (list `(block ,block-name ,@executable)) executable))) fact))))))

(defun specialize-owned-call (configuration name arguments facts)
  (when (some (lambda (fact) (let ((callable (fact-callable fact)))
                              (and callable (not (function-name-p callable))))) facts)
    (unsupported nil :configuration-indirect-call "A lexical closure needs explicit capture conversion before crossing an owned helper."))
  (let* ((key (list name (mapcar #'fact-key facts)))
         (table (configuration-specializations configuration))
         (existing (gethash key table)))
    (when existing
      (return-from specialize-owned-call
        (values (cons (specialization-name existing) arguments)
                (or (specialization-fact existing) (unknown-fact)))))
    (let* ((definition (gethash name (configuration-functions configuration)))
           (target (intern (format nil "~A.~D" (if (consp name) (symbol-name (second name)) (symbol-name name))
                                   (hash-table-count table))
                           (symbol-package (gethash :entry (configuration-names configuration)))))
           (parameters (loop repeat (length arguments) collect (gensym "INPUT")))
           (item (make-specialization :name target :active t)))
      (unless definition (unsupported nil :configuration-source "Missing owned source for ~S." name))
      ;; Generated component/role captures are introduced later. Authored
      ;; load-time code must not bypass configured call and escape auditing.
      (when (authored-load-time-value-p (cddr definition))
        (unsupported nil :configuration-form "Authored LOAD-TIME-VALUE needs explicit cold realization."))
      ;; Publish the recursive name before walking its body. Recursion uses a
      ;; conservative result fact; it does not run a field/state fixed point.
      (setf (gethash key table) item)
      (multiple-value-bind (body fact)
          (specialize-lambda-call configuration (cddr definition) parameters facts nil
                                  (if (consp name) (second name) name))
        (when (and (fact-callable fact) (not (function-name-p (fact-callable fact))))
          (unsupported nil :configuration-indirect-call "An escaping lexical closure needs explicit capture conversion."))
        (setf (specialization-fact item) fact
              (specialization-active item) nil
              (specialization-source item)
              `(defun ,target ,parameters
                 ,@(let ((types (loop for parameter in parameters for value in facts
                                     unless (eq (fact-type value) t) collect `(type ,(fact-type value) ,parameter))))
                     (when types (list (cons 'declare types))))
                 ,body))
        (push item (configuration-emitted configuration))
        (values (cons target arguments) fact)))))

(defun configured-axis-indices (axis type)
  (let ((excluded nil) (result nil))
    (loop for (kind expected) in axis for index from 0
          for domain = (if (member kind '(:any :other)) `(not (or ,@excluded))
                           `(and ,expected (not (or ,@excluded))))
          do (unless (subtypep `(and ,type ,domain) nil) (push index result))
             (unless (member kind '(:any :other)) (push expected excluded)))
    (nreverse result)))

(defun specialize-generic-call (configuration plan arguments facts environment)
  (let* ((required (getf plan :required)) (supplied (- (length arguments) required))
         (indices '(0)))
    (unless (and (not (getf plan :variable-tail)) (<= 0 supplied (getf plan :optional)))
      (unsupported nil :configuration-variable-tail "Configured generic ~S needs a bounded argument prefix." (getf plan :source)))
    (loop for axis in (getf plan :axes) for fact in facts
          do (setf indices (loop for prefix in indices append
                            (loop for coordinate in (configured-axis-indices axis (fact-type fact))
                                  collect (+ (* prefix (length axis)) coordinate)))))
    (let* ((clauses (remove-duplicates
                     (mapcar (lambda (index)
                               (find-if (lambda (clause) (member index (first clause))) (getf plan :clauses))) indices)))
           (clause (first clauses)))
      (unless (and clause (= (length clauses) 1))
        (unsupported nil :configuration-dispatch "Unresolved method selection for ~S with ~S."
                     (getf plan :source) (mapcar #'fact-type facts)))
      (specialize-lambda-call
       configuration
       (list (append (getf plan :arguments)
                     (when (getf plan :optional-count) (list (getf plan :optional-count)))
                     (list (getf plan :overflow)))
             (canonical-source (cons 'progn (rest clause))))
       (append arguments (make-list (- (+ required (getf plan :optional)) (length arguments)))
               (when (getf plan :optional-count) (list supplied)) (list nil))
       (append facts (loop repeat (- (+ required (getf plan :optional)) (length facts)) collect (literal-fact nil))
               (when (getf plan :optional-count) (list (literal-fact supplied))) (list (literal-fact nil)))
       environment))))

(defun specialize-slot-call (configuration plan arguments facts environment)
  (let* ((object-index (if (eq (getf plan :operation) :write) 1 0))
         (type (fact-type (nth object-index facts)))
         (cases (getf plan :cases))
         (row (find-if (lambda (row) (subtypep type (first row))) cases))
         (unique (and (null row) (= (length cases) 1))))
    (unless (or row unique)
      (unsupported nil :configuration-dispatch "Unresolved physical slot ~S on ~S." (getf plan :slot) type))
    (setf row (or row (first cases)))
    (let* ((body (configured-slot-body configuration plan row))
           (roles (gethash (third row) (configuration-fields configuration)))
           (values (remove-duplicates (loop for row in roles append (copy-list (cdr row)))))
           (result (case (getf plan :operation)
                     (:read (if roles (make-fact :type `(or ,@(mapcar (lambda (value) (class-name (class-of value))) values)))
                                (unknown-fact)))
                     (:write (first facts))
                     (:unbind (nth object-index facts))
                     (otherwise (make-fact :type 'boolean)))))
      (when unique
        (setf body `(if (,(second row) ,(getf plan :object)) ,body
                       (,(getf plan :invalid) ,(getf plan :object) ',(getf plan :slot)))))
      (values (specialize-lambda-call configuration (list (getf plan :arguments) (canonical-source body)) arguments facts environment)
              result))))

(defun specialize-known-call (configuration name arguments facts environment)
  (let ((local (cdr (assoc name (getf environment :functions) :test #'equal)))
        (generic (configuration-plan configuration :generics name))
        (slot (configuration-plan configuration :slots name)))
    (cond (local (specialize-local-call configuration local arguments facts))
          (generic (specialize-generic-call configuration generic arguments facts environment))
          (slot (specialize-slot-call configuration slot arguments facts environment))
          ((or (member name (configuration-data configuration :construction-functions) :test #'equal)
               (find name (configuration-data configuration :layouts) :key (lambda (layout) (getf layout :allocator))))
           (unsupported nil :configuration-allocation "Configured entry reaches component construction ~S." name))
          ((and (gethash name (configuration-functions configuration))
                (not (member name (configuration-data configuration :slow-paths) :test #'equal)))
           (specialize-owned-call configuration name arguments facts))
          (t (audit-native-callbacks configuration name arguments facts)
             (values (if (consp name) `(funcall #',name ,@arguments) (cons name arguments))
                     (cond ((eq name 'identity) (or (first facts) (unknown-fact)))
                           ((and (member name '(eq eql not null)) (every #'fact-known facts))
                            (literal-fact (apply (fdefinition name) (mapcar #'fact-value facts))))
                           ((member name '(eq eql not null typep)) (make-fact :type 'boolean))
                           (t (unknown-fact))))))))

(defun audit-native-callbacks (configuration name arguments facts)
  (dolist (fact facts)
    (audit-callable-transfer configuration fact name))
  (labels ((check (position)
             (let ((callee (fact-callable (nth position facts))))
               (unless (and callee (function-name-p callee)
                            (not (gethash callee (configuration-functions configuration))))
                 (unsupported nil :configuration-indirect-call "Unresolved callback to ~S." name)))))
    (dolist (position (rest (assoc name *callback-arguments*))) (check position))
    (let ((start (cdr (assoc name *callback-keywords*))))
      (when start
        (loop for position from start below (length arguments) by 2
              for key = (nth position facts)
              do (unless (fact-known key)
                   (unsupported nil :configuration-indirect-call "Computed callback keyword for ~S." name))
                 (when (member (fact-value key) '(:key :test :test-not))
                   (unless (and (eq (fact-value (nth (1+ position) facts)) nil)
                                (fact-known (nth (1+ position) facts)))
                     (check (1+ position)))))))))

(defun specialize-local-call (configuration local arguments facts)
  (let* ((scope (local-source-scope local)) (key (list local (mapcar #'fact-key facts)))
         (item (gethash key (local-scope-cache scope))))
    (unless item
      (setf item (make-specialization :name (gensym "LOCAL") :active t)
            (gethash key (local-scope-cache scope)) item)
      (let ((parameters (loop repeat (length arguments) collect (gensym "INPUT"))))
        (multiple-value-bind (body fact)
            (specialize-lambda-call configuration (local-source-definition local) parameters facts
                                    (local-source-environment local) (local-source-name local))
          (setf (specialization-fact item) fact (specialization-active item) nil
                (specialization-source item) `(,(specialization-name item) ,parameters ,body))
          (push item (local-scope-definitions scope)))))
    (values (cons (specialization-name item) arguments) (or (specialization-fact item) (unknown-fact)))))

(defun specialize-form (configuration form environment)
  (labels ((walk (node &optional (env environment)) (specialize-form configuration node env))
           (arguments (forms)
             (let ((new nil) (facts nil))
               (dolist (node forms)
                 (multiple-value-bind (value fact) (walk node) (push value new) (push fact facts)))
               (values (nreverse new) (nreverse facts)))))
    (cond
      ((symbolp form)
       (values form (or (cdr (assoc form (getf environment :variables)))
                        (and (constantp form) (literal-fact (symbol-value form))) (unknown-fact))))
      ((atom form) (values form (literal-fact form)))
      ((eq (first form) 'quote) (values form (literal-fact (second form))))
      ((eq (first form) 'function)
       (let ((target (second form)))
         (when (and (function-name-p target)
                    (assoc target (getf environment :functions) :test #'equal))
           (unsupported nil :configuration-indirect-call
                        "A lexical function value needs explicit capture conversion outside a direct FUNCALL."))
         (values form (make-fact :type 'function
                                :owned-callable (or (not (function-name-p target))
                                                    (assoc target (getf environment :functions) :test #'equal)
                                                    (gethash target (configuration-functions configuration))
                                                    (find target (configuration-data configuration :layouts)
                                                          :key (lambda (layout) (getf layout :allocator))))
                                :callable (if (function-name-p target)
                                              (or (cdr (assoc target (getf environment :functions) :test #'equal)) target)
                                              (list :lambda target environment))))))
      ((eq (first form) 'the)
       (multiple-value-bind (new fact) (walk (third form))
         (values `(the ,(second form) ,new)
                 (make-fact :type (second form) :known (fact-known fact) :value (fact-value fact)
                            :callable (fact-callable fact) :owned-callable (fact-owned-callable fact)))))
      ;; Authored load-time forms are rejected when the owned source is read.
      ;; Only generated role/component captures reach this traversal.
      ((eq (first form) 'load-time-value) (values form (unknown-fact)))
      ((member (first form) '(let let*))
       (let ((inner (copy-list environment)) (bindings nil)
             (assigned (unstable-source-variables configuration form (cddr form))))
         (setf (getf inner :variables) (copy-list (getf environment :variables)))
         (dolist (binding (second form))
           (let ((name (if (consp binding) (first binding) binding))
                 (init (and (consp binding) (second binding))))
             (multiple-value-bind (new fact) (walk init (if (eq (first form) 'let*) inner environment))
               (when (member name assigned)
                 (audit-callable-transfer configuration fact 'mutable-binding))
               (push (list name new) bindings)
               (push (cons name (if (member name assigned) (unknown-fact) fact)) (getf inner :variables)))))
         (multiple-value-bind (body fact) (specialize-body configuration (cddr form) inner)
           (values `(,(first form) ,(nreverse bindings) ,@body) fact))))
      ((member (first form) '(flet labels))
       (let* ((scope (make-local-scope)) (inner (copy-list environment))
              (locals (loop for definition in (second form)
                            collect (cons (first definition)
                                          (make-local-source :name (first definition) :definition (rest definition) :scope scope)))))
         (setf (getf inner :functions) (append locals (getf environment :functions)))
         (dolist (local locals)
           (setf (local-source-environment (cdr local)) (if (eq (first form) 'labels) inner environment)))
         (multiple-value-bind (body fact) (specialize-body configuration (cddr form) inner)
           (values `(labels ,(mapcar #'specialization-source (nreverse (local-scope-definitions scope))) ,@body) fact))))
      ((eq (first form) 'if)
       (multiple-value-bind (test fact) (walk (second form))
         (if (fact-known fact)
             (multiple-value-bind (body result) (walk (if (fact-value fact) (third form) (fourth form)))
               (values `(progn ,test ,body) result))
             (multiple-value-bind (yes left) (walk (third form))
               (multiple-value-bind (no right) (walk (fourth form))
                 (values `(if ,test ,yes ,no) (fact-union left right)))))))
      ((eq (first form) 'setq)
       (let ((forms nil) (result (literal-fact nil)))
         (loop for (name value) on (rest form) by #'cddr
               do (multiple-value-bind (new fact) (walk value)
                    (audit-callable-transfer configuration fact 'setq)
                    (push `(setq ,name ,new) forms) (setf result fact)))
         (values `(progn ,@(nreverse forms)) result)))
      ((eq (first form) 'setf)
       (unless (evenp (length (rest form)))
         (unsupported nil :configuration-form "Malformed configured SETF: ~S." form))
       (let ((pairs nil) (result (literal-fact nil)))
         (loop for (place value) on (rest form) by #'cddr
               do (unless (and (consp place) (member (first place) '(aref svref sbit bit gethash)))
                    (unsupported nil :configuration-form "Unsupported configured place ~S." place))
                  (multiple-value-bind (operands operand-facts) (arguments (rest place))
                    (multiple-value-bind (new fact) (walk value)
                      (audit-native-callbacks configuration (list 'setf (first place))
                                              (append operands (list new)) (append operand-facts (list fact)))
                      (push (cons (first place) operands) pairs)
                      (push new pairs)
                      (setf result fact))))
         (values `(setf ,@(nreverse pairs)) result)))
      ((member (first form) '(progn locally))
       (multiple-value-bind (body fact) (specialize-body configuration (rest form) environment)
         (values (cons (first form) body) fact)))
      ((eq (first form) 'block)
       (multiple-value-bind (body fact) (specialize-body configuration (cddr form) environment)
         (values `(block ,(second form) ,@body)
                 (if (source-return-p (second form) (cddr form))
                     (make-fact :owned-callable (fact-owned-callable fact)) fact))))
      ((eq (first form) 'return-from)
       (multiple-value-bind (new fact) (walk (third form))
         (audit-callable-transfer configuration fact 'return-from)
         (values `(return-from ,(second form) ,new) fact)))
      ((eq (first form) 'go) (values form (unknown-fact)))
      ((eq (first form) 'tagbody)
       (values `(tagbody ,@(mapcar (lambda (node) (if (atom node) node (walk node))) (rest form))) (literal-fact nil)))
      ((member (first form) '(unwind-protect multiple-value-prog1))
       (multiple-value-bind (new fact) (walk (second form))
         (values `(,(first form) ,new ,@(mapcar #'walk (cddr form))) fact)))
      ((eq (first form) 'assert)
       (when (third form)
         (unsupported nil :configuration-form "Configured ASSERT places need restart-store realization."))
       (multiple-value-bind (test test-fact) (walk (second form))
         (declare (ignore test-fact))
         (multiple-value-bind (data facts) (arguments (cdddr form))
           (audit-native-callbacks configuration 'assert data facts)
           (values `(assert ,test nil ,@data) (literal-fact nil)))))
      ((eq (first form) 'multiple-value-bind)
       ;; ECL keeps this as a special operator. Let the host preserve the
       ;; value count and NIL padding; no sampled result becomes a type fact.
       (multiple-value-bind (value fact) (walk (third form))
         (audit-callable-transfer configuration fact 'multiple-value-bind)
         (let ((inner (copy-list environment)))
           (setf (getf inner :variables)
                 (append (mapcar (lambda (name) (cons name (unknown-fact))) (second form))
                         (getf environment :variables)))
           (multiple-value-bind (body result) (specialize-body configuration (cdddr form) inner)
             (values `(multiple-value-bind ,(second form) ,value ,@body) result)))))
      ((eq (first form) 'multiple-value-call)
       (multiple-value-bind (function fact) (walk (second form))
         (multiple-value-bind (new argument-facts) (arguments (cddr form))
          (dolist (argument argument-facts)
            (audit-callable-transfer configuration argument 'multiple-value-call))
          (let ((callee (or (fact-callable fact)
                             (and (fact-known fact) (symbolp (fact-value fact)) (fact-value fact)))))
           (cond ((and callee (function-name-p callee)
                       (not (fact-owned-callable fact))
                       (not (gethash callee (configuration-functions configuration)))
                       (not (assoc callee *callback-arguments*)) (not (assoc callee *callback-keywords*)))
                  (audit-callable-transfer configuration (make-fact :callable callee) 'multiple-value-call)
                  (audit-native-callbacks configuration callee new argument-facts)
                  (values `(multiple-value-call (progn ,function (function ,callee)) ,@new) (unknown-fact)))
                 ((and (consp callee) (eq (first callee) :lambda)
                       (consp (second form)) (eq (caadr form) 'function)
                       (consp (second (second form))) (eq (caadr (second form)) 'lambda))
                  (multiple-value-bind (lambda-form result)
                      (specialize-lambda-source configuration (second callee) (third callee))
                    (values `(multiple-value-call (function ,lambda-form) ,@new) result)))
                 (t (unsupported nil :configuration-indirect-call "Unresolved multiple-value call: ~S." form)))))))
      ((and (eq (first form) 'funcall)
            (consp (second form)) (eq (caadr form) 'function)
            (assoc (cadadr form) (getf environment :functions) :test #'equal))
       ;; A direct local call needs no function object. Other lexical function
       ;; values are refused above rather than leaving an obsolete local name.
       (multiple-value-bind (new facts) (arguments (cddr form))
         (specialize-local-call configuration
                                (cdr (assoc (cadadr form) (getf environment :functions) :test #'equal))
                                new facts)))
      ((eq (first form) 'funcall)
       (multiple-value-bind (function fact) (walk (second form))
         (multiple-value-bind (new facts) (arguments (cddr form))
           (let ((callee (or (fact-callable fact)
                             (and (fact-known fact) (symbolp (fact-value fact)) (fact-value fact)))))
             (multiple-value-bind (call result)
                 (cond ((and callee (function-name-p callee))
                        (specialize-known-call configuration callee new facts
                                               (and (fact-callable fact) environment)))
                       ((and (local-source-p callee)
                             (member callee (getf environment :functions) :key #'cdr))
                        (specialize-local-call configuration callee new facts))
                       ((and (consp callee) (eq (first callee) :lambda)
                             (consp (second form)) (eq (caadr form) 'function)
                             (consp (second (second form))) (eq (caadr (second form)) 'lambda))
                        (specialize-lambda-call configuration (rest (second callee)) new facts (third callee)))
                       (t (unsupported nil :configuration-indirect-call "Unresolved or escaping lexical function value.")))
               ;; Pure lexical/name operands need no evaluation. Other function
               ;; expressions may perform effects before the argument forms.
               (values (if (or (symbolp (second form))
                               (and (consp (second form)) (eq (caadr form) 'function)))
                           call `(progn ,function ,call)) result))))))
      ((and (symbolp (first form)) (special-operator-p (first form)))
       (unsupported nil :configuration-form "Unsupported configured special form ~S." (first form)))
      ((and (consp (first form)) (eq (caar form) 'lambda))
       (multiple-value-bind (new facts) (arguments (rest form))
         (specialize-lambda-call configuration (rest (first form)) new facts environment)))
      ((and (symbolp (first form)) (macro-function (first form))
            (not (assoc (first form) (getf environment :functions) :test #'equal)))
       (unsupported nil :configuration-form "Unexpanded configured macro ~S." form))
      (t
       (multiple-value-bind (new facts) (arguments (rest form))
         (specialize-known-call configuration (first form) new facts environment))))))

(defun bind-entry (unit entry arguments &key roles)
  "Specialize an entry in portable source for its fixed component graph.
ROLES contains (SOURCE-CLASS SLOT...) declarations. A list in place of SLOT
declares an exchange group of initially validated component identities."
  (unit-function unit entry)
  (check-configuration-arguments unit entry arguments)
  (let* ((configuration (prepare-configuration unit arguments roles)) (*configuration* configuration)
         (metadata (find entry (getf (closed-unit-metadata unit) :entries) :key (lambda (row) (getf row :name))))
         (key (getf metadata :code-key)) (original (find-symbol (second key) (first key)))
         (package (make-package (format nil "SNOWGRAVE.CONFIGURATION.~D" (incf *configuration-sequence*)) :use '("COMMON-LISP")))
         (target (intern "%BOUND-ENTRY" package)) (success nil))
    (unwind-protect
         (progn
           (check-configuration-seals configuration)
           (setf (gethash :entry (configuration-names configuration)) target)
           (dolist (form (closed-unit-source unit))
             (when (eq (first form) 'defun)
               (setf (gethash (second form) (configuration-functions configuration))
                     (list* 'defun (second form) (rest (canonical-source (cons 'lambda (cddr form))))))))
           (multiple-value-bind (body fact)
               (specialize-known-call configuration original
                                      (mapcar (lambda (value) (configured-value configuration value)) arguments)
                                      (mapcar #'literal-fact arguments) nil)
             (when (or (fact-callable fact) (fact-owned-callable fact))
               (unsupported nil :configuration-indirect-call "Configured entry returns an escaping callable value."))
             (let ((definitions (mapcar #'specialization-source (nreverse (configuration-emitted configuration)))))
               (proclaim `(inline ,@(mapcar #'second definitions)))
               (dolist (definition definitions) (compile-definition nil definition))
               (multiple-value-bind (function warnings failure) (compile target `(lambda () ,body))
                 (declare (ignore warnings))
                 (when failure (unsupported nil :configuration-compilation "Cannot compile the configured entry."))
                 (publish-configuration-seals configuration)
                 (setf success t)
                 function))))
      (unless success
        (do-symbols (symbol package)
          (when (and (eq (symbol-package symbol) package) (fboundp symbol)) (fmakunbound symbol)))
        (delete-package package)))))
