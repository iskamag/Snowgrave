(in-package #:snowgrave)

;;; Lexical bindings, defaults, and local recursive specializations.

(defun specialize-body (configuration body environment)
  (multiple-value-bind (prefix forms) (body-parts body)
    (let ((result nil) (fact (literal-fact nil)) (environment (copy-lexical-facts environment)))
      (dolist (declaration prefix)
        (when (and (consp declaration) (eq (first declaration) 'declare))
          (dolist (spec (rest declaration))
            (when (eq (first spec) 'special)
              (dolist (name (rest spec))
                (let ((old (cdr (assoc name (env-variables environment)))))
                  (when old (audit-callable-transfer configuration old 'special)))
                (push (cons name (make-fact)) (env-variables environment))))
            (when (eq (first spec) 'type)
              (dolist (name (cddr spec))
                (let* ((old (cdr (assoc name (env-variables environment))))
                       (new (if old (copy-fact old) (make-fact))))
                  ;; A method specializer is an upper bound, not a reason to
                  ;; forget a more precise configured receiver or role type.
                  (setf (fact-type new) (refined-fact-type new (second spec)))
                  (push (cons name new) (env-variables environment))))))))
      (dolist (form forms)
        (multiple-value-bind (new value) (specialize-form configuration form environment)
          (push new result) (setf fact value)))
      (values (append prefix (nreverse result)) fact))))

(defun specialize-lambda-source (configuration form environment)
  ;; Used for MULTIPLE-VALUE-BIND's ordinary lambda: the host retains its
  ;; variable value count, while component facts in the surrounding scope stay
  ;; available. Its result parameters begin unknown, never sampled from data.
  (let ((inner (copy-lexical-facts environment)) (lambda-list nil) (mode :required))
    (dolist (item (second form))
      (if (member item lambda-list-keywords)
          (progn (setf mode item) (push item lambda-list))
          (let ((name (if (consp item) (first item) item)))
            (unless (symbolp name)
              (unsupported :configuration-lambda-list "Unsupported multiple-value lambda list."))
            (push (if (consp item)
                      (list* name (specialize-form configuration (second item) inner) (cddr item)) item)
                  lambda-list)
            (push (cons name (make-fact :type (if (eq mode '&rest) 'list t))) (env-variables inner))
            (when (and (consp item) (third item))
              (push (cons (third item) (make-fact :type 'boolean)) (env-variables inner))))))
    (multiple-value-bind (body fact) (specialize-body configuration (cddr form) inner)
      (values `(lambda ,(nreverse lambda-list) ,@body) fact))))

(defun specialize-lambda-call (configuration definition arguments facts environment &optional block-name)
  ;; Bind the supplied prefix before defaults, with the ordinary method lambda
  ;; list's sequencing. Optional initforms see earlier bindings and continuations.
  (let* ((lambda-list (first definition)) (body (rest definition)) (bindings nil)
         (temporaries (loop repeat (length arguments) collect (gensym "ACTUAL")))
         (inner (copy-lexical-facts environment)) (mode :required) (remaining temporaries) (values facts)
         (assigned (unstable-source-variables configuration `(lambda ,lambda-list ,@body) body)))
    (labels ((bind (name form fact)
               (when (member name assigned)
                 (audit-callable-transfer configuration fact 'mutable-binding))
               (push (list name form) bindings)
               (push (cons name (if (member name assigned) (make-fact) fact)) (env-variables inner))))
      (dolist (item lambda-list)
        (cond ((member item lambda-list-keywords)
               (unless (member item '(&optional &aux &rest))
                 (unsupported :configuration-lambda-list "Unsupported configured lambda list ~S." lambda-list))
               (setf mode item))
              ((eq mode :required)
               (unless remaining (unsupported :configuration-arity "Too few arguments."))
               (bind item (pop remaining) (pop values)))
              ((eq mode '&rest)
               (when remaining (unsupported :configuration-variable-tail "Configured rest arguments need a lifetime realization."))
               (bind item nil (literal-fact nil)) (setf mode :after-rest))
              ((member mode '(&optional &aux))
               (let* ((name (if (consp item) (first item) item))
                      (default (and (consp item) (second item)))
                      (supplied (and (consp item) (third item)))
                      (present (and (eq mode '&optional) (not (null remaining)))))
                 (if present (bind name (pop remaining) (pop values))
                     (multiple-value-bind (new fact) (specialize-form configuration default inner)
                       (bind name new fact)))
                 (when supplied (bind supplied present (literal-fact present)))))
              (t (unsupported :configuration-lambda-list "Invalid configured lambda list ~S." lambda-list))))
      (when remaining (unsupported :configuration-arity "Too many configured arguments."))
      (multiple-value-bind (new fact) (specialize-body configuration body inner)
        (multiple-value-bind (prefix executable) (body-parts new)
          (setf prefix (remove-if #'stringp prefix))
          (values `(let ,(mapcar #'list temporaries arguments)
                     (let* ,(nreverse bindings) ,@prefix
                       ,@(if block-name (list `(block ,block-name ,@executable)) executable))) fact))))))

(defun specialize-local-call (configuration local arguments facts)
  (let* ((scope (local-source-scope local)) (key (list local (mapcar (lambda (fact) (fact-key configuration fact)) facts)))
         (item (gethash key (local-scope-cache scope))))
    (unless item
      (setf item (make-specialization :name (gensym "LOCAL"))
            (gethash key (local-scope-cache scope)) item)
      (let ((parameters (loop repeat (length arguments) collect (gensym "INPUT"))))
        (multiple-value-bind (body fact)
            (specialize-lambda-call configuration (local-source-definition local) parameters facts
                                    (local-source-environment local) (local-source-name local))
          (setf (specialization-fact item) fact
                (specialization-source item) `(,(specialization-name item) ,parameters ,body))
          (push item (local-scope-definitions scope)))))
    (values (cons (specialization-name item) arguments) (or (specialization-fact item) (make-fact)))))
