(in-package #:snowgrave)

;;; Each form handler returns source and a conservative result fact. The
;;; dispatcher preserves the distinction between lexical function references,
;;; direct local calls, native calls, and unsupported special operators.

(defun specialize-arguments (configuration forms environment)
  (let ((arguments nil)
        (facts nil))
    (dolist (form forms)
      (multiple-value-bind (source fact)
          (specialize-form configuration form environment)
        (push source arguments)
        (push fact facts)))
    (values (nreverse arguments) (nreverse facts))))

(defun specialize-function-reference-form (configuration form environment)
  (let* ((target (second form))
         (namedp (function-name-p target))
         (plan (closed-unit-plan (configuration-unit configuration))))
    (when (and namedp (assoc target (env-functions environment) :test #'equal))
      (unsupported :configuration-indirect-call
                   "A lexical function value needs explicit capture conversion outside a direct FUNCALL."))
    (values form
            (make-fact :type 'function
                       :owned-callable (not (null (or (not namedp)
                                                     (gethash target (configuration-functions configuration))
                                                     (member target (unit-plan-construction-functions plan)
                                                             :test #'equal))))
                       :callable (if namedp target
                                     (make-lambda-source :form target :environment environment))))))

(defun specialize-let-form (configuration form environment)
  (let ((inner (copy-lexical-facts environment)) (bindings nil)
        (assigned (unstable-source-variables configuration form (cddr form))))
    (dolist (binding (second form))
      (let ((name (if (consp binding) (first binding) binding))
            (init (and (consp binding) (second binding))))
        (multiple-value-bind (new fact) (specialize-form configuration init (if (eq (first form) 'let*) inner environment))
          (when (member name assigned)
            (audit-callable-transfer configuration fact 'mutable-binding))
          (push (list name new) bindings)
          (push (cons name (if (member name assigned) (make-fact) fact)) (env-variables inner)))))
    (multiple-value-bind (body fact) (specialize-body configuration (cddr form) inner)
      (values `(,(first form) ,(nreverse bindings) ,@body) fact))))

(defun specialize-local-functions-form (configuration form environment)
  (let* ((scope (make-local-scope)) (inner (copy-lexical-facts environment))
         (locals (loop for definition in (second form)
                       collect (cons (first definition)
                                     (make-local-source :name (first definition) :definition (rest definition) :scope scope)))))
    (setf (env-functions inner) (append locals (env-functions environment)))
    (dolist (local locals)
      (setf (local-source-environment (cdr local)) (if (eq (first form) 'labels) inner environment)))
    (multiple-value-bind (body fact) (specialize-body configuration (cddr form) inner)
      (values `(labels ,(mapcar #'specialization-source (nreverse (local-scope-definitions scope))) ,@body) fact))))

(defun specialize-setf-form (configuration form environment)
  (unless (evenp (length (rest form)))
    (unsupported :configuration-form "Malformed configured SETF: ~S." form))
  (let ((pairs nil) (result (literal-fact nil)))
    (loop for (place value) on (rest form) by #'cddr
          do (unless (and (consp place) (member (first place) '(aref svref sbit bit gethash)))
               (unsupported :configuration-form "Unsupported configured place ~S." place))
          (multiple-value-bind (operands operand-facts) (specialize-arguments configuration (rest place) environment)
            (multiple-value-bind (new fact) (specialize-form configuration value environment)
              (audit-native-callbacks configuration (list 'setf (first place))
                                      (append operands (list new)) (append operand-facts (list fact)))
              (push (cons (first place) operands) pairs)
              (push new pairs)
              (setf result fact))))
    (values `(setf ,@(nreverse pairs)) result)))

(defun specialize-multiple-value-bind-form (configuration form environment)
  ;; Let the host preserve the value count and NIL padding. Returned parameters
  ;; start unknown; a sampled result must never become a type fact.
  (multiple-value-bind (value fact) (specialize-form configuration (third form) environment)
    (audit-callable-transfer configuration fact 'multiple-value-bind)
    (let ((inner (copy-lexical-facts environment)))
      (setf (env-variables inner)
            (append (mapcar (lambda (name) (cons name (make-fact))) (second form))
                    (env-variables environment)))
      (multiple-value-bind (body result) (specialize-body configuration (cdddr form) inner)
        (values `(multiple-value-bind ,(second form) ,value ,@body) result)))))

(defun direct-lambda-reference-p (callee operand)
  ;; A lexical closure may be substituted only at its original direct call.
  (and (lambda-source-p callee)
       (consp operand) (eq (first operand) 'function)
       (consp (second operand)) (eq (first (second operand)) 'lambda)))

(defun specialize-multiple-value-call-form (configuration form environment)
  (multiple-value-bind (function fact) (specialize-form configuration (second form) environment)
    (multiple-value-bind (new argument-facts) (specialize-arguments configuration (cddr form) environment)
      (dolist (argument argument-facts)
        (audit-callable-transfer configuration argument 'multiple-value-call))
      (let ((callee (fact-function-designator fact)))
        (cond ((and callee (function-name-p callee)
                    (not (fact-owned-callable fact))
                    (not (gethash callee (configuration-functions configuration)))
                    (not (assoc callee *callback-arguments*)) (not (assoc callee *callback-keywords*)))
               (audit-callable-transfer configuration (make-fact :callable callee) 'multiple-value-call)
               (audit-native-callbacks configuration callee new argument-facts)
               (values `(multiple-value-call (progn ,function (function ,callee)) ,@new) (make-fact)))
              ((direct-lambda-reference-p callee (second form))
               (multiple-value-bind (lambda-form result)
                   (specialize-lambda-source configuration (lambda-source-form callee) (lambda-source-environment callee))
                 (values `(multiple-value-call (function ,lambda-form) ,@new) result)))
              (t (unsupported :configuration-indirect-call "Unresolved multiple-value call: ~S." form)))))))

(defun specialize-funcall-form (configuration form environment)
  (let* ((operand (second form))
         (local (and (consp operand) (eq (first operand) 'function)
                     (cdr (assoc (second operand) (env-functions environment) :test #'equal)))))
    (when local
      (return-from specialize-funcall-form
        (multiple-value-bind (arguments facts)
            (specialize-arguments configuration (cddr form) environment)
          (specialize-local-call configuration local arguments facts))))
    (multiple-value-bind (function fact) (specialize-form configuration operand environment)
      (multiple-value-bind (arguments facts) (specialize-arguments configuration (cddr form) environment)
        (let ((callee (fact-function-designator fact)))
          (multiple-value-bind (call result)
              (cond ((and callee (function-name-p callee))
                     (specialize-known-call configuration callee arguments facts
                                            (and (fact-callable fact) environment)))
                    ((direct-lambda-reference-p callee operand)
                     (specialize-lambda-call configuration (rest (lambda-source-form callee)) arguments facts
                                             (lambda-source-environment callee)))
                    (t (unsupported :configuration-indirect-call "Unresolved or escaping lexical function value.")))
            ;; Preserve effects in the function operand before argument evaluation.
            (values (if (or (symbolp operand) (and (consp operand) (eq (first operand) 'function)))
                        call `(progn ,function ,call)) result)))))))

(defun specialize-form (configuration form environment)
  (when (atom form)
    (return-from specialize-form
      (values form (if (symbolp form)
                       (or (cdr (assoc form (env-variables environment)))
                           (and (constantp form) (literal-fact (symbol-value form))) (make-fact))
                       (literal-fact form)))))
  (case (first form)
    (quote (values form (literal-fact (second form))))
    (function (specialize-function-reference-form configuration form environment))
    (the
     (multiple-value-bind (new fact) (specialize-form configuration (third form) environment)
       (let ((result (copy-fact fact)))
         (setf (fact-type result) (second form))
         (values `(the ,(second form) ,new) result))))
    ;; Only generated captures reach this traversal; authored load-time code is refused earlier.
    (load-time-value (values form (make-fact)))
    ((let let*) (specialize-let-form configuration form environment))
    ((flet labels) (specialize-local-functions-form configuration form environment))
    (if
     (multiple-value-bind (test fact) (specialize-form configuration (second form) environment)
       (if (fact-known fact)
           (multiple-value-bind (body result)
               (specialize-form configuration (if (fact-value fact) (third form) (fourth form)) environment)
             (values `(progn ,test ,body) result))
           (multiple-value-bind (yes left) (specialize-form configuration (third form) environment)
             (multiple-value-bind (no right) (specialize-form configuration (fourth form) environment)
               (values `(if ,test ,yes ,no) (fact-union configuration left right)))))))
    (setq
     (let ((forms nil) (result (literal-fact nil)))
       (loop for (name value) on (rest form) by #'cddr
             do (multiple-value-bind (new fact) (specialize-form configuration value environment)
                  (audit-callable-transfer configuration fact 'setq)
                  (push `(setq ,name ,new) forms) (setf result fact)))
       (values `(progn ,@(nreverse forms)) result)))
    (setf (specialize-setf-form configuration form environment))
    ((progn locally)
     (multiple-value-bind (body fact) (specialize-body configuration (rest form) environment)
       (values (cons (first form) body) fact)))
    (block
     (multiple-value-bind (body fact) (specialize-body configuration (cddr form) environment)
       (values `(block ,(second form) ,@body)
               (if (source-return-p (second form) (cddr form))
                   (make-fact :owned-callable (fact-owned-callable fact)) fact))))
    (return-from
     (multiple-value-bind (new fact) (specialize-form configuration (third form) environment)
       (audit-callable-transfer configuration fact 'return-from)
       (values `(return-from ,(second form) ,new) fact)))
    (go (values form (make-fact)))
    (tagbody
     (values `(tagbody ,@(mapcar (lambda (node)
                                  (if (atom node) node (specialize-form configuration node environment)))
                                (rest form))) (literal-fact nil)))
    ((unwind-protect multiple-value-prog1)
     (multiple-value-bind (new fact) (specialize-form configuration (second form) environment)
       (values `(,(first form) ,new ,@(mapcar (lambda (node) (specialize-form configuration node environment))
                                            (cddr form))) fact)))
    (assert
     (when (third form)
       (unsupported :configuration-form "Configured ASSERT places need restart-store realization."))
     (let ((test (specialize-form configuration (second form) environment)))
       (multiple-value-bind (data facts) (specialize-arguments configuration (cdddr form) environment)
         (audit-native-callbacks configuration 'assert data facts)
         (values `(assert ,test nil ,@data) (literal-fact nil)))))
    (multiple-value-bind (specialize-multiple-value-bind-form configuration form environment))
    (multiple-value-call (specialize-multiple-value-call-form configuration form environment))
    (funcall (specialize-funcall-form configuration form environment))
    (otherwise
     (cond ((and (symbolp (first form)) (special-operator-p (first form)))
            (unsupported :configuration-form "Unsupported configured special form ~S." (first form)))
           ((and (consp (first form)) (eq (caar form) 'lambda))
            (multiple-value-bind (arguments facts) (specialize-arguments configuration (rest form) environment)
              (specialize-lambda-call configuration (rest (first form)) arguments facts environment)))
           ((and (symbolp (first form)) (macro-function (first form))
                 (not (assoc (first form) (env-functions environment) :test #'equal)))
            (unsupported :configuration-form "Unexpanded configured macro ~S." form))
           (t (multiple-value-bind (arguments facts) (specialize-arguments configuration (rest form) environment)
                (specialize-known-call configuration (first form) arguments facts environment)))))))
